<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Satchel.Converters">

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Cascadia Code, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="EmojiFont">Segoe UI Emoji, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Converters -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:NotConverter x:Key="Not" />
    <conv:HasValueToVisibilityConverter x:Key="HasValueToVis" />
    <conv:HasValueConverter x:Key="HasValue" />
    <conv:EqualsConverter x:Key="Equals" />
    <conv:EqualsToVisibilityConverter x:Key="EqualsToVis" />
    <conv:PaletteBrushConverter x:Key="PaletteBrush" />
    <conv:BytesToImageConverter x:Key="BytesToImage" />
    <conv:InitialsConverter x:Key="Initials" />
    <conv:DateFormatConverter x:Key="DateFormat" />
    <conv:MultiplyConverter x:Key="Multiply" />
    <conv:ProgressWidthConverter x:Key="ProgressWidth" />
    <conv:StrengthBrushConverter x:Key="StrengthBrush" />
    <conv:PriorityBrushConverter x:Key="PriorityBrush" />
    <conv:BoolToStringConverter x:Key="BoolToString" />
    <conv:HumanizeConverter x:Key="Humanize" />
    <conv:AccountKindGlyphConverter x:Key="KindGlyph" />
    <conv:CountBadgeConverter x:Key="CountBadge" />
    <conv:CornerRadiusConverter x:Key="ToCornerRadius" />
    <conv:PercentConverter x:Key="Percent" />
    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:IndentConverter x:Key="Indent" />
    <conv:ArrayConverter x:Key="ToArray" />
    <conv:AllEqualConverter x:Key="AllEqual" />
    <conv:SameObjectConverter x:Key="SameObject" />
    <conv:BoolToGridLengthConverter x:Key="BoolToGridLength" />
    <conv:RatingStarConverter x:Key="RatingStar" />
    <conv:RatingBrushConverter x:Key="RatingBrush" />
    <conv:ColorKeyToColorConverter x:Key="ColorKeyToColor" />
    <conv:RatingFilledConverter x:Key="RatingFilled" />

    <!-- Keyboard focus ring -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                            CornerRadius="{DynamicResource RadiusSmall}" SnapsToDevicePixels="True" Opacity="0.9" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Typography -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="VDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Small tag chip used across modules -->
    <DataTemplate x:Key="TagChip">
        <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="9" Padding="7,1" Margin="0,0,4,4">
            <TextBlock Text="{Binding StringFormat=#{0}}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
        </Border>
    </DataTemplate>

</ResourceDictionary>
