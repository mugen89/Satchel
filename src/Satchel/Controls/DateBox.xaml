<UserControl x:Class="Satchel.Controls.DateBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:core="clr-namespace:Satchel.Core"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="Toggle" Cursor="Hand" MinHeight="36" FocusVisualStyle="{StaticResource FocusRing}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=PopupHost, Converter={StaticResource Not}}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}" Padding="10,0,30,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{x:Static core:Glyphs.Calendar}" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="Display" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
            </DockPanel>
        </ToggleButton>
        <Button x:Name="ClearButton" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" FontSize="9" Width="24" Height="24"
                HorizontalAlignment="Right" Margin="0,0,5,0" Click="OnClear" ToolTip="Clear" />
        <Popup x:Name="PopupHost" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" Opened="OnOpened">
            <Border Margin="6,4,10,14" Width="280" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius}" Padding="12" Effect="{DynamicResource PopupShadow}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Today" Click="OnQuick" Tag="0" MinHeight="28" Padding="10,0" Margin="0,0,6,6" FontWeight="Normal" />
                        <Button Content="Tomorrow" Click="OnQuick" Tag="1" MinHeight="28" Padding="10,0" Margin="0,0,6,6" FontWeight="Normal" />
                        <Button Content="Next week" Click="OnQuick" Tag="7" MinHeight="28" Padding="10,0" Margin="0,0,6,6" FontWeight="Normal" />
                    </WrapPanel>
                    <c:MiniCalendar x:Name="Calendar" DateClicked="OnDatePicked" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
