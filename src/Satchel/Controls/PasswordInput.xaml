<UserControl x:Class="Satchel.Controls.PasswordInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             x:Name="Root" Focusable="False">
    <Grid>
        <PasswordBox x:Name="Pwd" Padding="10,0,40,0" PasswordChanged="OnPasswordChanged" MinHeight="{Binding MinHeight, ElementName=Root}"
                     b:Ui.Placeholder="{Binding Placeholder, ElementName=Root}" />
        <TextBox x:Name="Txt" Padding="10,0,40,0" Visibility="Collapsed" TextChanged="OnTextChanged" FontFamily="{StaticResource MonoFont}"
                 MinHeight="{Binding MinHeight, ElementName=Root}" b:Ui.Placeholder="{Binding Placeholder, ElementName=Root}" />
        <ToggleButton x:Name="Reveal" Style="{StaticResource ToolToggle}" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,4,0"
                      Content="{x:Static core:Glyphs.View}" Checked="OnRevealChanged" Unchecked="OnRevealChanged" Focusable="False"
                      ToolTip="Show / hide" />
    </Grid>
</UserControl>
