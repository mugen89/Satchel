<UserControl x:Class="Satchel.Controls.MiniCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Satchel.Core"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="hover" Width="30" Height="30" Fill="{DynamicResource HoverOverlayBrush}" Opacity="0" />
                            <Ellipse x:Name="today" Width="30" Height="30" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Visibility="Collapsed" />
                            <Ellipse x:Name="sel" Width="30" Height="30" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <TextBlock x:Name="num" Text="{Binding Day}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"
                                       Foreground="{DynamicResource TextBrush}" />
                            <Ellipse x:Name="dot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                     Margin="0,0,0,2" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="today" Property="Visibility" Value="Visible" />
                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter TargetName="num" Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="sel" Property="Visibility" Value="Visible" />
                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="num" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="4,0,0,6">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.ChevronLeft}" FontSize="10" Click="OnPrev" ToolTip="Previous month" />
                <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.ChevronRight}" FontSize="10" Click="OnNext" ToolTip="Next month" />
            </StackPanel>
        </Grid>
        <ItemsControl x:Name="WeekdayHeader" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,4" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl x:Name="DaysGrid" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource DayButton}" Click="OnDayClick" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
