<Window x:Class="Satchel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Satchel.Controls"
        xmlns:core="clr-namespace:Satchel.Core"
        Title="Satchel" Width="1320" Height="840" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="14" UseLayoutRounding="True"
        Icon="Assets/satchel.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="1"
                      UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.UiScale}" ScaleY="{Binding Settings.UiScale}" />
        </Grid.LayoutTransform>
        <AdornerDecorator>
            <Grid x:Name="DragRoot">
                <ContentControl Content="{Binding CurrentView}" Focusable="False" />

                <!-- The background music player: hidden, or shown over the video slot on the Music page. -->
                <c:YouTubePlayer x:Name="MusicPlayer" HorizontalAlignment="Left" VerticalAlignment="Top" Width="320" Height="180" Panel.ZIndex="5"
                                 StopWhenUnloaded="False" HideUnderOverlays="True" KeepAlive="True" IsShown="False" />

                <!-- Podcast audio (one pixel, never shown). -->
                <c:AudioHost x:Name="PodcastPlayer" Panel.ZIndex="5" />

                <!-- Music controls on the lock screen (no titles shown while locked). -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" Panel.ZIndex="15" Padding="14,6,6,6" CornerRadius="22"
                        Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Effect="{DynamicResource PopupShadow}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsUnlocked}" Value="False" />
                                        <Condition Binding="{Binding Music.HasTrack}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static core:Glyphs.Music}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                        <TextBlock Text="Music" Margin="10,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="&#xE892;" Command="{Binding Music.PreviousCommand}" ToolTip="Previous" />
                        <Button Style="{StaticResource IconButtonSmall}" Command="{Binding Music.PlayPauseCommand}" ToolTip="Play / pause"
                                Content="{Binding Music.IsPlaying, Converter={StaticResource BoolToString}, ConverterParameter=&#xE769;|&#xE768;}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="&#xE893;" Command="{Binding Music.NextCommand}" ToolTip="Next" />
                    </StackPanel>
                </Border>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Panel.ZIndex="10"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="{x:Static core:Glyphs.ChromeMinimize}" Click="OnMinimize" ToolTip="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="{x:Static core:Glyphs.ChromeMaximize}" Click="OnMaximize" ToolTip="Maximize" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="{x:Static core:Glyphs.ChromeClose}" Click="OnClose" ToolTip="Close" />
                </StackPanel>

                <ContentControl Content="{Binding Palette}" Panel.ZIndex="20" Focusable="False" />

                <ItemsControl ItemsSource="{Binding Dialogs}" Panel.ZIndex="30" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:DialogFrame />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Toasts}" Panel.ZIndex="40" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,22,20" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:AnimatedStackPanel Entrance="False" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:ToastView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </AdornerDecorator>
    </Grid>
</Window>
