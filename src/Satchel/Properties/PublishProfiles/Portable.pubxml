<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable, self-contained release: no .NET install needed on the target PC.
  Output: <repo>\release\Satchel\  -> copy that whole folder to a flash drive.
  The database is created next to the exe in .\Data\satchel.db on first run.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native DLLs stay beside the exe so nothing is extracted to %TEMP% on the host PC. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Uncompressed: the exe is memory-mapped instead of unpacked into RAM.
         Measured: ~1 s to first window and ~100 MB private memory, versus ~2.5 s / ~215 MB compressed
         (the exe is ~150 MB instead of ~65 MB). publish.ps1 -Compress builds the smaller variant. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>..\..\release\Satchel\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>
</Project>
