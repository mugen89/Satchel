<UserControl x:Class="Satchel.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <!-- Sidebar navigation item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="GroupName" Value="nav" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="hover" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SidebarHoverBrush}" Opacity="0" />
                            <Border x:Name="sel" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource AccentSubtleBrush}" Opacity="0" />
                            <Grid Margin="13,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="icon" Text="{TemplateBinding b:Ui.Icon}"
                                           FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <ContentPresenter x:Name="label" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" />
                                <Border x:Name="badge" Grid.Column="2" MinWidth="20" Height="18" CornerRadius="9" Padding="6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="{TemplateBinding b:Ui.Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,7,-3,0" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="b:Ui.Badge" Value="{x:Null}">
                                <Setter TargetName="badge" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                    <Condition Binding="{Binding Path=(b:Ui.Badge), RelativeSource={RelativeSource Self}, Converter={StaticResource HasValue}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter TargetName="label" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar section header: click to collapse / expand its tabs -->
        <Style x:Key="SectionHeader" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="23" Background="Transparent">
                            <DockPanel x:Name="full" Margin="14,0,8,2" VerticalAlignment="Bottom">
                                <TextBlock x:Name="chevron" DockPanel.Dock="Right" Text="{x:Static core:Glyphs.ChevronDown}" FontFamily="{StaticResource IconFont}" FontSize="8"
                                           Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="6,1,0,0" Opacity="0" />
                                <Border x:Name="count" DockPanel.Dock="Right" CornerRadius="7" Padding="5,0" MinWidth="16" Height="14" VerticalAlignment="Center"
                                        Background="{DynamicResource SidebarHoverBrush}" Visibility="Collapsed">
                                    <TextBlock Text="{Binding HiddenCount}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Ellipse x:Name="dot" DockPanel.Dock="Right" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                         Visibility="Collapsed" />
                                <TextBlock x:Name="label" Text="{Binding Title}" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border x:Name="line" Height="1" Background="{DynamicResource StrokeBrush}" Margin="12,6,12,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="more" Text="{x:Static core:Glyphs.More}" FontFamily="{StaticResource IconFont}" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chevron" Property="Opacity" Value="1" />
                                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter TargetName="chevron" Property="Text" Value="{x:Static core:Glyphs.ChevronRight}" />
                                <Setter TargetName="chevron" Property="Opacity" Value="1" />
                                <Setter TargetName="count" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCollapsed}" Value="True" />
                                    <Condition Binding="{Binding HasHiddenBadge}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <!-- Icons-only sidebar: a divider line; "…" marks a collapsed section -->
                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter TargetName="full" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="line" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                    <Condition Binding="{Binding IsCollapsed}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="line" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="more" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="13,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border x:Name="Sidebar" Width="232" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,0,1,0" ClipToBounds="True">
            <DockPanel Margin="12,0,12,14">
                <Grid DockPanel.Dock="Top" Height="68">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,6,0,0">
                        <c:LogoMark Size="32" />
                        <TextBlock x:Name="BrandText" Text="{Binding AppName}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,1" />
                    </StackPanel>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Divider}" Margin="6,8,6,8" />
                    <RadioButton Style="{StaticResource NavItem}" DataContext="{Binding SettingsItem}" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}"
                                 IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Tooltip}"
                                 Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding LockCommand}" ToolTip="Lock now (Ctrl+L)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static core:Glyphs.Lock}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="LockLabel" Text="Lock" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="Collapse / expand sidebar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CollapseIcon" Text="{x:Static core:Glyphs.ChevronLeft}" FontFamily="{StaticResource IconFont}" FontSize="12" Width="22"
                                       TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="CollapseLabel" Text="Collapse" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="DriveBadge" Margin="2,10,2,0" Padding="10,8" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SidebarHoverBrush}"
                            ToolTip="The app and all your data run from this drive">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static core:Glyphs.Usb}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                            <TextBlock Text="{Binding DriveText}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <Grid x:Name="NavHost">
                        <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="-12,0,0,0" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="IndicatorShift" />
                            </Border.RenderTransform>
                        </Border>
                        <ItemsControl x:Name="NavList" ItemsSource="{Binding NavRows}" Focusable="False">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type vm:NavItem}">
                                    <RadioButton Style="{StaticResource NavItem}" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}" ToolTip="{Binding Tooltip}"
                                                 b:Ui.Badge="{Binding Badge}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Visibility="{Binding IsFoldedAway, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                 Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:NavSection}">
                                    <Button Style="{StaticResource SectionHeader}" ToolTip="{Binding Tooltip}"
                                            Command="{Binding DataContext.ToggleSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top strip (window drag area): back / forward, global search, running timer and music -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,6,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Back}" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}"
                        ToolTip="Back (Alt+←)" FontSize="12" />
                <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Forward}" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}"
                        ToolTip="Forward (Alt+→)" FontSize="12" Margin="0,0,6,0" />
            </StackPanel>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,150,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- running timer / stopwatch -->
                <Button x:Name="TimerPill" Style="{StaticResource GhostButton}" MinHeight="30" Height="30" Padding="10,0" Margin="0,0,8,0" Command="{Binding OpenPageCommand}" CommandParameter="Clock"
                        Visibility="{Binding Timers.HasActive, Converter={StaticResource BoolToVis}}" ToolTip="Clock (Ctrl+T)" FontWeight="Normal">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TimerIcon" Text="{x:Static core:Glyphs.Timer}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                        <TextBlock Text="{Binding Timers.PillText}" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <!-- now playing -->
                <Border x:Name="MusicPill" Height="32" CornerRadius="16" Padding="3,0,4,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                        Visibility="{Binding Music.HasTrack, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RowButton}" Padding="0" Command="{Binding OpenPageCommand}" CommandParameter="Music" ToolTip="Open Music" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="24" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource SegmentBrush}" VerticalAlignment="Center">
                                    <Image Source="{Binding Music.Thumbnail, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Margin="8,0,6,0" VerticalAlignment="Center" MaxWidth="190">
                                    <TextBlock Text="{Binding Music.Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Grid Height="2" Margin="0,2,0,0">
                                        <Border Background="{DynamicResource SegmentBrush}" CornerRadius="1" />
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="1" HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                    <Binding Path="Music.Progress" />
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButtonSmall}" Width="26" Height="26" FontSize="11" Content="&#xE892;" Command="{Binding Music.PreviousCommand}" ToolTip="Previous" />
                        <Button Style="{StaticResource IconButtonSmall}" Width="26" Height="26" FontSize="12" Command="{Binding Music.PlayPauseCommand}" ToolTip="Play / pause (Ctrl+Shift+Space)"
                                Content="{Binding Music.IsPlaying, Converter={StaticResource BoolToString}, ConverterParameter=&#xE769;|&#xE768;}" />
                        <Button Style="{StaticResource IconButtonSmall}" Width="26" Height="26" FontSize="11" Content="&#xE893;" Command="{Binding Music.NextCommand}" ToolTip="Next" />
                    </StackPanel>
                </Border>
                <!-- podcast episode -->
                <Border Height="32" CornerRadius="16" Padding="10,0,4,0" Margin="8,0,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                        Visibility="{Binding Podcast.HasEpisode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RowButton}" Padding="0" Command="{Binding OpenPageCommand}" CommandParameter="Feeds" ToolTip="Open Feeds" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static core:Glyphs.Feed}" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                <StackPanel Margin="8,0,6,0" VerticalAlignment="Center" MaxWidth="170">
                                    <TextBlock Text="{Binding Podcast.Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Grid Height="2" Margin="0,2,0,0">
                                        <Border Background="{DynamicResource SegmentBrush}" CornerRadius="1" />
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="1" HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                    <Binding Path="Podcast.Progress" />
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButtonSmall}" Width="26" Height="26" FontSize="12" Command="{Binding Podcast.TogglePlayCommand}" ToolTip="Play / pause"
                                Content="{Binding Podcast.IsPlaying, Converter={StaticResource BoolToString}, ConverterParameter=&#xE769;|&#xE768;}" />
                        <Button Style="{StaticResource IconButtonSmall}" Width="26" Height="26" FontSize="10" Content="{x:Static core:Glyphs.Close}" Command="{Binding Podcast.StopCommand}" ToolTip="Stop the episode" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="84,6,0,0" Width="340" Height="32" MinHeight="0"
                    Padding="12,0" HorizontalContentAlignment="Stretch" Command="{Binding OpenPaletteCommand}" FontWeight="Normal"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Search everything (Ctrl+K)">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static core:Glyphs.Search}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFaintBrush}" />
                        <TextBlock Text="Search or jump to…" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="5" Padding="6,1">
                        <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </Grid>
            </Button>

            <!-- Dashboard profiles with an icon: one-click shortcuts (Alt+1…9 switches between all profiles) -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding DashboardShortcuts}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="434,6,0,0"
                          Focusable="False" WindowChrome.IsHitTestVisibleInChrome="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DashboardShortcut}">
                        <Button x:Name="shortcut" Style="{StaticResource IconButtonSmall}" Width="32" Height="32" Margin="0,0,2,0" FontSize="14" Content="{Binding Icon}"
                                ToolTip="{Binding Tooltip}" WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding DataContext.OpenDashboardProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="shortcut" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="shortcut" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <c:PageHost Grid.Row="1" Page="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</UserControl>
