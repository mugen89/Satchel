<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Satchel.Controls"
                    xmlns:b="clr-namespace:Satchel.Behaviors"
                    xmlns:core="clr-namespace:Satchel.Core"
                    xmlns:dvm="clr-namespace:Satchel.ViewModels.Dialogs">

    <DataTemplate DataType="{x:Type dvm:EventEditorViewModel}">
        <DockPanel>
            <!-- Title -->
            <DockPanel DockPanel.Dock="Top">
                <Border DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="4" VerticalAlignment="Center" Margin="0,2,12,0"
                        Background="{Binding EffectiveColorKey, Converter={StaticResource PaletteBrush}}" />
                <TextBox Style="{StaticResource InlineTextBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="21" FontWeight="SemiBold"
                         FontFamily="{StaticResource DisplayFont}" b:Ui.Placeholder="Add a title" b:Ui.FocusOnLoad="True" b:Ui.EnterCommand="{Binding SaveCommand}" />
            </DockPanel>

            <!-- Footer -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource DangerGhostButton}" Content="Delete" b:Ui.Icon="{x:Static core:Glyphs.Delete}" Command="{Binding DeleteCommand}"
                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Padding="10,0" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteOneCommand}" Padding="10,0" Margin="4,0,0,0"
                            Visibility="{Binding IsRecurringExisting, Converter={StaticResource BoolToVis}}">
                        <TextBlock>
                            <Run Text="Skip " /><Run Text="{Binding OccurrenceText, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                    <ToggleButton Style="{StaticResource Chip}" Content="Private" b:Ui.Icon="{x:Static core:Glyphs.Hide}" IsChecked="{Binding IsPrivate}" Margin="8,0,0,0"
                                  ToolTip="Private events are left out while private items are hidden" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Style="{StaticResource AccentButton}" Content="Save" Command="{Binding SaveCommand}" MinWidth="90" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />

            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" Margin="0,12,-12,0" Padding="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock" x:Key="RowLabel" BasedOn="{StaticResource Muted}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,10,12,0" />
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Text="Calendar" Style="{StaticResource RowLabel}" />
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,10,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="All day" IsChecked="{Binding IsAllDay}" Margin="16,0,0,0" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{Binding Color, Converter={StaticResource PaletteBrush}}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="Starts" Style="{StaticResource RowLabel}" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                        <c:TimeBox DockPanel.Dock="Right" Time="{Binding StartTime}" Width="120" Margin="8,0,0,0"
                                   Visibility="{Binding IsAllDay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <c:DateBox SelectedDate="{Binding StartDate}" AllowClear="False" KeepTime="False" />
                    </DockPanel>

                    <TextBlock Grid.Row="2" Text="Ends" Style="{StaticResource RowLabel}" />
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                        <c:TimeBox DockPanel.Dock="Right" Time="{Binding EndTime}" Width="120" Margin="8,0,0,0"
                                   Visibility="{Binding IsAllDay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <c:DateBox SelectedDate="{Binding EndDate}" AllowClear="False" KeepTime="False" />
                    </DockPanel>

                    <TextBlock Grid.Row="3" Text="Repeat" Style="{StaticResource RowLabel}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" ItemsSource="{x:Static dvm:EventEditorViewModel.RepeatChoices}"
                              SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Recurrence}" />

                    <Border Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Padding="14,12" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource InputBrush}"
                            Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Width="56" TextAlignment="Center" MinHeight="32" />
                                <TextBlock Text="{Binding IntervalUnit}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Weekdays}" Margin="0,12,0,0" Focusable="False" Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsOn, Mode=OneWay}" Margin="0,0,5,0" Padding="9,0"
                                                      Command="{Binding DataContext.ToggleWeekdayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                      CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Ends" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                            <StackPanel>
                                <RadioButton Content="Never" IsChecked="{Binding EndMode, Converter={StaticResource Equals}, ConverterParameter=never}" GroupName="ends" Margin="0,0,0,8" />
                                <DockPanel Margin="0,0,0,8">
                                    <RadioButton Content="On" Width="70" IsChecked="{Binding EndMode, Converter={StaticResource Equals}, ConverterParameter=until}" GroupName="ends" VerticalAlignment="Center" />
                                    <c:DateBox SelectedDate="{Binding Until}" Placeholder="Pick a date" Width="200" HorizontalAlignment="Left" MinHeight="32" KeepTime="False" />
                                </DockPanel>
                                <DockPanel>
                                    <RadioButton Content="After" Width="70" IsChecked="{Binding EndMode, Converter={StaticResource Equals}, ConverterParameter=count}" GroupName="ends" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="56" TextAlignment="Center" MinHeight="32" />
                                    <TextBlock Text="occurrences" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </DockPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="5" Text="Reminder" Style="{StaticResource RowLabel}" />
                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" ItemsSource="{x:Static dvm:EventEditorViewModel.ReminderChoices}"
                              SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Reminder}" />

                    <TextBlock Grid.Row="6" Text="Location" Style="{StaticResource RowLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Add a place or link" />

                    <TextBlock Grid.Row="7" Text="Color" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <ToggleButton Style="{StaticResource Chip}" Content="Calendar color" IsChecked="{Binding HasCustomColor, Mode=OneWay, Converter={StaticResource Not}}"
                                      Command="{Binding SetColorCommand}" CommandParameter="{x:Null}" Margin="0,0,10,0" VerticalAlignment="Top" />
                        <c:ColorSwatches SelectedKey="{Binding ColorKey}" SwatchSize="20" MaxWidth="260" />
                    </StackPanel>

                    <TextBlock Grid.Row="8" Text="Notes" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,18,12,0" />
                    <TextBox Grid.Row="8" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource MultilineTextBox}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             b:Ui.Placeholder="Agenda, links, details…" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
