<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Satchel.Controls"
                    xmlns:b="clr-namespace:Satchel.Behaviors"
                    xmlns:core="clr-namespace:Satchel.Core"
                    xmlns:vm="clr-namespace:Satchel.ViewModels"
                    xmlns:dvm="clr-namespace:Satchel.ViewModels.Dialogs">

    <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,10,12,0" />
    </Style>

    <!-- ===== Profile editor ===== -->
    <DataTemplate DataType="{x:Type dvm:ProfileEditorViewModel}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding HeaderText}" Style="{StaticResource Title}" FontSize="19" />

            <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource DangerGhostButton}" Content="Delete" b:Ui.Icon="{x:Static core:Glyphs.Delete}" Command="{Binding DeleteCommand}"
                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Padding="10,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Style="{StaticResource AccentButton}" Content="Save" Command="{Binding SaveCommand}" MinWidth="90" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Margin="0,14,-12,0" Padding="0,0,12,0">
                <StackPanel>
                    <DockPanel>
                        <c:Avatar Image="{Binding Image}" Text="{Binding Name}" Glyph="{Binding Icon}" ColorKey="{Binding Color}" Size="76" Solid="True" />
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <WrapPanel>
                                <Button Content="Choose image…" b:Ui.Icon="{x:Static core:Glyphs.Picture}" Command="{Binding PickImageCommand}" Margin="0,0,8,6" MinHeight="32" />
                                <Button Content="Paste" b:Ui.Icon="{x:Static core:Glyphs.Camera}" Command="{Binding PasteImageCommand}" Margin="0,0,8,6" MinHeight="32" ToolTip="Paste an image from the clipboard" />
                                <Button Style="{StaticResource GhostButton}" Content="Remove" Command="{Binding RemoveImageCommand}" MinHeight="32" Margin="0,0,0,6"
                                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>
                            <TextBlock Text="Logo or photo. Images are resized and stored encrypted." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Icon &amp; color (used when there's no image)" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{x:Static dvm:ProfileEditorViewModel.IconChoices}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="ib" Style="{StaticResource IconButtonSmall}" Width="34" Height="34" Content="{Binding}" Margin="0,0,4,4"
                                        Command="{Binding DataContext.SetIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="">
                                        <Setter TargetName="ib" Property="Content" Value="Aa" />
                                        <Setter TargetName="ib" Property="FontFamily" Value="{DynamicResource UiFont}" />
                                        <Setter TargetName="ib" Property="ToolTip" Value="Initials" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource AllEqual}">
                                                <Binding />
                                                <Binding Path="DataContext.Icon" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="ib" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                        <Setter TargetName="ib" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:ColorSwatches SelectedKey="{Binding Color}" Margin="0,8,0,0" SwatchSize="22" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" Style="{StaticResource FormLabel}" />
                        <TextBox Grid.Column="1" Margin="0,10,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="e.g. Google, My Bank, Home Wi-Fi"
                                 b:Ui.FocusOnLoad="True" b:Ui.EnterCommand="{Binding SaveCommand}" />
                        <TextBlock Grid.Row="1" Text="Website" Style="{StaticResource FormLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="https://" />
                        <TextBlock Grid.Row="2" Text="Category" Style="{StaticResource FormLabel}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" IsEditable="True" ItemsSource="{Binding Categories}" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Text="Tags" Style="{StaticResource FormLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Comma separated" />
                        <TextBlock Grid.Row="4" Text="Notes" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,18,12,0" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource MultilineTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,14,0,0">
                            <CheckBox Style="{StaticResource Switch}" Content="Favorite" IsChecked="{Binding IsFavorite}" HorizontalAlignment="Left" />
                            <CheckBox Content="Add an account right after saving" IsChecked="{Binding AddAccountAfterSave}" Margin="0,12,0,0"
                                      Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===== Account editor ===== -->
    <DataTemplate DataType="{x:Type dvm:AccountEditorViewModel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <c:Avatar Image="{Binding Image}" Glyph="{Binding KindGlyph}" Size="40" VerticalAlignment="Center" />
                <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Title}" FontSize="19" Margin="14,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{x:Static dvm:AccountEditorViewModel.KindChoices}" Margin="0,16,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding Label}" b:Ui.Icon="{Binding Glyph}" Margin="0,0,6,6" Padding="10,0" MinHeight="28" FontSize="12"
                                      Command="{Binding DataContext.SetKindCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Value}">
                            <ToggleButton.IsChecked>
                                <MultiBinding Converter="{StaticResource AllEqual}" Mode="OneWay">
                                    <Binding Path="Value" />
                                    <Binding Path="DataContext.Kind" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </ToggleButton.IsChecked>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource DangerGhostButton}" Content="Delete" b:Ui.Icon="{x:Static core:Glyphs.Delete}" Command="{Binding DeleteCommand}"
                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Padding="10,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Style="{StaticResource AccentButton}" Content="Save" b:Ui.Icon="{x:Static core:Glyphs.Lock}" Command="{Binding SaveCommand}" MinWidth="100" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />

            <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto" Margin="0,8,-12,0" Padding="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Account name" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" b:Ui.FocusOnLoad="True"
                             b:Ui.Placeholder="e.g. Personal, Work, Main — helps tell several accounts apart" />

                    <TextBlock Grid.Row="1" Text="Sign in with" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" ItemsSource="{Binding SignInOptions}" SelectedItem="{Binding SignInWith}" b:Ui.Placeholder="Password (default)" />

                    <TextBlock Grid.Row="2" Text="Username" Style="{StaticResource FormLabel}" Visibility="{Binding ShowUsername, Converter={StaticResource BoolToVis}}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowUsername, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="3" Text="Email" Style="{StaticResource FormLabel}" Visibility="{Binding ShowEmail, Converter={StaticResource BoolToVis}}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowEmail, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="4" Text="Password" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,18,12,0"
                               Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Sliders}" Command="{Binding OpenGeneratorCommand}"
                                    ToolTip="Generator options…" Margin="4,0,0,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleAccentButton}" Content="Generate" b:Ui.Icon="{x:Static core:Glyphs.Lightning}"
                                    Command="{Binding GeneratePasswordCommand}" Margin="8,0,0,0" />
                            <c:PasswordInput Password="{Binding Password}" Placeholder="Password" />
                        </DockPanel>
                        <c:StrengthMeter Password="{Binding Password}" Margin="0,8,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Text="Website" Style="{StaticResource FormLabel}" Visibility="{Binding ShowUrl, Converter={StaticResource BoolToVis}}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="https://"
                             Visibility="{Binding ShowUrl, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="6" Text="2FA secret" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,18,12,0"
                               Visibility="{Binding ShowTotp, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,10,0,0" Visibility="{Binding ShowTotp, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding TotpSecret, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                 b:Ui.Placeholder="Base32 secret or otpauth:// link from the QR setup" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding TotpValid, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Current code:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <c:TotpBadge Secret="{Binding TotpSecret}" />
                        </StackPanel>
                        <TextBlock Text="That doesn't look like a valid secret." Style="{StaticResource Caption}" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding TotpInvalid, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="7" Text="Expires" Style="{StaticResource FormLabel}" />
                    <c:DateBox Grid.Row="7" Grid.Column="1" Margin="0,10,0,0" SelectedDate="{Binding ExpiresAt}" Placeholder="Never (for tokens, cards, licenses…)" KeepTime="False" />

                    <TextBlock Grid.Row="8" Text="Fields" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,18,12,0" />
                    <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dvm:FieldEditor}">
                                    <Border Background="{DynamicResource InputBrush}" CornerRadius="{DynamicResource RadiusSmall}" Padding="10,8" Margin="0,0,0,8"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" FontSize="9"
                                                        Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Remove field" />
                                                <ComboBox DockPanel.Dock="Right" Style="{StaticResource SmallCombo}" Width="122" Margin="8,0,4,0" ItemsSource="{x:Static dvm:FieldEditor.TypeChoices}"
                                                          SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Type}" />
                                                <TextBox Style="{StaticResource InlineTextBox}" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"
                                                         b:Ui.Placeholder="Field name" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBox Margin="0,8,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource SurfaceBrush}"
                                                     Visibility="{Binding IsSecret, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                                                <Setter Property="AcceptsReturn" Value="True" />
                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                                <Setter Property="MinHeight" Value="70" />
                                                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                                                <Setter Property="Padding" Value="10,8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <c:PasswordInput Margin="0,8,0,0" Password="{Binding Value}" Placeholder="Secret value"
                                                             Visibility="{Binding IsSecret, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add field" b:Ui.Icon="{x:Static core:Glyphs.Add}" HorizontalAlignment="Left" MinHeight="32" b:Ui.MenuOnClick="True">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Custom field" Icon="{x:Static core:Glyphs.Edit}" Command="{Binding AddFieldCommand}" CommandParameter="{x:Null}" />
                                    <Separator />
                                    <MenuItem Header="Recovery codes" Command="{Binding AddFieldCommand}" CommandParameter="Recovery codes" />
                                    <MenuItem Header="Security question" Command="{Binding AddFieldCommand}" CommandParameter="Security question" />
                                    <MenuItem Header="Security answer" Command="{Binding AddFieldCommand}" CommandParameter="Security answer" />
                                    <MenuItem Header="PIN" Command="{Binding AddFieldCommand}" CommandParameter="PIN" />
                                    <MenuItem Header="API key" Command="{Binding AddFieldCommand}" CommandParameter="API key" />
                                    <MenuItem Header="Phone" Command="{Binding AddFieldCommand}" CommandParameter="Phone" />
                                    <MenuItem Header="Account number" Command="{Binding AddFieldCommand}" CommandParameter="Account number" />
                                    <MenuItem Header="Note" Command="{Binding AddFieldCommand}" CommandParameter="Note" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="9" Text="Tags" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="9" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Comma separated" />

                    <TextBlock Grid.Row="10" Text="Notes" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,18,12,0" />
                    <TextBox Grid.Row="10" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource MultilineTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" />

                    <TextBlock Grid.Row="11" Text="Picture" Style="{StaticResource FormLabel}" />
                    <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Choose…" b:Ui.Icon="{x:Static core:Glyphs.Picture}" Command="{Binding PickImageCommand}" MinHeight="32" />
                        <Button Content="Paste" Command="{Binding PasteImageCommand}" MinHeight="32" Margin="8,0,0,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Remove" Command="{Binding RemoveImageCommand}" MinHeight="32" Margin="8,0,0,0"
                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                        <CheckBox Style="{StaticResource Switch}" Content="Favorite" IsChecked="{Binding IsFavorite}" Margin="24,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Row="12" Grid.Column="1" Style="{StaticResource LinkButton}" Content="Show all standard fields" Command="{Binding ToggleShowAllCommand}"
                            Margin="0,14,0,0" HorizontalAlignment="Left" FontSize="12" Visibility="{Binding HasHiddenFields, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===== Password generator ===== -->
    <DataTemplate DataType="{x:Type dvm:PasswordGeneratorViewModel}">
        <StackPanel>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSubtleBrush}">
                    <TextBlock Text="{x:Static core:Glyphs.Lightning}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Password generator" Style="{StaticResource Title}" FontSize="19" />
                    <TextBlock Text="{Binding EntropyText}" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>

            <Border Margin="0,18,0,0" Padding="16,14" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Refresh}" Command="{Binding RegenerateCommand}" ToolTip="Regenerate" />
                        <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Copy}" Command="{Binding CopyCommand}" ToolTip="Copy" />
                    </StackPanel>
                    <c:ColoredPasswordText Password="{Binding Password}" FontFamily="{StaticResource MonoFont}" FontSize="19" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <c:StrengthMeter Password="{Binding Password}" ShowHint="False" Margin="0,10,0,0" />

            <Border Style="{StaticResource SegmentHost}" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="Random password" IsChecked="{Binding Options.UsePassphrase, Converter={StaticResource Not}}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Passphrase" IsChecked="{Binding Options.UsePassphrase}" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,14,0,0" Visibility="{Binding Options.UsePassphrase, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Options.Length}" FontWeight="SemiBold" Width="32" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Text="Length" Width="90" VerticalAlignment="Center" />
                    <Slider Minimum="8" Maximum="64" Value="{Binding Options.Length}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,10,0" VerticalAlignment="Center" />
                </DockPanel>
                <UniformGrid Columns="2" Margin="0,12,0,0">
                    <CheckBox Style="{StaticResource Switch}" Content="Uppercase  A–Z" IsChecked="{Binding Options.Uppercase}" Margin="0,0,16,10" />
                    <CheckBox Style="{StaticResource Switch}" Content="Lowercase  a–z" IsChecked="{Binding Options.Lowercase}" Margin="0,0,0,10" />
                    <CheckBox Style="{StaticResource Switch}" Content="Digits  0–9" IsChecked="{Binding Options.Digits}" Margin="0,0,16,10" />
                    <CheckBox Style="{StaticResource Switch}" Content="Symbols  !@#" IsChecked="{Binding Options.Symbols}" Margin="0,0,0,10" />
                </UniformGrid>
                <CheckBox Content="Avoid look-alike characters (l, 1, O, 0…)" IsChecked="{Binding Options.AvoidAmbiguous}" />
            </StackPanel>

            <StackPanel Margin="0,14,0,0" Visibility="{Binding Options.UsePassphrase, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Options.WordCount}" FontWeight="SemiBold" Width="32" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Text="Words" Width="90" VerticalAlignment="Center" />
                    <Slider Minimum="3" Maximum="10" Value="{Binding Options.WordCount}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,10,0" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock Text="Separator" Width="90" VerticalAlignment="Center" />
                    <ComboBox Width="160" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding Options.Separator}">
                        <ComboBoxItem Content="Hyphen  -" Tag="-" />
                        <ComboBoxItem Content="Dot  ." Tag="." />
                        <ComboBoxItem Content="Underscore  _" Tag="_" />
                        <ComboBoxItem Content="Space" Tag=" " />
                        <ComboBoxItem Content="None" Tag="" />
                    </ComboBox>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox Style="{StaticResource Switch}" Content="Capitalize" IsChecked="{Binding Options.Capitalize}" Margin="0,0,24,0" />
                    <CheckBox Style="{StaticResource Switch}" Content="Add a number" IsChecked="{Binding Options.IncludeNumber}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Close" Command="{Binding CancelCommand}" MinWidth="90" />
                <Button Content="Copy" b:Ui.Icon="{x:Static core:Glyphs.Copy}" Command="{Binding CopyCommand}" Margin="10,0,0,0" MinWidth="90" />
                <Button Style="{StaticResource AccentButton}" Content="Use password" Command="{Binding UseCommand}" Margin="10,0,0,0"
                        Visibility="{Binding CanUse, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
