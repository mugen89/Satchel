<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:Satchel.Behaviors"
                    xmlns:c="clr-namespace:Satchel.Controls"
                    xmlns:core="clr-namespace:Satchel.Core"
                    xmlns:dvm="clr-namespace:Satchel.ViewModels.Dialogs">

    <!-- ===== Master password check ===== -->
    <DataTemplate DataType="{x:Type dvm:VerifyPasswordDialogViewModel}">
        <StackPanel>
            <DockPanel>
                <Border Width="42" Height="42" CornerRadius="21" VerticalAlignment="Top" Background="{DynamicResource AccentSubtleBrush}">
                    <TextBlock Text="{x:Static core:Glyphs.Lock}" FontFamily="{StaticResource IconFont}" FontSize="17" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <StackPanel Margin="16,2,0,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" FontSize="19" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
            <c:PasswordInput Password="{Binding Password}" Margin="0,18,0,0" b:Ui.FocusOnLoad="True" b:Ui.EnterCommand="{Binding ConfirmCommand}" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                <Button Content="Continue" Command="{Binding ConfirmCommand}" Style="{StaticResource AccentButton}" MinWidth="110" Margin="10,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===== Keyboard cheat sheet ===== -->
    <DataTemplate x:Key="ShortcutGroupTemplate">
        <StackPanel Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="184" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Long combinations wrap inside the key cap instead of being cut off. -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1,1,1,2" CornerRadius="5" Padding="7,1" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Keys}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Action}" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None"
                                       Foreground="{DynamicResource TextBrush}" Margin="8,2,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dvm:ShortcutsDialogViewModel}">
        <DockPanel MaxHeight="640">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CancelCommand}" ToolTip="Close (Esc)" />
                <TextBlock Text="{x:Static core:Glyphs.Lightning}" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Title}" FontSize="19" />
                    <TextBlock Text="Press F1 or Ctrl+/ any time to see this again." Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding Left}" ItemTemplate="{StaticResource ShortcutGroupTemplate}" Focusable="False" />
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Right}" ItemTemplate="{StaticResource ShortcutGroupTemplate}" Focusable="False" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===== Board note, large ===== -->
    <DataTemplate DataType="{x:Type dvm:StickyEditorDialogViewModel}">
        <DockPanel Height="600">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Done" Command="{Binding DoneCommand}" MinWidth="90" ToolTip="Back to the board (Esc)" />
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Colors}" Focusable="False" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="22" Height="22" Margin="0,0,6,0" Cursor="Hand" ToolTip="{Binding Name}" Focusable="False"
                                    Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Ellipse Fill="{Binding Key, Converter={StaticResource PaletteBrush}, ConverterParameter=sticky}" Stroke="#33000000" StrokeThickness="1" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Board note" Style="{StaticResource Title}" FontSize="19" />
                    <TextBlock Text="The same note as on the board — what you change here shows up there." Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
            <Border CornerRadius="{DynamicResource Radius}" Padding="20,16" Background="{Binding Sticky.Color, Converter={StaticResource PaletteBrush}, ConverterParameter=sticky}">
                <c:RichTextEditor ContentText="{Binding Sticky.Content}" PlainText="{Binding Sticky.Text}" EditorForeground="#262626"
                                  EditorFontSize="{Binding Sticky.EffectiveFontSize}" AutoFocus="True" />
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ===== Dashboard profile ===== -->
    <DataTemplate DataType="{x:Type dvm:DashboardProfileDialogViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Title}" FontSize="19" />
            <TextBlock Text="Each profile is its own set of widgets — one for work, one for evenings. Give it an icon to get a one-click shortcut in the top bar."
                       Style="{StaticResource Body}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="e.g. Work, Weekend, Study" b:Ui.FocusOnLoad="True"
                     b:Ui.SelectAllOnFocus="True" b:Ui.EnterCommand="{Binding SaveCommand}" MaxLength="40" />

            <TextBlock Text="Icon" Style="{StaticResource FieldLabel}" />
            <ItemsControl ItemsSource="{x:Static dvm:DashboardProfileDialogViewModel.Icons}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="ib" Style="{StaticResource IconButtonSmall}" Width="36" Height="36" FontSize="15" Content="{Binding}" Margin="0,0,4,4"
                                Command="{Binding DataContext.SetIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding}" Value="">
                                <Setter TargetName="ib" Property="Content" Value="None" />
                                <Setter TargetName="ib" Property="FontFamily" Value="{DynamicResource UiFont}" />
                                <Setter TargetName="ib" Property="FontSize" Value="11.5" />
                                <Setter TargetName="ib" Property="Width" Value="52" />
                                <Setter TargetName="ib" Property="ToolTip" Value="No icon — reach it from the profile menu or with Alt+number" />
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource AllEqual}">
                                        <Binding />
                                        <Binding Path="DataContext.Icon" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="ib" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="ib" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Start with" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{Binding CopyLabel}" IsChecked="{Binding Start, Converter={StaticResource Equals}, ConverterParameter=copy}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Default widgets" IsChecked="{Binding Start, Converter={StaticResource Equals}, ConverterParameter=default}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Empty" IsChecked="{Binding Start, Converter={StaticResource Equals}, ConverterParameter=empty}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />

            <DockPanel Margin="0,22,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource DangerGhostButton}" Content="Delete profile" b:Ui.Icon="{x:Static core:Glyphs.Delete}" Padding="10,0"
                        Command="{Binding DeleteCommand}" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Style="{StaticResource AccentButton}" Content="{Binding SaveText}" Command="{Binding SaveCommand}" MinWidth="100" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===== Sidebar order ===== -->
    <DataTemplate DataType="{x:Type dvm:TabOrderDialogViewModel}">
        <DockPanel MaxHeight="620">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Sidebar order" Style="{StaticResource Title}" FontSize="19" />
                <TextBlock Text="Drag the tabs, or use the arrows. With section headers on, tabs are grouped by section — a section appears where its first tab is."
                           Style="{StaticResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Default order" Command="{Binding ResetOrderCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" MinWidth="100" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" b:DnD.IsReorderable="True" b:DnD.Group="taborder" b:DnD.Mode="Vertical"
                              b:DnD.ReorderCommand="{Binding ReorderCommand}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:AnimatedStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                                    Padding="10,4,4,4" Margin="0,0,0,4" Cursor="SizeNS">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.ChevronUp}" FontSize="10" ToolTip="Move up"
                                                Command="{Binding DataContext.UpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.ChevronDown}" FontSize="10" ToolTip="Move down"
                                                Command="{Binding DataContext.DownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{x:Static core:Glyphs.Gripper}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Section}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock x:Name="title" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                    <Setter TargetName="title" Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===== Countdown ===== -->
    <DataTemplate DataType="{x:Type dvm:CountdownDialogViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Title}" FontSize="19" />
            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="e.g. Trip to Lisbon" b:Ui.FocusOnLoad="True" b:Ui.EnterCommand="{Binding SaveCommand}" />
            <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
            <c:DateBox SelectedDate="{Binding Date}" AllowClear="False" KeepTime="False" MinHeight="34" />
            <DockPanel Margin="0,14,0,0">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Yearly}" />
                <TextBlock Text="Every year (birthdays, anniversaries)" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel Margin="0,10,0,0">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding OnDashboard}" />
                <TextBlock Text="Show on the dashboard" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Emoji" Style="{StaticResource FieldLabel}" />
            <ItemsControl ItemsSource="{x:Static dvm:CountdownDialogViewModel.Emojis}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding}" FontFamily="{StaticResource EmojiFont}" Margin="0,0,6,6" MinWidth="36"
                                      Command="{Binding DataContext.PickEmojiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <ToggleButton.IsChecked>
                                <MultiBinding Converter="{StaticResource AllEqual}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="DataContext.Emoji" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </ToggleButton.IsChecked>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" />
            <c:ColorSwatches SelectedKey="{Binding Color}" SwatchSize="22" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />
            <DockPanel Margin="0,22,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource DangerGhostButton}" Content="Delete" Command="{Binding DeleteCommand}"
                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" MinWidth="100" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===== Multi-line prompt ===== -->
    <DataTemplate DataType="{x:Type dvm:TextAreaDialogViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" FontSize="19" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
            <TextBox Style="{StaticResource MultilineTextBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinHeight="180" MaxHeight="320" Margin="0,14,0,0"
                     AcceptsTab="True" FontFamily="{StaticResource MonoFont}" FontSize="12.5" b:Ui.Placeholder="{Binding Placeholder}" b:Ui.FocusOnLoad="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Style="{StaticResource AccentButton}" MinWidth="100" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===== Collection fields ===== -->
    <DataTemplate DataType="{x:Type dvm:FieldsDialogViewModel}">
        <DockPanel MaxHeight="620">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Fields" Style="{StaticResource Title}" FontSize="19" />
                <TextBlock Text="Every item gets these. Choice fields list their options separated by commas. Ticked fields show on the cards." Style="{StaticResource Body}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button DockPanel.Dock="Left" Content="Add field" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" MinWidth="100" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dvm:FieldRow}">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                            <CheckBox IsChecked="{Binding ShowOnCard}" Content="On cards" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.ChevronUp}" FontSize="10" ToolTip="Move up"
                                                    Command="{Binding DataContext.UpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Delete}" FontSize="11" ToolTip="Remove the field"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{x:Static dvm:FieldsDialogViewModel.Kinds}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                                  SelectedValue="{Binding Kind}" Margin="8,0,0,0" MinHeight="32" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Field name" MinHeight="32" />
                                    </DockPanel>
                                    <TextBox Text="{Binding Options, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Options: Red, White, Rosé" Margin="0,6,0,0" MinHeight="30"
                                             Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===== List picker ===== -->
    <DataTemplate DataType="{x:Type dvm:PickDialogViewModel}">
        <DockPanel MaxHeight="560">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" FontSize="19" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                <TextBox Style="{StaticResource SearchBox}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="{Binding Placeholder}" Margin="0,14,0,4"
                         b:Ui.FocusOnLoad="True" b:Ui.EnterCommand="{Binding PickFirstCommand}" Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,-10,0" Padding="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Padding="10,8" Margin="0,0,0,2" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0"
                                            Background="{Binding ColorKey, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding ColorKey, Converter={StaticResource PaletteBrush}}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
