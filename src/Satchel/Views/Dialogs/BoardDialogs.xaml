<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:Satchel.Behaviors"
                    xmlns:core="clr-namespace:Satchel.Core"
                    xmlns:dvm="clr-namespace:Satchel.ViewModels.Dialogs">

    <!-- ===== Add from Satchel (board) ===== -->
    <DataTemplate x:Key="InsertCard" DataType="{x:Type dvm:InsertItem}">
        <Button x:Name="card" Style="{StaticResource RowButton}" Width="160" Margin="0,0,10,10" Padding="4" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch"
                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding Title}">
            <Grid>
                <Border x:Name="ring" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" Margin="-4" />
                <StackPanel>
                    <Grid Height="102">
                        <!-- an icon tile when there's no picture -->
                        <Border CornerRadius="6" Background="{Binding ColorKey, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding ColorKey, Converter={StaticResource PaletteBrush}}" />
                        </Border>
                        <!-- notes look like the board note they'll become -->
                        <Border CornerRadius="3,3,3,12" Padding="10,8" Visibility="{Binding IsNote, Converter={StaticResource BoolToVis}}"
                                Background="{Binding StickyColor, Converter={StaticResource PaletteBrush}, ConverterParameter=sticky}">
                            <TextBlock Text="{Binding Preview}" FontSize="11.5" Foreground="#3A3A3A" TextWrapping="Wrap" TextTrimming="WordEllipsis" />
                        </Border>
                        <Border CornerRadius="6" ClipToBounds="True" Visibility="{Binding HasThumb, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SegmentBrush}">
                            <Image Source="{Binding Thumb, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Background="#A6000000"
                                Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}" ToolTip="Private — the copy on the board will be private too">
                            <TextBlock Text="{x:Static core:Glyphs.Hide}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="check" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                            <TextBlock Text="{x:Static core:Glyphs.Check}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource OnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="2,7,2,0" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,1,2,2" />
                </StackPanel>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="check" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dvm:BoardInsertDialogViewModel}">
        <DockPanel Height="640">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CancelCommand}" ToolTip="Close (Esc)"
                        VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="Add from Satchel" Style="{StaticResource Title}" FontSize="19" />
                    <TextBlock Text="Pick as many as you like — from several tabs at once — then add them together." Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Style="{StaticResource AccentButton}" Content="{Binding AddText}" Command="{Binding AddCommand}" MinWidth="140" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Text="{Binding PickedText, StringFormat=Picked: {0}}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,0,0"
                               Visibility="{Binding PickedText, Converter={StaticResource HasValueToVis}}" />
                </StackPanel>
            </DockPanel>

            <!-- where from -->
            <ItemsControl DockPanel.Dock="Left" Width="196" ItemsSource="{Binding Sources}" Focusable="False" Margin="0,0,18,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dvm:InsertSource}">
                        <RadioButton Style="{StaticResource SideItem}" GroupName="insertSources" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}" b:Ui.Badge="{Binding CountText}"
                                     Command="{Binding DataContext.SelectSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <RadioButton.IsChecked>
                                <MultiBinding Converter="{StaticResource SameObject}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="DataContext.Source" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </RadioButton.IsChecked>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel>
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=120}" b:Ui.Placeholder="Search"
                         b:Ui.FocusOnLoad="True" b:Ui.EscapeCommand="{Binding CancelCommand}" Margin="0,0,0,14" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MoreText}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Visibility="{Binding MoreText, Converter={StaticResource HasValueToVis}}" />
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource InsertCard}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Loading…" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </DockPanel>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
