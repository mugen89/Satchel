<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Satchel.Controls"
                    xmlns:b="clr-namespace:Satchel.Behaviors"
                    xmlns:core="clr-namespace:Satchel.Core"
                    xmlns:dvm="clr-namespace:Satchel.ViewModels.Dialogs">

    <Style x:Key="Label2" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,10,12,0" />
    </Style>

    <!-- ===== Contact editor ===== -->
    <DataTemplate DataType="{x:Type dvm:ContactEditorViewModel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <c:Avatar Image="{Binding Image}" Text="{Binding PreviewName}" ColorKey="{Binding Color}" Size="64" Roundness="-1" Solid="True" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Title}" FontSize="19" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Photo…" b:Ui.Icon="{x:Static core:Glyphs.Picture}" Command="{Binding PickImageCommand}" MinHeight="30" />
                        <Button Content="Paste" Command="{Binding PasteImageCommand}" MinHeight="30" Margin="6,0,0,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Remove" Command="{Binding RemoveImageCommand}" MinHeight="30" Margin="6,0,0,0"
                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource DangerGhostButton}" Content="Delete" b:Ui.Icon="{x:Static core:Glyphs.Delete}" Command="{Binding DeleteCommand}"
                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Padding="10,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Style="{StaticResource AccentButton}" Content="Save" Command="{Binding SaveCommand}" MinWidth="90" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />

            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" Margin="0,14,-12,0" Padding="0,0,12,0">
                <StackPanel>
                    <UniformGrid Columns="2">
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="First name" Margin="0,0,6,10" b:Ui.FocusOnLoad="True" />
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Last name" Margin="6,0,0,10" />
                        <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Company" Margin="0,0,6,10" />
                        <TextBox Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Job title" Margin="6,0,0,10" />
                        <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Nickname" Margin="0,0,6,10" />
                        <c:DateBox SelectedDate="{Binding Birthday}" Placeholder="Birthday" KeepTime="False" Margin="6,0,0,10" />
                    </UniformGrid>

                    <DockPanel Margin="0,8,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add phone" Command="{Binding AddPhoneCommand}" FontSize="12" />
                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" Margin="0" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Phones}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <ComboBox DockPanel.Dock="Left" Width="110" IsEditable="True" ItemsSource="{x:Static dvm:ContactEditorViewModel.PhoneLabels}"
                                              Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" FontSize="9" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemovePhoneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="+359 …" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,8,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add email" Command="{Binding AddEmailCommand}" FontSize="12" />
                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}" Margin="0" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Emails}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <ComboBox DockPanel.Dock="Left" Width="110" IsEditable="True" ItemsSource="{x:Static dvm:ContactEditorViewModel.EmailLabels}"
                                              Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" FontSize="9" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemoveEmailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="name@example.com" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource MultilineTextBox}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MinHeight="56" />
                    <TextBlock Text="Website" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="https://" />
                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource MultilineTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="64" />
                    <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="family, work, school…" />
                    <TextBlock Text="Color" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Favorite" IsChecked="{Binding IsFavorite}" VerticalAlignment="Top" />
                        <c:ColorSwatches SelectedKey="{Binding Color}" SwatchSize="20" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===== Change password ===== -->
    <DataTemplate DataType="{x:Type dvm:ChangePasswordDialogViewModel}">
        <StackPanel>
            <TextBlock Text="Change master password" Style="{StaticResource Title}" FontSize="19" />
            <TextBlock Text="Your data stays encrypted — only the key that unlocks it is re-wrapped. Your recovery key keeps working." Style="{StaticResource Muted}"
                       TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBlock Text="Current password" Style="{StaticResource FieldLabel}" />
            <c:PasswordInput Password="{Binding Current}" b:Ui.FocusOnLoad="True" />
            <TextBlock Text="New password" Style="{StaticResource FieldLabel}" />
            <c:PasswordInput Password="{Binding NewPassword}" />
            <c:StrengthMeter Password="{Binding NewPassword}" Margin="0,8,0,0" />
            <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}" />
            <c:PasswordInput Password="{Binding Confirm}" b:Ui.EnterCommand="{Binding SaveCommand}" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                <Button Command="{Binding SaveCommand}" MinWidth="120" Margin="10,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                            <Setter Property="Content" Value="Change password" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Content" Value="Working…" />
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===== New recovery key ===== -->
    <DataTemplate DataType="{x:Type dvm:RecoveryKeyDialogViewModel}">
        <StackPanel>
            <TextBlock Text="New recovery key" Style="{StaticResource Title}" FontSize="19" />
            <StackPanel Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Text="A new key replaces the old one — the old key will stop working. Confirm with your master password." Style="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <TextBlock Text="Master password" Style="{StaticResource FieldLabel}" />
                <c:PasswordInput Password="{Binding Password}" b:Ui.FocusOnLoad="True" b:Ui.EnterCommand="{Binding GenerateCommand}" />
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Style="{StaticResource AccentButton}" Content="Generate new key" Command="{Binding GenerateCommand}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Write this down or save it somewhere safe — away from this drive." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="{DynamicResource RadiusSmall}"
                        Padding="12,16" Margin="0,16,0,0">
                    <TextBox Text="{Binding RecoveryKey, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InlineTextBox}" FontFamily="{StaticResource MonoFont}"
                             FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Copy" b:Ui.Icon="{x:Static core:Glyphs.Copy}" Command="{Binding CopyCommand}" />
                    <Button Content="Save to file…" b:Ui.Icon="{x:Static core:Glyphs.Save}" Command="{Binding SaveToFileCommand}" Margin="10,0,0,0" />
                    <Button Style="{StaticResource AccentButton}" Content="Done" Command="{Binding DoneCommand}" MinWidth="90" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
