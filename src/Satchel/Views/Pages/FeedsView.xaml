<UserControl x:Class="Satchel.Views.Pages.FeedsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Feeds ===== -->
        <Border Style="{StaticResource SidePanel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Feeds" Style="{StaticResource PageTitle}" Margin="6,4,0,12" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="Follow a site" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding SubscribeCommand}" HorizontalAlignment="Stretch"
                            ToolTip="Blogs, news sites, podcasts (Ctrl+N)" />
                    <DockPanel Margin="4,8,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Refresh}" Command="{Binding RefreshAllCommand}" ToolTip="Check all feeds now" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" ToolTip="Import / export">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Import OPML…" Icon="{x:Static core:Glyphs.Import}" Command="{Binding ImportOpmlCommand}" />
                                    <MenuItem Header="Export OPML…" Icon="{x:Static core:Glyphs.Export}" Command="{Binding ExportOpmlCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Spinner Width="14" Height="14" Margin="0,0,8,0" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Checked while Satchel is open" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding MainFilters}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SideFilter}">
                                    <RadioButton Style="{StaticResource SideItem}" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}" b:Ui.Badge="{Binding Badge}" GroupName="ff"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Following" Style="{StaticResource SectionLabel}" Visibility="{Binding HasFeeds, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Feeds}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Feed}">
                                    <Grid>
                                    <Border x:Name="sel" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource AccentSubtleBrush}" Opacity="0" />
                                    <Button Style="{StaticResource RowButton}" Padding="8,6"
                                            Command="{Binding DataContext.SelectFeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Notifications on/off" Icon="{x:Static core:Glyphs.Bell}"
                                                          Command="{Binding PlacementTarget.DataContext.ToggleNotifyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="{Binding IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}" Icon="{x:Static core:Glyphs.Hide}"
                                                          Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Unfollow" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                                                          Command="{Binding PlacementTarget.DataContext.UnsubscribeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <DockPanel>
                                            <c:Avatar Image="{Binding Image}" Text="{Binding Title}" ColorKey="{Binding Color}" Size="24" Roundness="6" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UnreadCount, Converter={StaticResource CountBadge}}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.Music}" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="4,0"
                                                       Foreground="{DynamicResource TextFaintBrush}" Visibility="{Binding IsPodcast, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Title}" Margin="10,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource SameObject}">
                                                    <Binding />
                                                    <Binding Path="DataContext.SelectedFeed" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="sel" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Items ===== -->
        <DockPanel Grid.Column="1" Margin="20,0,16,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Mark all read" b:Ui.Icon="{x:Static core:Glyphs.CheckboxChecked}" Command="{Binding MarkAllReadCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource Title}" FontSize="20" VerticalAlignment="Center" />
            </DockPanel>
            <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" b:Ui.Placeholder="Search posts"
                     b:Ui.EscapeCommand="{Binding ClearSearchCommand}" MinHeight="32" Margin="0,0,0,10" />
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,16">
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:FeedItem}">
                                <Grid>
                                    <Border x:Name="sel" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource AccentSubtleBrush}" Opacity="0" />
                                    <Button Style="{StaticResource RowButton}" Padding="10,9" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,6,10,0"
                                                     Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}" />
                                            <Border DockPanel.Dock="Left" Width="7" Margin="0,0,10,0" Visibility="{Binding IsRead, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PublishedAt, Converter={StaticResource DateFormat}, ConverterParameter=relative}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.StarFilled}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource WarningBrush}"
                                                               Margin="6,2,0,0" Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding FeedTitle}" Style="{StaticResource Caption}" Foreground="{Binding FeedColor, Converter={StaticResource PaletteBrush}}" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <TextBlock x:Name="title" Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                <DockPanel Margin="0,3,0,0">
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource Pill}" Padding="7,1" Margin="0,0,8,0" Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource AccentTextBrush}"><Run Text="{x:Static core:Glyphs.Play}" FontFamily="{StaticResource IconFont}" FontSize="9" /><Run Text=" " /><Run Text="{Binding DurationText, Mode=OneWay}" /></TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                        <Setter TargetName="title" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                        <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource SameObject}">
                                                <Binding />
                                                <Binding Path="DataContext.Selected" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="sel" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" b:Motion.Enter="True">
                    <Border Style="{StaticResource EmptyIcon}">
                        <TextBlock Text="{x:Static core:Glyphs.Feed}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <TextBlock Text="All caught up" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="Follow blogs, news and podcasts — new posts arrive here." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ===== Reader ===== -->
        <Border Grid.Column="2" Width="460" Style="{StaticResource DetailPanel}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,14,14,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonSmall}" ToolTip="Star" Command="{Binding ToggleStarCommand}"
                                Content="{Binding Selected.IsStarred, Converter={StaticResource BoolToString}, ConverterParameter=&#xE735;|&#xE734;}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Bookmark}" ToolTip="Save to Bookmarks (read later)" Command="{Binding SaveToBookmarksCommand}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.OpenExternal}" ToolTip="Open in the browser" Command="{Binding OpenInBrowserCommand}" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CloseReaderCommand}" ToolTip="Close" />
                    </StackPanel>
                    <TextBlock Text="{Binding Selected.FeedTitle}" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,4,20,24">
                        <TextBlock Text="{Binding Selected.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,14"><Run Text="{Binding Selected.Author, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Selected.PublishedAt, Mode=OneWay, Converter={StaticResource DateFormat}, ConverterParameter=datetime}" /></TextBlock>
                        <Button Style="{StaticResource AccentButton}" Content="Play episode" b:Ui.Icon="{x:Static core:Glyphs.Play}" Command="{Binding PlayEpisodeCommand}" HorizontalAlignment="Left"
                                Margin="0,0,0,14" Visibility="{Binding Selected.IsAudio, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ReaderText}" FontFamily="Georgia, Cambria" FontSize="15.5" LineHeight="25" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                        <Button Style="{StaticResource LinkButton}" Content="Read the full article →" Command="{Binding OpenInBrowserCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Podcast player ===== -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="20,10"
                Visibility="{Binding Podcast.HasEpisode, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xED3C;" ToolTip="Back 15 s" Command="{Binding Podcast.SkipCommand}" CommandParameter="-15" />
                    <Button Style="{StaticResource AccentButton}" Width="42" Height="42" MinHeight="0" Padding="0" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="4,0"
                            Command="{Binding Podcast.TogglePlayCommand}" Content="{Binding Podcast.IsPlaying, Converter={StaticResource BoolToString}, ConverterParameter=&#xE769;|&#xE768;}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xED3D;" ToolTip="Forward 30 s" Command="{Binding Podcast.SkipCommand}" CommandParameter="30" />
                    <Button Style="{StaticResource GhostButton}" Content="{Binding Podcast.SpeedText}" Command="{Binding Podcast.CycleSpeedCommand}" ToolTip="Playback speed" MinWidth="52" Margin="4,0,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding Podcast.StopCommand}" ToolTip="Stop" VerticalAlignment="Center" />
                <StackPanel Margin="16,0" VerticalAlignment="Center">
                    <DockPanel>
                        <c:Spinner DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" Visibility="{Binding Podcast.IsLoading, Converter={StaticResource BoolToVis}}" />
                        <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Podcast.Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Podcast.FeedTitle, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" /></TextBlock>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Podcast.PositionText}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="0,0,10,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Podcast.DurationText}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="10,0,0,0" />
                        <Grid x:Name="SeekBar" Height="14" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnSeek">
                            <Border x:Name="SeekTrack" Height="4" CornerRadius="2" Background="{DynamicResource SegmentBrush}" VerticalAlignment="Center" />
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressWidth}">
                                        <Binding Path="Podcast.Progress" />
                                        <Binding Path="ActualWidth" ElementName="SeekTrack" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
