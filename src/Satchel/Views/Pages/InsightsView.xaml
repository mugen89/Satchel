<UserControl x:Class="Satchel.Views.Pages.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="ChartTitle" TargetType="TextBlock" BasedOn="{StaticResource Subtitle}" />
        <Style x:Key="ChartNote" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,2,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,0,28,28">
            <DockPanel Margin="0,4,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Refresh}" Command="{Binding RefreshCommand}" ToolTip="Refresh" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="Insights" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="What you've been up to — worked out from everything in Satchel. Private items are only counted while they're shown." Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>

            <!-- headline numbers -->
            <ItemsControl ItemsSource="{Binding Stats}" Focusable="False" Margin="0,0,-12,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:InsightStat}">
                        <Button Style="{StaticResource CardButton}" Padding="14,12" Margin="0,0,12,12" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.OpenStatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentTextBrush}" />
                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- activity -->
            <Border Style="{StaticResource ChartCard}">
                <StackPanel>
                    <TextBlock Text="Activity" Style="{StaticResource ChartTitle}" />
                    <TextBlock Text="{Binding ActivityText}" Style="{StaticResource ChartNote}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <c:ActivityGrid x:Name="ActivityChart" Days="{Binding Activity}" HorizontalAlignment="Left" />
                    </ScrollViewer>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Click a day to see its auto-diary." Style="{StaticResource Caption}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource ChartCard}">
                        <StackPanel>
                            <TextBlock Text="Tasks done per week" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="Last 12 weeks" Style="{StaticResource ChartNote}" />
                            <c:ColumnChart Points="{Binding TasksWeekly}" Unit="tasks" Height="170" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChartCard}">
                        <StackPanel>
                            <TextBlock Text="Hours played per month" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="From your game sessions" Style="{StaticResource ChartNote}" />
                            <c:ColumnChart Points="{Binding HoursMonthly}" Unit="h" Height="170" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChartCard}">
                        <StackPanel>
                            <TextBlock Text="Mood" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="{Binding MoodText}" Style="{StaticResource ChartNote}" Visibility="{Binding HasMood, Converter={StaticResource BoolToVis}}" />
                            <c:LineChart Points="{Binding Mood}" MinValue="1" MaxValue="5" Missing="-1" Height="160" Visibility="{Binding HasMood, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Pick a mood on the Today page (or in a journal entry) and it shows up here." Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None"
                                       Visibility="{Binding HasMood, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource ChartCard}">
                        <StackPanel>
                            <TextBlock Text="Pages read per week" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="From your reading sessions" Style="{StaticResource ChartNote}" />
                            <c:ColumnChart Points="{Binding PagesWeekly}" Unit="pages" Height="170" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChartCard}">
                        <StackPanel>
                            <TextBlock Text="Watched per week" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="Videos, episodes and movies" Style="{StaticResource ChartNote}" />
                            <c:ColumnChart Points="{Binding WatchedWeekly}" Unit="watched" Height="170" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChartCard}">
                        <StackPanel>
                            <TextBlock Text="Flashcards studied" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="{Binding ReviewText}" Style="{StaticResource ChartNote}" Visibility="{Binding HasReviews, Converter={StaticResource BoolToVis}}" />
                            <c:ColumnChart Points="{Binding Reviews}" Unit="answers" Height="160" Visibility="{Binding HasReviews, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Study a deck in Flashcards and your daily reviews appear here." Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None"
                                       Visibility="{Binding HasReviews, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
