<UserControl x:Class="Satchel.Views.Pages.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <ContextMenu x:Key="TaskMenu" x:Shared="False">
            <MenuItem Header="Open" Icon="{x:Static core:Glyphs.Edit}"
                      Command="{Binding PlacementTarget.Tag.SelectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Mark done / not done" Icon="{x:Static core:Glyphs.Check}"
                      Command="{Binding PlacementTarget.Tag.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Due" Icon="{x:Static core:Glyphs.Calendar}">
                <MenuItem Header="Today" Tag="0" Click="OnDueClick" />
                <MenuItem Header="Tomorrow" Tag="1" Click="OnDueClick" />
                <MenuItem Header="Next week" Tag="7" Click="OnDueClick" />
                <Separator />
                <MenuItem Header="No date" Tag="-1" Click="OnDueClick" />
            </MenuItem>
            <MenuItem Header="Priority" Icon="{x:Static core:Glyphs.Flag}" ItemsSource="{x:Static vm:TaskDetailViewModel.Priorities}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}" />
                        <EventSetter Event="Click" Handler="OnPriorityClick" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Move to list" Icon="{x:Static core:Glyphs.List}"
                      ItemsSource="{Binding PlacementTarget.Tag.ListChoices, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <EventSetter Event="Click" Handler="OnMoveClick" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="{Binding IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}" Icon="{x:Static core:Glyphs.Hide}"
                      Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Delete" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                      Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>

        <ContextMenu x:Key="ListMenu" x:Shared="False">
            <MenuItem Header="Rename…" Icon="{x:Static core:Glyphs.Edit}"
                      Command="{Binding PlacementTarget.Tag.RenameListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Color" Icon="{x:Static core:Glyphs.Palette}" ItemsSource="{x:Static core:Palettes.Tags}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{Binding Key, Converter={StaticResource PaletteBrush}}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="Click" Handler="OnListColorClick" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="{Binding IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark list private'}" Icon="{x:Static core:Glyphs.Hide}"
                      Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Delete list" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                      Command="{Binding PlacementTarget.Tag.DeleteListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>

        <!-- Small chip -->
        <Style x:Key="TaskChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>

        <!-- ===== Row (list view) ===== -->
        <DataTemplate x:Key="TaskRow" DataType="{x:Type m:TaskItem}">
            <Button x:Name="row" Style="{StaticResource CardButton}" Padding="10,9,12,9" Margin="0,0,0,6"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource TaskMenu}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource RoundCheck}" IsChecked="{Binding IsDone, Mode=OneWay}" VerticalAlignment="Center" Margin="4,0,0,0"
                              BorderBrush="{Binding Priority, Converter={StaticResource PriorityBrush}}" b:DnD.NoDrag="True"
                              Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource TaskChip}" Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static core:Glyphs.Checklist}" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SubtaskText}" FontSize="11.5" Margin="5,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="due" Style="{StaticResource TaskChip}" Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="dueIcon" Text="{x:Static core:Glyphs.Calendar}" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="dueText" Text="{Binding DueText}" FontSize="11.5" Margin="5,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{x:Static core:Glyphs.Repeat}" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" ToolTip="{Binding RepeatText}" Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TaskChip}" Visibility="{Binding DataContext.IsSmartView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding ListColor, Converter={StaticResource PaletteBrush}}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ListName}" FontSize="11.5" Margin="5,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Static core:Glyphs.Flag}" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="10,0,2,0" VerticalAlignment="Center"
                                   Foreground="{Binding Priority, Converter={StaticResource PriorityBrush}}" ToolTip="{Binding PriorityName}"
                                   Visibility="{Binding HasPriority, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14" />
                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}" MaxHeight="17" Margin="0,1,0,0"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="due" Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                    <Setter TargetName="dueText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter TargetName="dueIcon" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                    <Setter TargetName="dueText" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    <Setter TargetName="dueIcon" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Card (board view) ===== -->
        <DataTemplate x:Key="TaskCard" DataType="{x:Type m:TaskItem}">
            <Button Style="{StaticResource CardButton}" Padding="12,10" Margin="0,0,0,8"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource TaskMenu}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.Flag}" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="8,2,0,0"
                                   Foreground="{Binding Priority, Converter={StaticResource PriorityBrush}}" VerticalAlignment="Top"
                                   Visibility="{Binding HasPriority, Converter={StaticResource BoolToVis}}" />
                        <TextBlock x:Name="title" Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxHeight="34" Margin="0,4,0,0"
                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                    <WrapPanel Margin="-6,8,0,0">
                        <Border x:Name="due" Style="{StaticResource TaskChip}" Margin="6,0,0,4" Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="dueText" Text="{Binding DueText}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{x:Static core:Glyphs.Repeat}" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" ToolTip="{Binding RepeatText}" Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TaskChip}" Margin="6,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding ListColor, Converter={StaticResource PaletteBrush}}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ListName}" FontSize="11.5" Margin="5,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TaskChip}" Margin="6,0,0,4" Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SubtaskText}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                    </WrapPanel>
                    <ProgressBar Value="{Binding SubtaskProgress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,0,0"
                                 Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="due" Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                    <Setter TargetName="dueText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="StackPanelAnimated">
            <c:AnimatedStackPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="SmartFilterItem" DataType="{x:Type vm:SideFilter}">
            <RadioButton Style="{StaticResource SideItem}" GroupName="taskFilter" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}" b:Ui.IconBrush="{Binding IconBrush}"
                         b:Ui.Badge="{Binding Badge}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                         b:DnD.Group="tasks" b:DnD.DropCommand="{Binding DataContext.DropOnListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </DataTemplate>

        <!-- Board column -->
        <Style x:Key="BoardColumn" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
            <Setter Property="Padding" Value="10,12,10,4" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="{Binding HasDetail, Converter={StaticResource BoolToGridLength}, ConverterParameter=400|0}" />
        </Grid.ColumnDefinitions>

        <!-- ===== Side panel ===== -->
        <Border Style="{StaticResource SidePanel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Tasks" Style="{StaticResource PageTitle}" Margin="10,4,0,16" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding SmartFilters}" ItemTemplate="{StaticResource SmartFilterItem}" Focusable="False" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Add}" FontSize="11"
                                    Command="{Binding NewListCommand}" ToolTip="New list" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                            <TextBlock Text="Lists" Style="{StaticResource SectionLabel}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ListFilters}" Focusable="False"
                                      b:DnD.IsReorderable="True" b:DnD.Group="tasklists" b:DnD.Mode="Vertical" b:DnD.ReorderCommand="{Binding ReorderListsCommand}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:AnimatedStackPanel Entrance="False" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton x:Name="item" Style="{StaticResource SideItem}" GroupName="taskFilter" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}"
                                                 b:Ui.IconBrush="{Binding IconBrush}" b:Ui.Badge="{Binding Badge}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                 b:DnD.Group="tasks" b:DnD.DropCommand="{Binding DataContext.DropOnListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource ListMenu}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Key}" Value="inbox">
                                            <Setter TargetName="item" Property="ContextMenu" Value="{x:Null}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Main ===== -->
        <Grid Grid.Column="1" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" x:Name="SearchBox"
                             b:Ui.Placeholder="Search tasks" Width="180" MinHeight="34" Margin="0,0,10,0" b:Ui.EscapeCommand="{Binding ClearSearchCommand}" />
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" b:Ui.Icon="{x:Static core:Glyphs.List}" IsChecked="{Binding IsBoardView, Converter={StaticResource Not}}" ToolTip="List" Padding="10,0" />
                            <RadioButton Style="{StaticResource Segment}" b:Ui.Icon="{x:Static core:Glyphs.Grid}" IsChecked="{Binding IsBoardView}" ToolTip="Board" Padding="10,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource Title}" FontSize="22" />
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Quick add -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <Border x:Name="QuickAddBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius}" Padding="14,0" MinHeight="48">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static core:Glyphs.Add}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource OnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleAccentButton}" Content="Add" MinHeight="30" Command="{Binding QuickAddCommand}" />
                        <TextBox x:Name="QuickAddBox" Style="{StaticResource InlineTextBox}" Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                                 b:Ui.Placeholder="{Binding QuickAddHint}" b:Ui.EnterCommand="{Binding QuickAddCommand}" FontSize="14.5" Margin="12,0,10,0"
                                 VerticalAlignment="Center" GotKeyboardFocus="OnQuickAddFocus" LostKeyboardFocus="OnQuickAddFocus" />
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding QuickAddPreview}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentTextBrush}" Margin="16,6,0,0"
                           Visibility="{Binding QuickAddPreview, Converter={StaticResource HasValueToVis}}" />
            </StackPanel>

            <!-- List view -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0"
                          Visibility="{Binding IsBoardView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel Margin="0,0,0,24">
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TaskGroup}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="header" Text="{Binding Title}" Style="{StaticResource Overline}" Margin="2,6,0,8"
                                               Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TaskRow}" Focusable="False"
                                                  ItemsPanel="{StaticResource StackPanelAnimated}"
                                                  b:DnD.IsReorderable="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  b:DnD.Group="tasks" b:DnD.Mode="Vertical"
                                                  b:DnD.ReorderCommand="{Binding DataContext.ReorderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter TargetName="header" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding ShowCompletedSection, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Clear completed" Command="{Binding ClearCompletedCommand}" FontSize="12"
                                    VerticalAlignment="Center" Visibility="{Binding ShowCompleted, Converter={StaticResource BoolToVis}}" />
                            <ToggleButton IsChecked="{Binding ShowCompleted}" Cursor="Hand" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <TextBlock x:Name="chev" Text="{x:Static core:Glyphs.ChevronRight}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform x:Name="rot" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CompletedHeader}" Style="{StaticResource Overline}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="chev" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding CompletedTasks}" ItemTemplate="{StaticResource TaskRow}" Focusable="False" Margin="0,10,0,0"
                                      ItemsPanel="{StaticResource StackPanelAnimated}" Visibility="{Binding ShowCompleted, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Margin="0,70,0,0" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource EmptyIcon}">
                            <TextBlock Text="{x:Static core:Glyphs.Completed}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Board view -->
            <Grid Grid.Row="2" Margin="0,0,-12,20" Visibility="{Binding IsBoardView, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource BoardColumn}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,12">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="To do" FontWeight="SemiBold" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding TodoColumn.Count}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                            <ItemsControl ItemsSource="{Binding TodoColumn}" ItemTemplate="{StaticResource TaskCard}" ItemsPanel="{StaticResource StackPanelAnimated}"
                                          MinHeight="200" Background="Transparent" Focusable="False"
                                          b:DnD.IsReorderable="True" b:DnD.Group="board" b:DnD.Mode="Vertical" b:DnD.ListTag="Todo" b:DnD.ReorderCommand="{Binding ReorderCommand}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource BoardColumn}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,12">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="In progress" FontWeight="SemiBold" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding ProgressColumn.Count}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                            <ItemsControl ItemsSource="{Binding ProgressColumn}" ItemTemplate="{StaticResource TaskCard}" ItemsPanel="{StaticResource StackPanelAnimated}"
                                          MinHeight="200" Background="Transparent" Focusable="False"
                                          b:DnD.IsReorderable="True" b:DnD.Group="board" b:DnD.Mode="Vertical" b:DnD.ListTag="InProgress" b:DnD.ReorderCommand="{Binding ReorderCommand}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource BoardColumn}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,12">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Done" FontWeight="SemiBold" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding DoneColumn.Count}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                            <ItemsControl ItemsSource="{Binding DoneColumn}" ItemTemplate="{StaticResource TaskCard}" ItemsPanel="{StaticResource StackPanelAnimated}"
                                          MinHeight="200" Background="Transparent" Focusable="False"
                                          b:DnD.IsReorderable="True" b:DnD.Group="board" b:DnD.Mode="Vertical" b:DnD.ListTag="Done" b:DnD.ReorderCommand="{Binding ReorderCommand}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Detail ===== -->
        <Border x:Name="DetailPanel" Grid.Column="2" Style="{StaticResource DetailPanel}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
            <ContentControl Content="{Binding Detail}" Focusable="False" />
        </Border>
    </Grid>
</UserControl>
