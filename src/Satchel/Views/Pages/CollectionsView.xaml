<UserControl x:Class="Satchel.Views.Pages.CollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <!-- field editors, picked by type -->
        <DataTemplate x:Key="FieldText" DataType="{x:Type vm:FieldValue}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" MinHeight="32" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldLong" DataType="{x:Type vm:FieldValue}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource MultilineTextBox}" MinHeight="70" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldCheck" DataType="{x:Type vm:FieldValue}">
            <DockPanel Margin="0,14,0,0">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldRating" DataType="{x:Type vm:FieldValue}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal" Margin="-4,0,0,0">
                    <Button Style="{StaticResource IconButtonSmall}" FontSize="16" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=1}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=1}" Command="{Binding SetRatingCommand}" CommandParameter="1" />
                    <Button Style="{StaticResource IconButtonSmall}" FontSize="16" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=2}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=2}" Command="{Binding SetRatingCommand}" CommandParameter="2" />
                    <Button Style="{StaticResource IconButtonSmall}" FontSize="16" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=3}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=3}" Command="{Binding SetRatingCommand}" CommandParameter="3" />
                    <Button Style="{StaticResource IconButtonSmall}" FontSize="16" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=4}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=4}" Command="{Binding SetRatingCommand}" CommandParameter="4" />
                    <Button Style="{StaticResource IconButtonSmall}" FontSize="16" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=5}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=5}" Command="{Binding SetRatingCommand}" CommandParameter="5" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldDate" DataType="{x:Type vm:FieldValue}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" />
                <c:DateBox SelectedDate="{Binding DateValue}" Placeholder="—" AllowClear="True" KeepTime="False" MinHeight="32" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldChoice" DataType="{x:Type vm:FieldValue}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" />
                <ComboBox IsEditable="True" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding Options}" MinHeight="32" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldUrl" DataType="{x:Type vm:FieldValue}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.OpenExternal}" Command="{Binding OpenUrlCommand}" Margin="6,0,0,0" ToolTip="Open" />
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" MinHeight="32" b:Ui.Placeholder="https://…" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>
        <vm:FieldTemplateSelector x:Key="FieldSelector" Text="{StaticResource FieldText}" LongText="{StaticResource FieldLong}" Check="{StaticResource FieldCheck}"
                                  Rating="{StaticResource FieldRating}" Date="{StaticResource FieldDate}" Choice="{StaticResource FieldChoice}" Url="{StaticResource FieldUrl}" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ===== Collections ===== -->
        <Border Style="{StaticResource SidePanel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Collections" Style="{StaticResource PageTitle}" Margin="6,4,0,12" />
                <Button DockPanel.Dock="Bottom" Content="New collection" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding NewTrackerCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding Trackers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Tracker}">
                                <RadioButton Style="{StaticResource SideItem}" Content="{Binding Name}" b:Ui.Icon="{Binding Icon}" GroupName="trackers"
                                             b:Ui.IconBrush="{Binding Color, Converter={StaticResource PaletteBrush}}" b:Ui.Badge="{Binding ItemCount, Converter={StaticResource CountBadge}}"
                                             Command="{Binding DataContext.SelectTrackerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource SameObject}" Mode="OneWay">
                                            <Binding />
                                            <Binding Path="DataContext.SelectedTracker" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Items ===== -->
        <DockPanel Grid.Column="1" Margin="24,0,24,0" Visibility="{Binding HasTracker, Converter={StaticResource BoolToVis}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" b:Ui.Icon="{x:Static core:Glyphs.Grid}" ToolTip="Cards" IsChecked="{Binding IsGrid, Mode=OneWay}" Command="{Binding ToggleViewCommand}" Padding="10,0" />
                            <RadioButton Style="{StaticResource Segment}" b:Ui.Icon="{x:Static core:Glyphs.List}" ToolTip="Table" IsChecked="{Binding IsTable, Mode=OneWay}" Command="{Binding ToggleViewCommand}" Padding="10,0" />
                        </StackPanel>
                    </Border>
                    <Button Content="Fields" b:Ui.Icon="{x:Static core:Glyphs.Sliders}" Command="{Binding EditFieldsCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Content="Add" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddItemCommand}" ToolTip="Add an item (Ctrl+N)" />
                    <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" Margin="6,0,0,0">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename collection…" Icon="{x:Static core:Glyphs.Edit}" Command="{Binding RenameTrackerCommand}" />
                                <MenuItem Header="{Binding SelectedTracker.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}"
                                          Icon="{x:Static core:Glyphs.Hide}" Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding SelectedTracker}" />
                                <Separator />
                                <MenuItem Header="Delete collection" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteTrackerCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedTracker.Name}" Style="{StaticResource Title}" FontSize="22" />
                    <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Items.Count, Mode=OneWay}" /><Run Text=" items" /></TextBlock>
                </StackPanel>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" b:Ui.Placeholder="Search"
                         b:Ui.EscapeCommand="{Binding ClearSearchCommand}" Width="240" MinHeight="32" Margin="0,0,12,0" VerticalAlignment="Top" />
                <ItemsControl ItemsSource="{Binding SelectedTracker.Fields}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:FieldDef}">
                            <RadioButton Style="{StaticResource ChipRadio}" Content="{Binding Name}" GroupName="sortby" Margin="0,0,6,4" ToolTip="Sort by this field"
                                         Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource AllEqual}" Mode="OneWay">
                                        <Binding Path="Id" />
                                        <Binding Path="DataContext.SortField" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <Grid>
                <!-- cards -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,24" Visibility="{Binding IsGrid, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:MasonryPanel MinColumnWidth="210" Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:TrackerItem}">
                                <Button Style="{StaticResource CardButton}" Padding="0" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Border Height="140" CornerRadius="10,10,0,0" ClipToBounds="True" Background="{DynamicResource SegmentBrush}"
                                                Visibility="{Binding Image, Converter={StaticResource HasValueToVis}}">
                                            <Image Source="{Binding Image, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Margin="14,10,14,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.StarFilled}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource WarningBrush}"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" Margin="6,2,0,0" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding CardText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding CardText, Converter={StaticResource HasValueToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- table -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,24"
                              Visibility="{Binding IsTable, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Columns}" Focusable="False" Margin="10,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Width="170" Style="{StaticResource Overline}" Margin="0,0,10,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TableRow}">
                                    <Button Style="{StaticResource RowButton}" Padding="10,7" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Item.Title}" Width="170" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                            <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Width="170" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nothing here yet." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource SubtleAccentButton}" Content="Add the first one" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddItemCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasTrackers, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" b:Motion.Enter="True">
            <Border Style="{StaticResource EmptyIcon}">
                <TextBlock Text="{x:Static core:Glyphs.Grid9}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
            </Border>
            <TextBlock Text="Track anything" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
            <TextBlock Text="Wines, plants, records, recipes, things you lent — with the fields you choose." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            <Button Style="{StaticResource AccentButton}" Content="New collection" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding NewTrackerCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>

        <!-- ===== Item ===== -->
        <Border Grid.Column="2" Width="370" Style="{StaticResource DetailPanel}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,14,14,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" ToolTip="More">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Choose picture…" Icon="{x:Static core:Glyphs.Picture}" Command="{Binding PickImageCommand}" />
                                    <MenuItem Header="Paste picture" Icon="{x:Static core:Glyphs.Copy}" Command="{Binding PasteImageCommand}" />
                                    <MenuItem Header="Remove picture" Icon="{x:Static core:Glyphs.Close}" Command="{Binding RemoveImageCommand}" />
                                    <MenuItem Header="Duplicate" Icon="{x:Static core:Glyphs.Copy}" Command="{Binding DuplicateItemCommand}" />
                                    <MenuItem Header="{Binding Selected.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}"
                                              Icon="{x:Static core:Glyphs.Hide}" Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding Selected}" />
                                    <Separator />
                                    <MenuItem Header="Delete" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteItemCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CloseDetailCommand}" ToolTip="Close" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedTracker.Name}" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,10,20,24">
                        <Border Height="180" CornerRadius="{DynamicResource Radius}" ClipToBounds="True" Background="{DynamicResource SegmentBrush}" Margin="0,0,0,12"
                                Visibility="{Binding Selected.Image, Converter={StaticResource HasValueToVis}}">
                            <Image Source="{Binding Selected.Image, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                        </Border>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolToggle}" Width="32" Height="32" Content="{x:Static core:Glyphs.Star}"
                                          IsChecked="{Binding Selected.IsFavorite}" ToolTip="Favorite" />
                            <TextBox Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineTextBox}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>
                        <Button Style="{StaticResource GhostButton}" Content="Add a picture" b:Ui.Icon="{x:Static core:Glyphs.Picture}" Command="{Binding PickImageCommand}" HorizontalAlignment="Left"
                                Margin="-6,4,0,0" Visibility="{Binding Selected.Image, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Fields}" ItemTemplateSelector="{StaticResource FieldSelector}" Focusable="False" />
                        <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Selected.Tags, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="comma, separated" MinHeight="32" />
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Selected.Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="70" />
                        <Button Style="{StaticResource GhostButton}" Content="Edit fields" b:Ui.Icon="{x:Static core:Glyphs.Sliders}" Command="{Binding EditFieldsCommand}" HorizontalAlignment="Left" Margin="-6,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
