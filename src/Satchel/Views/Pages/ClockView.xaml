<UserControl x:Class="Satchel.Views.Pages.ClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels"
             xmlns:m="clr-namespace:Satchel.Models"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnKeyDown">
    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Subtitle}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,0,28,28">
            <DockPanel Margin="0,4,0,18">
                <TextBlock Text="Clock" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LocalTime}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Light" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding LocalDate}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- ===== left: timers + stopwatch ===== -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="{x:Static core:Glyphs.Timer}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Timers" Style="{StaticResource Subtitle}" VerticalAlignment="Center" />
                                <TextBlock Text="Ctrl+Shift+T from anywhere" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{x:Static vm:ClockViewModel.Presets}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding StringFormat={}{0} min}" Margin="0,0,6,6" MinHeight="30" Padding="12,0"
                                                Command="{Binding DataContext.StartPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Start" b:Ui.Icon="{x:Static core:Glyphs.Play}" Command="{Binding StartCustomCommand}"
                                        Margin="8,0,0,0" />
                                <TextBox Text="{Binding NewTimer, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Custom: 25 Focus, 10m Tea, 1h30 Bread, 90s…"
                                         b:Ui.EnterCommand="{Binding StartCustomCommand}" MinHeight="34" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Timers.Timers}" Focusable="False" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:CountdownTimer}">
                                        <Border x:Name="card" Width="196" Margin="0,0,12,12" Padding="14,14,14,10" CornerRadius="{DynamicResource Radius}" b:Motion.Enter="True"
                                                Background="{DynamicResource SegmentBrush}" BorderBrush="Transparent" BorderThickness="1.5">
                                            <StackPanel>
                                                <Grid Width="128" Height="128" HorizontalAlignment="Center">
                                                    <c:ProgressRing Progress="{Binding Fraction}" Thickness="7" />
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                                <Button Style="{StaticResource RowButton}" Padding="4,3" Margin="0,8,0,0" HorizontalContentAlignment="Center" ToolTip="Rename"
                                                        Command="{Binding DataContext.RenameTimerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                </Button>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                    <Button Style="{StaticResource IconButtonSmall}" ToolTip="Pause / resume"
                                                            Content="{Binding IsRunning, Converter={StaticResource BoolToString}, ConverterParameter=&#xE769;|&#xE768;}"
                                                            Command="{Binding DataContext.Timers.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButtonSmall}" Content="+1" FontFamily="{DynamicResource UiFont}" FontSize="11.5" FontWeight="SemiBold" ToolTip="Add a minute"
                                                            Command="{Binding DataContext.Timers.AddMinuteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Refresh}" ToolTip="Restart"
                                                            Command="{Binding DataContext.Timers.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Delete}" ToolTip="Remove"
                                                            Command="{Binding DataContext.Timers.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <Button x:Name="dismiss" Style="{StaticResource AccentButton}" Content="Stop ringing" Margin="0,8,0,0" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                                        Command="{Binding DataContext.Timers.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsRinging}" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="card" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                <Setter TargetName="card" Property="b:Motion.Wiggle" Value="True" />
                                                <Setter TargetName="dismiss" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No timers running. Pick a preset or type your own." Style="{StaticResource Muted}" Margin="0,14,0,0"
                                       Visibility="{Binding HasTimers, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{x:Static core:Glyphs.Stopwatch}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Stopwatch" Style="{StaticResource Subtitle}" VerticalAlignment="Center" />
                                <TextBlock Text="Space start/stop · L lap · R reset" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding Timers.StopwatchText}" FontFamily="{StaticResource MonoFont}" FontSize="52" FontWeight="Light" HorizontalAlignment="Center" Margin="0,10,0,14" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Command="{Binding Timers.ToggleStopwatchCommand}" MinWidth="120" Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                            <Setter Property="Content" Value="Start" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Timers.StopwatchRunning}" Value="True">
                                                    <Setter Property="Content" Value="Stop" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Lap" Command="{Binding Timers.LapCommand}" MinWidth="90" Margin="0,0,8,0" IsEnabled="{Binding Timers.StopwatchRunning}" />
                                <Button Content="Reset" Command="{Binding Timers.ResetStopwatchCommand}" MinWidth="90" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Timers.Laps}" Focusable="False" Margin="0,16,0,0" Visibility="{Binding HasLaps, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:LapRow}">
                                        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="4,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number, StringFormat=Lap {0}}" Style="{StaticResource Caption}" FontSize="13" />
                                                <TextBlock x:Name="split" Grid.Column="1" Text="{Binding Split}" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Total}" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                <Setter TargetName="split" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWorst}" Value="True">
                                                <Setter TargetName="split" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== right: world clocks + countdowns ===== -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Add}" Command="{Binding AddClockCommand}" ToolTip="Add a clock" />
                                <TextBlock Text="{x:Static core:Glyphs.World}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="World clock" Style="{StaticResource Subtitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding LocalZone}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Clocks}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WorldClockRow}">
                                        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,8">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Rename…" Icon="{x:Static core:Glyphs.Edit}"
                                                              Command="{Binding PlacementTarget.DataContext.RenameClockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Remove" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                                                              Command="{Binding PlacementTarget.DataContext.RemoveClockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Light" VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="sun" Text="{x:Static core:Glyphs.Sun}" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding DayText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding OffsetText, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                                <Grid Height="3" Margin="0,8,0,0">
                                                    <Border CornerRadius="1.5">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#33415A77" Offset="0" />
                                                                <GradientStop Color="#55F5B342" Offset="0.5" />
                                                                <GradientStop Color="#33415A77" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Canvas>
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Canvas.Top="-2">
                                                            <Canvas.Left>
                                                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                                    <Binding Path="DayFraction" />
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                </MultiBinding>
                                                            </Canvas.Left>
                                                        </Ellipse>
                                                    </Canvas>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNight}" Value="True">
                                                <Setter TargetName="sun" Property="Text" Value="{x:Static core:Glyphs.Moon}" />
                                                <Setter TargetName="sun" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource GhostButton}" Content="Add a city" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddClockCommand}" HorizontalAlignment="Left"
                                    Margin="-6,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Add}" Command="{Binding AddCountdownCommand}" ToolTip="New countdown" />
                                <TextBlock Text="{x:Static core:Glyphs.Flag}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Countdowns" Style="{StaticResource Subtitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Countdowns}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:Countdown}">
                                        <Button Style="{StaticResource RowButton}" Padding="8,8" Margin="-8,0" HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.EditCountdownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Margin="0,0,12,0"
                                                        Background="{Binding Color, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Emoji}" FontFamily="{StaticResource EmojiFont}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Static core:Glyphs.Flag}" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{Binding Color, Converter={StaticResource PaletteBrush}}"
                                                                   Visibility="{Binding Emoji, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DaysText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                               Foreground="{Binding Color, Converter={StaticResource PaletteBrush}}" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Count down to trips, birthdays, exams, launches… They can show on the dashboard and on boards." Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" TextTrimming="None" Visibility="{Binding HasCountdowns, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <Button Style="{StaticResource GhostButton}" Content="New countdown" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddCountdownCommand}" HorizontalAlignment="Left"
                                    Margin="-6,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
