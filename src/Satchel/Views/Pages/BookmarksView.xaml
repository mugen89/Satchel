<UserControl x:Class="Satchel.Views.Pages.BookmarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <UserControl.Resources>
        <!-- site icon: the favicon, or the first letter on a coloured tile -->
        <DataTemplate x:Key="SiteIcon" DataType="{x:Type m:Bookmark}">
            <Grid Width="20" Height="20">
                <Border CornerRadius="5" Background="{Binding Color, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}">
                    <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding Color, Converter={StaticResource PaletteBrush}}" />
                </Border>
                <Image Source="{Binding Icon, Converter={StaticResource BytesToImage}}" Visibility="{Binding Icon, Converter={StaticResource HasValueToVis}}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>

        <ContextMenu x:Key="BookmarkMenu" x:Shared="False">
            <MenuItem Header="Open" Icon="{x:Static core:Glyphs.OpenExternal}"
                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Copy link" Icon="{x:Static core:Glyphs.Copy}"
                      Command="{Binding PlacementTarget.Tag.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Favorite" Icon="{x:Static core:Glyphs.Star}"
                      Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Read later" Icon="{x:Static core:Glyphs.Clock}"
                      Command="{Binding PlacementTarget.Tag.ToggleLaterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Move to folder…" Icon="{x:Static core:Glyphs.Folder}"
                      Command="{Binding PlacementTarget.Tag.MoveToFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="{Binding IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}" Icon="{x:Static core:Glyphs.Hide}"
                      Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Delete" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                      Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ===== Side panel ===== -->
        <Border Style="{StaticResource SidePanel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Bookmarks" Style="{StaticResource PageTitle}" Margin="6,4,0,12" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding MainFilters}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SideFilter}">
                                    <RadioButton Style="{StaticResource SideItem}" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}" b:Ui.Badge="{Binding Badge}" GroupName="bmf"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Folders" Style="{StaticResource SectionLabel}" Visibility="{Binding Folders.Count, Converter={StaticResource HasValueToVis}}" />
                        <ItemsControl ItemsSource="{Binding Folders}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SideFilter}">
                                    <RadioButton Style="{StaticResource SideItem}" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}" b:Ui.Badge="{Binding Badge}" GroupName="bmf"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <RadioButton.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename folder…" Icon="{x:Static core:Glyphs.Edit}"
                                                          Command="{Binding PlacementTarget.DataContext.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </RadioButton.ContextMenu>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Main ===== -->
        <DockPanel Grid.Column="1" Margin="24,0,24,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:Spinner Width="18" Height="18" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" b:Ui.Icon="{x:Static core:Glyphs.Grid}" ToolTip="Cards" IsChecked="{Binding IsCards, Mode=OneWay}" Command="{Binding ShowCardsCommand}" Padding="10,0" />
                            <RadioButton Style="{StaticResource Segment}" b:Ui.Icon="{x:Static core:Glyphs.List}" ToolTip="List" IsChecked="{Binding IsList, Mode=OneWay}" Command="{Binding ShowListCommand}" Padding="10,0" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource AccentButton}" Content="Add" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddCommand}" ToolTip="Add a bookmark (Ctrl+N) — or drop a link here" />
                    <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" Margin="6,0,0,0" ToolTip="Import / export">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Import from Chrome" Icon="{x:Static core:Glyphs.Import}" Command="{Binding ImportBrowserCommand}" CommandParameter="chrome" />
                                <MenuItem Header="Import from Edge" Icon="{x:Static core:Glyphs.Import}" Command="{Binding ImportBrowserCommand}" CommandParameter="edge" />
                                <MenuItem Header="Import from Brave" Icon="{x:Static core:Glyphs.Import}" Command="{Binding ImportBrowserCommand}" CommandParameter="brave" />
                                <MenuItem Header="Import a bookmarks file (Firefox, Safari…)…" Icon="{x:Static core:Glyphs.Document}" Command="{Binding ImportFileCommand}" />
                                <Separator />
                                <MenuItem Header="Export as HTML…" Icon="{x:Static core:Glyphs.Export}" Command="{Binding ExportCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <TextBox Style="{StaticResource SearchBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" b:Ui.Placeholder="Search titles, links, notes, tags"
                         b:Ui.EscapeCommand="{Binding ClearSearchCommand}" MinHeight="34" MaxWidth="420" HorizontalAlignment="Left" />
            </DockPanel>

            <Grid>
                <!-- cards -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,24" Visibility="{Binding IsCards, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Visible}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:MasonryPanel MinColumnWidth="240" Spacing="14" Entrance="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Bookmark}">
                                <Button Style="{StaticResource CardButton}" Padding="0" HorizontalContentAlignment="Stretch" ContextMenu="{StaticResource BookmarkMenu}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" MouseDoubleClick="OnCardDoubleClick"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Border Height="120" CornerRadius="10,10,0,0" ClipToBounds="True" Background="{DynamicResource SegmentBrush}"
                                                Visibility="{Binding Image, Converter={StaticResource HasValueToVis}}">
                                            <Image Source="{Binding Image, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Margin="14,12,14,12">
                                            <DockPanel>
                                                <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource SiteIcon}" Margin="0,1,10,0" VerticalAlignment="Top" Focusable="False" />
                                                <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.StarFilled}" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="6,2,0,0"
                                                           Foreground="{DynamicResource WarningBrush}" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxHeight="50" TextTrimming="WordEllipsis" Margin="0,6,0,0"
                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Folder}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Domain}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentTextBrush}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,24" Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Visible}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Bookmark}">
                                <Button Style="{StaticResource RowButton}" Padding="10,8" HorizontalContentAlignment="Stretch" ContextMenu="{StaticResource BookmarkMenu}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" MouseDoubleClick="OnCardDoubleClick"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource SiteIcon}" Margin="0,0,12,0" Focusable="False" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Folder}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.StarFilled}" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding DisplayTitle, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Domain, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" FontSize="12" /></TextBlock>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" b:Motion.Enter="True">
                    <Border Style="{StaticResource EmptyIcon}">
                        <TextBlock Text="{x:Static core:Glyphs.Bookmark}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <TextBlock Text="Your links, all in one place" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="Add a link, drop one here, or bring your browser bookmarks over (⋯ menu)." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource AccentButton}" Content="Add a bookmark" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ===== Detail ===== -->
        <Border Grid.Column="2" Width="360" Style="{StaticResource DetailPanel}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,14,14,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" ToolTip="More">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Refresh preview" Icon="{x:Static core:Glyphs.Refresh}" Command="{Binding RefreshPreviewCommand}" />
                                    <MenuItem Header="Copy link" Icon="{x:Static core:Glyphs.Copy}" Command="{Binding CopyLinkCommand}" CommandParameter="{Binding Selected}" />
                                    <MenuItem Header="{Binding Selected.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}"
                                              Icon="{x:Static core:Glyphs.Hide}" Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding Selected}" />
                                    <Separator />
                                    <MenuItem Header="Delete" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CloseDetailCommand}" ToolTip="Close" />
                    </StackPanel>
                    <TextBlock Text="Bookmark" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,12,20,24" DataContext="{Binding Selected}">
                        <Border CornerRadius="{DynamicResource Radius}" ClipToBounds="True" Background="{DynamicResource SegmentBrush}" Height="170" Margin="0,0,0,14"
                                Visibility="{Binding Image, Converter={StaticResource HasValueToVis}}">
                            <Image Source="{Binding Image, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                        </Border>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineTextBox}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                 b:Ui.Placeholder="Title" />
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=LostFocus}" Style="{StaticResource InlineTextBox}" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"
                                 FontSize="12.5" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Open" b:Ui.Icon="{x:Static core:Glyphs.OpenExternal}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <ToggleButton Style="{StaticResource Chip}" Content="Favorite" b:Ui.Icon="{x:Static core:Glyphs.Star}" IsChecked="{Binding IsFavorite}" Margin="8,0,0,0" MinHeight="34" />
                            <ToggleButton Style="{StaticResource Chip}" Content="Read later" b:Ui.Icon="{x:Static core:Glyphs.Clock}" IsChecked="{Binding IsReadLater}" Margin="6,0,0,0" MinHeight="34" />
                        </StackPanel>
                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="54" b:Ui.Placeholder="What is it?" />
                        <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" />
                        <ComboBox IsEditable="True" Text="{Binding Folder, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding DataContext.FolderNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  MinHeight="32" />
                        <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="comma, separated" />
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="70" b:Ui.Placeholder="Why you saved it…" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0">
                            <Run Text="Added " /><Run Text="{Binding CreatedAt, Mode=OneWay, Converter={StaticResource DateFormat}, ConverterParameter=relative}" /><Run Text=" · opened " /><Run Text="{Binding Visits, Mode=OneWay}" /><Run Text=" times" />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
