<UserControl x:Class="Satchel.Views.Pages.VideosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <Style x:Key="ThumbAction" TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#B3000000" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Side panel (hidden while watching, to give the player room) ===== -->
        <Border Style="{StaticResource SidePanel}" Width="250" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Videos" Style="{StaticResource PageTitle}" Margin="6,4,0,12" />
                <StackPanel DockPanel.Dock="Bottom" Margin="6,8,0,0">
                    <DockPanel Margin="0,0,0,8">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding HideShorts}" />
                        <TextBlock Text="Hide Shorts" VerticalAlignment="Center" Style="{StaticResource Caption}" FontSize="12.5" />
                    </DockPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Refresh}" Command="{Binding RefreshNowCommand}" ToolTip="Check for new videos now" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <StackPanel>
                        <RadioButton Style="{StaticResource SideItem}" Content="New" b:Ui.Icon="{x:Static core:Glyphs.Bell}" b:Ui.Badge="{Binding NewCount, Converter={StaticResource CountBadge}}"
                                     IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=New, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="New" />
                        <RadioButton Style="{StaticResource SideItem}" Content="Watch later" b:Ui.Icon="{x:Static core:Glyphs.Clock}" b:Ui.Badge="{Binding LaterCount, Converter={StaticResource CountBadge}}"
                                     IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Later, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Later" />
                        <RadioButton Style="{StaticResource SideItem}" Content="Saved" b:Ui.Icon="{x:Static core:Glyphs.Bookmark}" b:Ui.Badge="{Binding SavedCount, Converter={StaticResource CountBadge}}"
                                     IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Saved, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="Saved" />
                        <RadioButton Style="{StaticResource SideItem}" Content="Watched" b:Ui.Icon="{x:Static core:Glyphs.History}"
                                     IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=History, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="History" />
                        <RadioButton Style="{StaticResource SideItem}" Content="All videos" b:Ui.Icon="{x:Static core:Glyphs.Video}"
                                     IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=All, Mode=OneWay}" Command="{Binding SelectSectionCommand}" CommandParameter="All" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Add}" Command="{Binding FollowChannelCommand}" ToolTip="Follow a channel"
                                    FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                            <TextBlock Text="Channels" Style="{StaticResource SectionLabel}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Channels}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:VideoChannel}">
                                    <Grid>
                                        <Border x:Name="sel" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource AccentSubtleBrush}" Opacity="0" />
                                        <Button Style="{StaticResource RowButton}" Padding="8,6" Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Notifications on/off" Icon="{x:Static core:Glyphs.Bell}"
                                                              Command="{Binding PlacementTarget.DataContext.ToggleNotifyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="{Binding IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark channel private'}" Icon="{x:Static core:Glyphs.Hide}"
                                                              Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Unfollow" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                                                              Command="{Binding PlacementTarget.DataContext.UnfollowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <DockPanel>
                                                <c:Avatar Image="{Binding Avatar}" Text="{Binding Title}" ColorKey="{Binding Color}" Size="26" Roundness="-1" />
                                                <Border DockPanel.Dock="Right" MinWidth="18" Height="18" CornerRadius="9" Padding="5,0" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                        Visibility="{Binding NewCount, Converter={StaticResource HasValueToVis}}">
                                                    <TextBlock Text="{Binding NewCount}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Margin="10,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource SameObject}">
                                                    <Binding />
                                                    <Binding Path="DataContext.SelectedChannel" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="sel" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource LinkButton}" Content="Follow a channel…" Command="{Binding FollowChannelCommand}" FontSize="12" HorizontalAlignment="Left" Margin="10,6,0,0"
                                Visibility="{Binding HasChannels, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Video grid ===== -->
        <DockPanel Grid.Column="1" Margin="24,0,24,0" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Mark all seen" b:Ui.Icon="{x:Static core:Glyphs.Check}" Command="{Binding MarkAllSeenCommand}" Margin="0,0,8,0"
                            Visibility="{Binding Section, Converter={StaticResource EqualsToVis}, ConverterParameter=New}" />
                    <Button Content="Follow channel" b:Ui.Icon="{x:Static core:Glyphs.AddPerson}" Command="{Binding FollowChannelCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Content="Save a video" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding SaveVideoCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource Title}" FontSize="22" VerticalAlignment="Center" />
            </DockPanel>
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,24">
                    <ItemsControl ItemsSource="{Binding Visible}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Video}">
                                <Grid x:Name="card" Width="272" Margin="0,0,16,20" Background="Transparent">
                                    <Button Style="{StaticResource RowButton}" Padding="0" VerticalContentAlignment="Top"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <Grid Height="153">
                                                <Border CornerRadius="10" Background="#1A1A1A" ClipToBounds="True">
                                                    <Image x:Name="thumb" Source="{Binding Thumbnail, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                                                </Border>
                                                <Border x:Name="newBadge" Background="{DynamicResource AccentBrush}" CornerRadius="5" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                        Visibility="{Binding IsUnseen, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" />
                                                </Border>
                                                <Border Background="#CC000000" CornerRadius="5" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                                        Visibility="{Binding IsShort, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="SHORT" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                                <Border x:Name="watched" CornerRadius="10" Background="#99000000" Visibility="{Binding IsWatched, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{x:Static core:Glyphs.Completed}" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Height="3" VerticalAlignment="Bottom" Margin="6,0,6,1" Background="#E53935" HorizontalAlignment="Left"
                                                        Visibility="{Binding WatchProgress, Converter={StaticResource HasValueToVis}}">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                            <Binding Path="WatchProgress" />
                                                            <Binding Path="ActualWidth" ElementName="card" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="2,3,2,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Author, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PublishedAt, Mode=OneWay, Converter={StaticResource DateFormat}, ConverterParameter=relative}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel x:Name="actions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,4,0" Opacity="0">
                                        <Button Style="{StaticResource ThumbAction}" Content="{x:Static core:Glyphs.Clock}" ToolTip="Watch later"
                                                Command="{Binding DataContext.ToggleWatchLaterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ThumbAction}" Content="{x:Static core:Glyphs.Check}" ToolTip="Mark watched / unwatched"
                                                Command="{Binding DataContext.ToggleWatchedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ThumbAction}" Content="{x:Static core:Glyphs.OpenExternal}" ToolTip="Open on YouTube"
                                                Command="{Binding DataContext.OpenVideoInBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="actions" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsWatchLater}" Value="True">
                                        <Setter TargetName="actions" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" b:Motion.Enter="True" MaxWidth="460">
                    <Border Style="{StaticResource EmptyIcon}">
                        <TextBlock Text="{x:Static core:Glyphs.Video}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <TextBlock Text="Nothing here yet" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="Follow YouTube channels to see their new uploads here — no account needed. Save any video to watch it with timestamped notes."
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Follow a channel" b:Ui.Icon="{x:Static core:Glyphs.AddPerson}" Command="{Binding FollowChannelCommand}" Margin="0,0,8,0" />
                        <Button Content="Save a video" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding SaveVideoCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ===== Player ===== -->
        <Grid Grid.Column="1" Margin="24,0,24,20" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,12">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Back}" Command="{Binding ClosePlayerCommand}" ToolTip="Back to videos" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Playing.Title}" Style="{StaticResource Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid x:Name="PlayerHost" DockPanel.Dock="Top" Background="Black" ClipToBounds="True"
                      Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Multiply}, ConverterParameter=0.5625}">
                    <c:YouTubePlayer x:Name="Player" />
                    <!-- shown when the player can't run in the app -->
                    <Grid x:Name="Fallback" Visibility="Collapsed">
                        <Image Source="{Binding Playing.Thumbnail, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" Opacity="0.55" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="FallbackText" Text="Watch this video on YouTube" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                            <Button Style="{StaticResource AccentButton}" Content="Open on YouTube" b:Ui.Icon="{x:Static core:Glyphs.Play}" Command="{Binding OpenInBrowserCommand}"
                                    HorizontalAlignment="Center" Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Chip}" Content="Watch later" b:Ui.Icon="{x:Static core:Glyphs.Clock}" IsChecked="{Binding Playing.IsWatchLater, Mode=OneWay}"
                                          Command="{Binding ToggleWatchLaterCommand}" Margin="0,0,6,0" />
                            <ToggleButton Style="{StaticResource Chip}" Content="Saved" b:Ui.Icon="{x:Static core:Glyphs.Bookmark}" IsChecked="{Binding Playing.IsSaved, Mode=OneWay}"
                                          Command="{Binding ToggleSavedCommand}" Margin="0,0,6,0" />
                            <ToggleButton Style="{StaticResource Chip}" Content="Watched" b:Ui.Icon="{x:Static core:Glyphs.Check}" IsChecked="{Binding Playing.IsWatched, Mode=OneWay}"
                                          Command="{Binding ToggleWatchedCommand}" Margin="0,0,6,0" />
                            <ToggleButton Style="{StaticResource Chip}" Content="Private" b:Ui.Icon="{x:Static core:Glyphs.Hide}" IsChecked="{Binding Playing.IsPrivate, Mode=OneWay}"
                                          Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding Playing}" Margin="0,0,6,0" />
                            <Button Content="YouTube" b:Ui.Icon="{x:Static core:Glyphs.OpenExternal}" Command="{Binding OpenInBrowserCommand}" ToolTip="Open on YouTube at the current time" />
                        </StackPanel>
                        <TextBlock Text="{Binding Playing.Author}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </DockPanel>
                </StackPanel>
                <DockPanel Margin="0,18,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Up next" Style="{StaticResource Overline}" Margin="2,0,0,8" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Top">
                        <ItemsControl ItemsSource="{Binding UpNext}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Video}">
                                    <Button Style="{StaticResource RowButton}" Width="184" Margin="0,0,10,0" Padding="4" VerticalContentAlignment="Top"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <Border Height="98" CornerRadius="8" ClipToBounds="True" Background="#1A1A1A">
                                                <Image Source="{Binding Thumbnail, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="2,6,2,0" />
                                            <TextBlock Text="{Binding Author}" Style="{StaticResource Caption}" Margin="2,1,2,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>

            <!-- notes -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Copy}" Command="{Binding CopyNotesCommand}" ToolTip="Copy notes with links" />
                            <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Tiles}" Command="{Binding OpenBoardCommand}" ToolTip="Open a notes board for this video" />
                        </StackPanel>
                        <TextBlock Text="Notes" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="56" b:Ui.Placeholder="Note at the current moment…"
                                 b:Ui.EnterCommand="{Binding AddNoteCommand}" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding AddNoteCommand}" MinHeight="30">
                                <TextBlock><Run Text="Add at " /><Run Text="{Binding CurrentTimeText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /></TextBlock>
                            </Button>
                            <TextBlock Text="Tip: start with 1:23 to set a time" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Button Content="Open notes board" b:Ui.Icon="{x:Static core:Glyphs.Tiles}" Command="{Binding OpenBoardCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                ToolTip="A corkboard with this video and your notes — connect and arrange them" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:VideoNote}">
                                    <Grid x:Name="row" Margin="0,0,0,6" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource SubtleAccentButton}" Content="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" MinHeight="24" Padding="8,0" VerticalAlignment="Top"
                                                Command="{Binding DataContext.SeekToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Jump to this moment" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="10,3,6,0" />
                                        <Button x:Name="del" Grid.Column="2" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Delete}" Opacity="0" VerticalAlignment="Top"
                                                Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="del" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
