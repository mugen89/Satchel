<UserControl x:Class="Satchel.Views.Pages.SheetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <Style x:Key="BarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
        </Style>
        <Style x:Key="BarText" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <!-- Sheet tabs along the bottom, like in Excel. -->
        <DataTemplate x:Key="SheetTabTemplate" DataType="{x:Type vm:SheetTab}">
            <Button x:Name="tab" Style="{StaticResource GhostButton}" MinHeight="30" Padding="14,0" Margin="0,0,2,0" FontWeight="Normal"
                    Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    MouseDoubleClick="OnTabDoubleClick" ToolTip="Double-click to rename">
                <Grid>
                    <TextBlock Text="{Binding Name}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                    <Border x:Name="line" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,-7"
                            Visibility="Collapsed" />
                </Grid>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rename…" Icon="{x:Static core:Glyphs.Edit}" Command="{Binding PlacementTarget.DataContext.RenameTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Duplicate" Icon="{x:Static core:Glyphs.Copy}" Command="{Binding PlacementTarget.DataContext.DuplicateTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Move left" Icon="{x:Static core:Glyphs.ChevronLeft}" Command="{Binding PlacementTarget.DataContext.MoveTabLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Move right" Icon="{x:Static core:Glyphs.ChevronRight}" Command="{Binding PlacementTarget.DataContext.MoveTabRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Delete sheet" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                                  Command="{Binding PlacementTarget.DataContext.DeleteTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="tab" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    <Setter TargetName="tab" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="tab" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter TargetName="line" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Spreadsheet list ===== -->
        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0" Padding="20,0,12,16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,4,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Add}" Command="{Binding NewCommand}" ToolTip="New spreadsheet (Ctrl+N)" Margin="0,0,6,0" />
                        <Button Style="{StaticResource AccentButton}" Content="Import" b:Ui.Icon="{x:Static core:Glyphs.Import}" Command="{Binding ImportCommand}"
                                ToolTip="Import Excel (.xlsx, .xls) or CSV files — or drop them here" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Sheets" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding CountText}" />
                    </StackPanel>
                </DockPanel>
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         b:Ui.Placeholder="Search spreadsheets" Margin="0,0,4,10" MinHeight="36" b:Ui.EscapeCommand="{Binding ClearSearchCommand}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding Filtered}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:AnimatedStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Spreadsheet}">
                                <Grid Margin="0,0,0,4">
                                    <Border x:Name="sel" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource AccentSubtleBrush}" Opacity="0" />
                                    <Button Style="{StaticResource RowButton}" Padding="12,10" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{x:Static core:Glyphs.Sheet}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.StarFilled}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.Hide}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Private"
                                                               Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource SameObject}">
                                                <Binding />
                                                <Binding Path="DataContext.Selected" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="sel" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== No spreadsheets yet ===== -->
        <Border Grid.Column="1" Margin="40" CornerRadius="{DynamicResource RadiusLarge}" BorderThickness="2" BorderBrush="{DynamicResource StrokeStrongBrush}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" b:Motion.Enter="True">
                <Border Style="{StaticResource EmptyIcon}">
                    <TextBlock Text="{x:Static core:Glyphs.Sheet}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <TextBlock Text="Your spreadsheets" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                <TextBlock Text="Budgets, lists and plans — with formulas. Import Excel or CSV files, or drop them here." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="New spreadsheet" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                    <Button Content="Import a file" b:Ui.Icon="{x:Static core:Glyphs.Import}" Command="{Binding ImportCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Open spreadsheet ===== -->
        <DockPanel Grid.Column="1" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
            <DockPanel DockPanel.Dock="Top" Margin="24,2,20,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Export" b:Ui.Icon="{x:Static core:Glyphs.Export}" b:Ui.MenuOnClick="True" ToolTip="Save a copy as a file">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Excel workbook (.xlsx)…" Icon="{x:Static core:Glyphs.Sheet}" Command="{Binding ExportXlsxCommand}" />
                                <MenuItem Header="This sheet as CSV…" Icon="{x:Static core:Glyphs.Document}" Command="{Binding ExportCsvCommand}" />
                                <Separator />
                                <MenuItem Header="Copy to the Library as tables" Icon="{x:Static core:Glyphs.Library}" Command="{Binding CopyToLibraryCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" ToolTip="More" Margin="6,0,0,0">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename…" Icon="{x:Static core:Glyphs.Edit}" Command="{Binding RenameCommand}" />
                                <MenuItem Header="Duplicate" Icon="{x:Static core:Glyphs.Copy}" Command="{Binding DuplicateCommand}" />
                                <MenuItem Header="{Binding Selected.IsFavorite, Converter={StaticResource BoolToString}, ConverterParameter='Remove from favorites|Favorite'}"
                                          Icon="{x:Static core:Glyphs.Star}" Command="{Binding ToggleFavoriteCommand}" />
                                <MenuItem Header="{Binding Selected.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}" Icon="{x:Static core:Glyphs.Hide}"
                                          Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding Selected}" />
                                <Separator />
                                <MenuItem Header="Delete" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource Title}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                               Cursor="Hand" ToolTip="Click to rename" MouseLeftButtonUp="OnTitleClick" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Selected.Summary}" />
                </StackPanel>
            </DockPanel>

            <!-- toolbar -->
            <WrapPanel DockPanel.Dock="Top" Margin="18,0,20,6">
                <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Undo}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" />
                <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Redo}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" />
                <Border Style="{StaticResource BarSeparator}" />
                <ToggleButton Style="{StaticResource ToolToggle}" Width="30" Height="30" Content="{x:Static core:Glyphs.Bold}" IsChecked="{Binding Document.IsBold, Mode=OneWay}"
                              Command="{Binding BoldCommand}" ToolTip="Bold (Ctrl+B)" />
                <ToggleButton Style="{StaticResource ToolToggle}" Width="30" Height="30" Content="{x:Static core:Glyphs.Italic}" IsChecked="{Binding Document.IsItalic, Mode=OneWay}"
                              Command="{Binding ItalicCommand}" ToolTip="Italic (Ctrl+I)" />
                <ToggleButton Style="{StaticResource ToolToggle}" Width="30" Height="30" Content="{x:Static core:Glyphs.Strikethrough}" IsChecked="{Binding Document.IsStrike, Mode=OneWay}"
                              Command="{Binding StrikeCommand}" ToolTip="Strikethrough" />
                <Border Style="{StaticResource BarSeparator}" />
                <ToggleButton Style="{StaticResource ToolToggle}" Width="30" Height="30" Content="{x:Static core:Glyphs.AlignLeft}" IsChecked="{Binding Document.IsLeft, Mode=OneWay}"
                              Command="{Binding AlignLeftCommand}" ToolTip="Align left" />
                <ToggleButton Style="{StaticResource ToolToggle}" Width="30" Height="30" Content="{x:Static core:Glyphs.AlignCenter}" IsChecked="{Binding Document.IsCenter, Mode=OneWay}"
                              Command="{Binding AlignCenterCommand}" ToolTip="Center" />
                <ToggleButton Style="{StaticResource ToolToggle}" Width="30" Height="30" Content="{x:Static core:Glyphs.AlignRight}" IsChecked="{Binding Document.IsRight, Mode=OneWay}"
                              Command="{Binding AlignRightCommand}" ToolTip="Align right" />
                <Border Style="{StaticResource BarSeparator}" />
                <Button x:Name="FormatButton" Style="{StaticResource BarText}" Click="OnFormatMenu" ToolTip="Number format">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="123" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static core:Glyphs.ChevronDown}" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BarText}" Content=".0←" Command="{Binding FewerDecimalsCommand}" ToolTip="Fewer decimal places" />
                <Button Style="{StaticResource BarText}" Content=".00→" Command="{Binding MoreDecimalsCommand}" ToolTip="More decimal places" />
                <Border Style="{StaticResource BarSeparator}" />
                <Button Style="{StaticResource BarText}" Content="Σ" FontSize="15" Command="{Binding AutoSumCommand}" ToolTip="AutoSum (Alt+=): sums the numbers above, or under each selected column" />
                <Button Style="{StaticResource BarText}" Content="A→Z" Command="{Binding SortAscendingCommand}" ToolTip="Sort by this column, smallest first (a header row stays on top)" />
                <Button Style="{StaticResource BarText}" Content="Z→A" Command="{Binding SortDescendingCommand}" ToolTip="Sort by this column, largest first" />
                <Border Style="{StaticResource BarSeparator}" />
                <Button Style="{StaticResource BarText}" b:Ui.MenuOnClick="True" ToolTip="Insert rows or columns">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Insert" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static core:Glyphs.ChevronDown}" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Row above" Command="{Binding InsertRowAboveCommand}" />
                            <MenuItem Header="Row below" Command="{Binding InsertRowBelowCommand}" />
                            <Separator />
                            <MenuItem Header="Column to the left" Command="{Binding InsertColumnLeftCommand}" />
                            <MenuItem Header="Column to the right" Command="{Binding InsertColumnRightCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource BarText}" b:Ui.MenuOnClick="True" ToolTip="Delete rows or columns, or clear cells">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Delete" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static core:Glyphs.ChevronDown}" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Selected rows" Command="{Binding DeleteRowsCommand}" />
                            <MenuItem Header="Selected columns" Command="{Binding DeleteColumnsCommand}" />
                            <Separator />
                            <MenuItem Header="Clear contents" InputGestureText="Delete" Command="{Binding ClearCellsCommand}" />
                            <MenuItem Header="Clear contents and formatting" Command="{Binding ClearAllCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ToggleButton Style="{StaticResource ToolToggle}" Width="NaN" Height="30" Padding="10,0" IsChecked="{Binding IsFrozen, Mode=OneWay}" Command="{Binding ToggleFreezeCommand}"
                              ToolTip="Freeze the top row: it stays on screen while you scroll" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static core:Glyphs.Pin}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="Freeze" FontFamily="{DynamicResource UiFont}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </ToggleButton>
            </WrapPanel>

            <!-- formula bar -->
            <Border DockPanel.Dock="Top" Margin="20,0,20,8" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}">
                <DockPanel>
                    <TextBox x:Name="NameBox" DockPanel.Dock="Left" Width="96" Style="{StaticResource InlineTextBox}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                             VerticalContentAlignment="Center" Padding="10,6" ToolTip="Type a cell (B12) or range (A1:C20) and press Enter to go there"
                             PreviewKeyDown="OnNameBoxKeyDown" GotKeyboardFocus="OnNameBoxFocus" />
                    <Border DockPanel.Dock="Left" Width="1" Background="{DynamicResource StrokeBrush}" />
                    <TextBlock DockPanel.Dock="Left" Text="fx" FontStyle="Italic" FontFamily="Georgia" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox x:Name="FormulaBox" Style="{StaticResource InlineTextBox}" Text="{Binding FormulaText, UpdateSourceTrigger=PropertyChanged}" FontSize="13"
                             VerticalContentAlignment="Center" Padding="4,6" b:Ui.Placeholder="Type a value or a formula — e.g. =SUM(B2:B10)"
                             PreviewKeyDown="OnFormulaKeyDown" GotKeyboardFocus="OnFormulaFocus" LostKeyboardFocus="OnFormulaLostFocus" />
                </DockPanel>
            </Border>

            <!-- sheet tabs and status -->
            <DockPanel DockPanel.Dock="Bottom" Margin="20,6,20,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Document.StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource SheetTabTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Add}" Command="{Binding AddTabCommand}" ToolTip="Add a sheet" Margin="4,0,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- the grid -->
            <Border Margin="20,0,20,0" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" ClipToBounds="True"
                    Background="{DynamicResource SurfaceBrush}">
                <ScrollViewer x:Name="GridScroll" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <c:SheetGrid x:Name="Grid" Document="{Binding Document}">
                        <c:SheetGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cut" InputGestureText="Ctrl+X" Icon="{x:Static core:Glyphs.Move}" Command="{Binding CutCommand}" />
                                <MenuItem Header="Copy" InputGestureText="Ctrl+C" Icon="{x:Static core:Glyphs.Copy}" Command="{Binding CopyCommand}" />
                                <MenuItem Header="Paste" InputGestureText="Ctrl+V" Icon="{x:Static core:Glyphs.Download}" Command="{Binding PasteCommand}" />
                                <Separator />
                                <MenuItem Header="Insert row above" Command="{Binding InsertRowAboveCommand}" />
                                <MenuItem Header="Insert row below" Command="{Binding InsertRowBelowCommand}" />
                                <MenuItem Header="Insert column left" Command="{Binding InsertColumnLeftCommand}" />
                                <MenuItem Header="Insert column right" Command="{Binding InsertColumnRightCommand}" />
                                <MenuItem Header="Delete rows" Command="{Binding DeleteRowsCommand}" />
                                <MenuItem Header="Delete columns" Command="{Binding DeleteColumnsCommand}" />
                                <Separator />
                                <MenuItem Header="Fill down" InputGestureText="Ctrl+D" Command="{Binding FillDownCommand}" />
                                <MenuItem Header="Fill right" InputGestureText="Ctrl+R" Command="{Binding FillRightCommand}" />
                                <MenuItem Header="Sort A → Z" Icon="{x:Static core:Glyphs.Sort}" Command="{Binding SortAscendingCommand}" />
                                <MenuItem Header="Sort Z → A" Command="{Binding SortDescendingCommand}" />
                                <Separator />
                                <MenuItem Header="Clear contents" InputGestureText="Delete" Icon="{x:Static core:Glyphs.Delete}" Command="{Binding ClearCellsCommand}" />
                            </ContextMenu>
                        </c:SheetGrid.ContextMenu>
                    </c:SheetGrid>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- number formats -->
        <Popup x:Name="FormatPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=FormatButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Margin="6,4,10,14" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius}" Padding="6" Effect="{DynamicResource PopupShadow}" Width="270">
                <ItemsControl ItemsSource="{Binding Formats}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FormatChoice}">
                            <Button Style="{StaticResource RowButton}" Padding="10,7" Click="OnFormatChosen">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Sample}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Label}" />
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>

        <c:DropOverlay x:Name="DropZone" Grid.ColumnSpan="2" Title="Drop to open as spreadsheets" Hint="Excel workbooks (.xlsx, .xls) and CSV files — with their formulas, formats and column widths." />
    </Grid>
</UserControl>
