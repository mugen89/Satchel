<UserControl x:Class="Satchel.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:vm="clr-namespace:Satchel.ViewModels"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:m="clr-namespace:Satchel.Models">
    <UserControl.Resources>
        <!-- ===== Widget bodies (resolved by type) ===== -->
        <DataTemplate DataType="{x:Type vm:GreetingWidget}">
            <Grid>
                <StackPanel Margin="0,0,180,0">
                    <TextBlock Text="{Binding Greeting}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,18,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="New note" b:Ui.Icon="{x:Static core:Glyphs.Notes}" Command="{Binding Owner.NewNoteCommand}" Margin="0,0,8,8" />
                        <Button Content="New task" b:Ui.Icon="{x:Static core:Glyphs.Tasks}" Command="{Binding Owner.NewTaskCommand}" Margin="0,0,8,8" />
                        <Button Content="New event" b:Ui.Icon="{x:Static core:Glyphs.Calendar}" Command="{Binding Owner.NewEventCommand}" Margin="0,0,8,8" />
                        <Button Content="Password" b:Ui.Icon="{x:Static core:Glyphs.Lightning}" Command="{Binding Owner.GeneratorCommand}" Margin="0,0,8,8" ToolTip="Password generator" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="Light" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AgendaWidget}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Padding="8,7" Margin="-8,0"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding ColorKey, Converter={StaticResource PaletteBrush}}" Margin="0,0,12,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Day}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nothing planned for the next 7 days." Style="{StaticResource Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TasksWidget}">
            <StackPanel>
                <Border Padding="10,0" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1" MinHeight="36" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock Text="{x:Static core:Glyphs.Add}" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,10,0" />
                        <TextBox Style="{StaticResource InlineTextBox}" Text="{Binding NewTask, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Add a task for today"
                                 b:Ui.EnterCommand="{Binding AddCommand}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:AnimatedStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Padding="6,6" Margin="-6,0"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource RoundCheck}" IsChecked="{Binding IsDone, Mode=OneWay}" VerticalAlignment="Center"
                                              BorderBrush="{Binding Priority, Converter={StaticResource PriorityBrush}}"
                                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <TextBlock x:Name="due" DockPanel.Dock="Right" Text="{Binding DueText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock x:Name="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                    <Setter TargetName="due" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough" />
                                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="All clear — nothing urgent. 🎉" Style="{StaticResource Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PinnedNotesWidget}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:MasonryPanel MinColumnWidth="190" Spacing="10" Entrance="False" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Padding="12,10" Background="{Binding Color, Converter={StaticResource PaletteBrush}, ConverterParameter=note}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TypeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxHeight="52" Margin="0,4,0,0" TextTrimming="WordEllipsis"
                                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding ProgressText, StringFormat={}{0} done}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding Type, Converter={StaticResource EqualsToVis}, ConverterParameter=Checklist}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Pin notes to keep them here." Style="{StaticResource Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:QuickNoteWidget}">
            <!-- The text box fills the widget when it has a fixed height. -->
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleAccentButton}" Content="Save note" Command="{Binding SaveCommand}" MinHeight="32" />
                    <TextBlock Text="Ctrl+Enter to save" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox x:Name="box" Style="{StaticResource MultilineTextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MinHeight="96" MaxHeight="200"
                         b:Ui.Placeholder="Jot something down… first line becomes the title" PreviewKeyDown="OnQuickNoteKeyDown" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFixedHeight}" Value="True">
                    <Setter TargetName="box" Property="MaxHeight" Value="4000" />
                    <Setter TargetName="box" Property="MinHeight" Value="40" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FavoritesWidget}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="-6,0" Background="Transparent" x:Name="row">
                                <Border x:Name="hover" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource HoverOverlayBrush}" Opacity="0" />
                                <DockPanel Margin="6,6">
                                    <c:Avatar Image="{Binding Profile.Image}" Text="{Binding Profile.Name}" Glyph="{Binding Profile.Icon}" ColorKey="{Binding Profile.Color}" Size="34" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Contact}" Command="{Binding CopyLoginCommand}" ToolTip="Copy username"
                                                Visibility="{Binding HasLogin, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Key}" Command="{Binding CopyPasswordCommand}" ToolTip="Copy password"
                                                Visibility="{Binding HasPassword, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Margin="10,0,6,0" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnFavoriteClick">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                        <c:TotpBadge Secret="{Binding Account.TotpSecret}" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="{Binding HasTotp, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="hover" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Star accounts in the Vault for one-click copying here." Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SecurityWidget}">
            <DockPanel>
                <Grid Width="84" Height="84" DockPanel.Dock="Left">
                    <c:ProgressRing Progress="{Binding Fraction}" Thickness="7" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Score}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="/ 100" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,-3,0,0" />
                    </StackPanel>
                </Grid>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Verdict}" Style="{StaticResource Subtitle}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8">
                        <Run Text="{Binding Total, Mode=OneWay}" /><Run Text=" passwords checked" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="9" Padding="8,2" Background="{DynamicResource DangerSubtleBrush}" Margin="0,0,6,0">
                            <TextBlock FontSize="12" Foreground="{DynamicResource DangerBrush}"><Run Text="{Binding Weak, Mode=OneWay}" /><Run Text=" weak" /></TextBlock>
                        </Border>
                        <Border CornerRadius="9" Padding="8,2" Background="{DynamicResource WarningSubtleBrush}" Margin="0,0,6,0">
                            <TextBlock FontSize="12" Foreground="{DynamicResource WarningBrush}"><Run Text="{Binding Reused, Mode=OneWay}" /><Run Text=" reused" /></TextBlock>
                        </Border>
                        <Border CornerRadius="9" Padding="8,2" Background="{DynamicResource InfoSubtleBrush}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource InfoBrush}"><Run Text="{Binding Expiring, Mode=OneWay}" /><Run Text=" expiring" /></TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CalendarWidget}">
            <c:MiniCalendar SelectedDate="{Binding Selected}" MarkedDates="{Binding Marks}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StatsWidget}">
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Two tiles per row when narrow, all four in a row when the widget is wider. -->
                        <c:MasonryPanel MinColumnWidth="150" Spacing="6" MaxColumns="4" Entrance="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource RowButton}" Padding="10,10" Background="{DynamicResource InputBrush}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{Binding ColorKey, Converter={StaticResource PaletteBrush}}" />
                                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BirthdaysWidget}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Padding="6,6" Margin="-6,0"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <c:Avatar Image="{Binding Image}" Text="{Binding FullName}" ColorKey="{Binding Color}" Size="32" Roundness="-1" />
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding BirthdayText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No birthdays in the next weeks. Add birthdays to contacts to see them here." Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProjectsWidget}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Padding="6,7" Margin="-6,0"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Background="{Binding Color, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{Binding Color, Converter={StaticResource PaletteBrush}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Progress, Converter={StaticResource Percent}}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Grid Height="4" Margin="0,5,0,0">
                                            <Border Background="{DynamicResource SegmentBrush}" CornerRadius="2" />
                                            <Border Background="{Binding Color, Converter={StaticResource PaletteBrush}}" CornerRadius="2" HorizontalAlignment="Left">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                        <Binding Path="Progress" />
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Plan something bigger: milestones, a task board, notes and a corkboard in one place." Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <Button Style="{StaticResource LinkButton}" Content="Start a project" Command="{Binding CreateCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReadingWidget}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Padding="6,6" Margin="-6,0"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="36" Height="54" Margin="0,0,12,0">
                                        <Border CornerRadius="2,4,4,2" Background="{Binding Color, Converter={StaticResource PaletteBrush}}" />
                                        <Border CornerRadius="2,4,4,2" ClipToBounds="True" Visibility="{Binding Cover, Converter={StaticResource HasValueToVis}}">
                                            <Image Source="{Binding Cover, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Author}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                        <Grid Height="4" Margin="0,6,0,3">
                                            <Border Background="{DynamicResource SegmentBrush}" CornerRadius="2" />
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                        <Binding Path="Progress" />
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nothing on the go. Track books, progress, quotes and a yearly goal." Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <Button Style="{StaticResource LinkButton}" Content="Add a book" Command="{Binding CreateCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VideosWidget}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- As many thumbnails per row as the width allows. -->
                            <c:MasonryPanel MinColumnWidth="150" Spacing="6" Entrance="False" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Padding="3" VerticalContentAlignment="Top"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Border CornerRadius="6" ClipToBounds="True" Background="#1A1A1A" Height="74">
                                        <Image Source="{Binding Thumbnail, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="1,5,1,0" />
                                    <TextBlock Text="{Binding Author}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="1,1,1,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Follow YouTube channels and their new uploads appear here — no account needed." Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <Button Style="{StaticResource LinkButton}" Content="Follow a channel" Command="{Binding FollowCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Visibility="{Binding HasChannels, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GamesWidget}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Padding="6,6" Margin="-6,0"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="34" Height="46" Margin="0,0,12,0">
                                        <Border CornerRadius="4" Background="{Binding Color, Converter={StaticResource PaletteBrush}}">
                                            <TextBlock Text="{x:Static core:Glyphs.Game}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="4" ClipToBounds="True" Visibility="{Binding Cover, Converter={StaticResource HasValueToVis}}">
                                            <Image Source="{Binding Cover, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding HoursText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Platform, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nothing being played. Keep a backlog and time your sessions." Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <Button Style="{StaticResource LinkButton}" Content="Add a game" Command="{Binding CreateCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Widget frame ===== -->
        <!-- ===== Weather ===== -->
        <DataTemplate DataType="{x:Type vm:WeatherWidget}">
            <Grid>
                <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <c:WeatherIcon DockPanel.Dock="Left" Kind="{Binding Report.Kind}" Width="64" Height="64" Margin="0,0,14,0" />
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="{Binding Unit}" Command="{Binding ToggleUnitCommand}" MinHeight="26" Padding="8,0" ToolTip="°C / °F" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="Light"><Run Text="{Binding Report.Temperature, Mode=OneWay, StringFormat={}{0:0}°}" /></TextBlock>
                            <TextBlock Text="{Binding Report.Description}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Report.Location.Name, Mode=OneWay}" /><Run Text=" · feels " /><Run Text="{Binding Report.FeelsLike, Mode=OneWay, StringFormat={}{0:0}°}" /><Run Text=" · wind " /><Run Text="{Binding Report.Wind, Mode=OneWay, StringFormat={}{0:0}}" /></TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Days}" Focusable="False" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type s:WeatherDay}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DayName}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    <c:WeatherIcon Kind="{Binding Kind}" Width="28" Height="28" Margin="0,4" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="12.5"><Run Text="{Binding Max, Mode=OneWay, StringFormat={}{0:0}°}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Min, Mode=OneWay, StringFormat={}{0:0}°}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                                    <TextBlock Text="{Binding RainChance, StringFormat={}{0}%}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource InfoBrush}"
                                               Visibility="{Binding RainChance, Converter={StaticResource HasValueToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource LinkButton}" Content="Change city" Command="{Binding SetCityCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" FontSize="12" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="Pick your city to see the weather and the next five days." Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" />
                    <Button Style="{StaticResource SubtleAccentButton}" Content="Set my city" b:Ui.Icon="{x:Static core:Glyphs.MapPin}" Command="{Binding SetCityCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
                <TextBlock Text="Weather needs the internet — it'll show up when you're online." TextWrapping="Wrap" TextTrimming="None">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasLocation}" Value="True" />
                                        <Condition Binding="{Binding HasReport}" Value="False" />
                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ===== World clock ===== -->
        <DataTemplate DataType="{x:Type vm:ClocksWidget}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WorldClockRow}">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Light" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding DayText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding OffsetText, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Add the cities you care about on the Clock page." Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" />
                    <Button Style="{StaticResource SubtleAccentButton}" Content="Add a city" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddCityCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Countdowns ===== -->
        <DataTemplate DataType="{x:Type vm:CountdownsWidget}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Countdown}">
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0"
                                        Background="{Binding Color, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}">
                                    <Grid>
                                        <TextBlock Text="{Binding Emoji}" FontFamily="{StaticResource EmojiFont}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static core:Glyphs.Flag}" FontFamily="{StaticResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Color, Converter={StaticResource PaletteBrush}}" Visibility="{Binding Emoji, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DaysText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Color, Converter={StaticResource PaletteBrush}}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Count down to a trip, a birthday or a deadline." Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" />
                    <Button Style="{StaticResource SubtleAccentButton}" Content="New countdown" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding CreateCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Quote ===== -->
        <DataTemplate DataType="{x:Type vm:QuoteWidget}">
            <StackPanel>
                <TextBlock Text="“" FontFamily="Georgia" FontSize="52" Foreground="{DynamicResource AccentBrush}" Opacity="0.5" Margin="-4,-14,0,-30" />
                <TextBlock Text="{Binding Current.Text}" FontFamily="Georgia" FontSize="17" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0" b:Motion.Enter="True" />
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Refresh}" Command="{Binding AnotherCommand}" ToolTip="Another one" />
                    <TextBlock Text="{Binding Current.Author, StringFormat=— {0}}" Style="{StaticResource Caption}" FontSize="12.5" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Rediscover a note ===== -->
        <DataTemplate DataType="{x:Type vm:RediscoverWidget}">
            <StackPanel>
                <Button Style="{StaticResource CardButton}" Padding="14,12" Command="{Binding OpenCommand}" Visibility="{Binding Note, Converter={StaticResource HasValueToVis}}"
                        Background="{Binding Note.Color, Converter={StaticResource PaletteBrush}, ConverterParameter=note}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note.TypeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
                            <TextBlock Text="{Binding Note.DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Note.Preview}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxHeight="72" Margin="0,4,0,0" TextTrimming="WordEllipsis" />
                    </StackPanel>
                </Button>
                <DockPanel Margin="0,8,0,0" Visibility="{Binding Note, Converter={StaticResource HasValueToVis}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Another" b:Ui.Icon="{x:Static core:Glyphs.Shuffle}" Command="{Binding AnotherCommand}" MinHeight="28" />
                    <TextBlock Text="{Binding Age}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Older notes will resurface here now and then." Style="{StaticResource Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- ===== Music ===== -->
        <DataTemplate DataType="{x:Type vm:MusicWidget}">
            <Grid>
                <DockPanel Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Left" Width="96" Height="54" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SegmentBrush}" Margin="0,0,12,0">
                        <Image Source="{Binding Player.Thumbnail, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Player.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Player.Artist}" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" Margin="-6,4,0,0">
                            <Button Style="{StaticResource IconButtonSmall}" Content="&#xE892;" Command="{Binding Player.PreviousCommand}" ToolTip="Previous" />
                            <Button Style="{StaticResource IconButtonSmall}" Command="{Binding Player.PlayPauseCommand}" ToolTip="Play / pause"
                                    Content="{Binding Player.IsPlaying, Converter={StaticResource BoolToString}, ConverterParameter=&#xE769;|&#xE768;}" />
                            <Button Style="{StaticResource IconButtonSmall}" Content="&#xE893;" Command="{Binding Player.NextCommand}" ToolTip="Next" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <StackPanel Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="Nothing playing. Your YouTube playlists play in the background while you work." Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" />
                    <Button Style="{StaticResource SubtleAccentButton}" Content="Open Music" b:Ui.Icon="{x:Static core:Glyphs.Music}" Command="{Binding ActionCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WidgetFrame" DataType="{x:Type vm:WidgetViewModel}">
            <Grid x:Name="frame" Height="{Binding FrameHeight}" b:Motion.Wiggle="{Binding IsWiggling}">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusLarge}" Effect="{DynamicResource CardShadow}" />
                <Border x:Name="glow" CornerRadius="{DynamicResource RadiusLarge}" Opacity="0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="0.8" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="card" Background="Transparent" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusLarge}" Padding="18,16" ClipToBounds="True">
                    <DockPanel>
                        <DockPanel x:Name="header" DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button x:Name="action" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding ActionText}" Command="{Binding ActionCommand}" FontSize="12.5"
                                    VerticalAlignment="Center" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0" />
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <!-- Fits the content by default; scrolls once the widget is given a smaller fixed height. -->
                        <ScrollViewer x:Name="body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                      b:Ui.WheelPassThrough="True" Margin="0,0,-12,0" Padding="0,0,12,0">
                            <ContentControl Content="{Binding}" Focusable="False" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border x:Name="outline" CornerRadius="{DynamicResource RadiusLarge}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False" />

                <!-- Customize mode: the whole card is a handle for moving; the corner grip resizes. -->
                <Border x:Name="grab" Background="Transparent" Cursor="SizeAll" CornerRadius="{DynamicResource RadiusLarge}" Visibility="Collapsed" />
                <StackPanel x:Name="tools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Visibility="Collapsed" b:DnD.NoDrag="True">
                    <Button x:Name="fit" Style="{StaticResource IconButtonSmall}" Background="{DynamicResource ElevatedBrush}" Content="{x:Static core:Glyphs.Sort}" ToolTip="Fit the height to the content"
                            Command="{Binding Owner.FitHeightCommand}" CommandParameter="{Binding}" Margin="0,0,4,0" Visibility="Collapsed" />
                    <Button Style="{StaticResource IconButtonSmall}" Background="{DynamicResource ElevatedBrush}" Content="{x:Static core:Glyphs.Hide}" ToolTip="Hide widget"
                            Command="{Binding Owner.HideWidgetCommand}" CommandParameter="{Binding}" />
                </StackPanel>
                <Border x:Name="sizeBadge" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,5" CornerRadius="13" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Effect="{DynamicResource PopupShadow}">
                    <TextBlock Text="{Binding SizeText}" FontSize="12.5" FontWeight="SemiBold" />
                </Border>
                <Thumb x:Name="grip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="26" Height="26" Margin="0,0,3,3" Cursor="SizeNWSE" Visibility="Collapsed"
                       ToolTip="Drag to resize · double-click to fit the content"
                       DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" MouseDoubleClick="OnResizeDoubleClick">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path x:Name="lines" Data="M 13,2 L 2,13 M 13,7 L 7,13 M 13,12 L 12,13" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="lines" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="lines" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="greeting">
                    <Setter TargetName="header" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="card" Property="Padding" Value="26,24" />
                    <Setter TargetName="glow" Property="Opacity" Value="1" />
                </DataTrigger>
                <!-- These lay out their own content (a text box that grows, a month grid). -->
                <DataTrigger Binding="{Binding Key}" Value="quicknote">
                    <Setter TargetName="body" Property="VerticalScrollBarVisibility" Value="Disabled" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Owner.IsCustomizing}" Value="True">
                    <Setter TargetName="tools" Property="Visibility" Value="Visible" />
                    <Setter TargetName="outline" Property="Opacity" Value="0.6" />
                    <Setter TargetName="grab" Property="Visibility" Value="Visible" />
                    <Setter TargetName="grip" Property="Visibility" Value="Visible" />
                    <Setter TargetName="action" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Owner.IsCustomizing}" Value="True" />
                        <Condition Binding="{Binding IsFixedHeight}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="fit" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsResizing}" Value="True">
                    <Setter TargetName="sizeBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="outline" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,28">
                <DockPanel Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Reset layout" Command="{Binding ResetLayoutCommand}" Margin="0,0,8,0"
                                ToolTip="Back to the default widgets for this profile" Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}" />
                        <!-- Dashboard profiles: different setups of widgets -->
                        <Button x:Name="ProfileButton" Click="OnProfileMenu" Margin="0,0,8,0" Padding="12,0" ToolTip="Dashboard profiles — switch, add or edit (Alt+1…9 switches)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ProfileIcon}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentTextBrush}" Visibility="{Binding HasProfileIcon, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding ProfileName}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Static core:Glyphs.ChevronDown}" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="10,1,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleCustomizeCommand}" b:Ui.Icon="{x:Static core:Glyphs.Sliders}" ToolTip="Move, resize or hide widgets">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Customize" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomizing}" Value="True">
                                            <Setter Property="Content" Value="Done" />
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Drag a widget to move it · drag its corner to resize (double-click the corner to fit) · Esc when you're done"
                                   Style="{StaticResource Muted}" Margin="0,2,16,0" TextWrapping="Wrap" TextTrimming="None"
                                   Visibility="{Binding IsCustomizing, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius}"
                        Padding="14,10" Margin="0,0,0,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCustomizing}" Value="True" />
                                        <Condition Binding="{Binding HasHidden}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock Text="Add widgets" Style="{StaticResource Overline}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <ItemsControl ItemsSource="{Binding HiddenWidgets}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding Title}" b:Ui.Icon="{x:Static core:Glyphs.Add}" Margin="0,2,8,2"
                                                  Command="{Binding Owner.ShowWidgetCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Widgets can only be dragged in customize mode, and land in the spot closest to where they're held. -->
                <ItemsControl ItemsSource="{Binding Widgets}" ItemTemplate="{StaticResource WidgetFrame}" Focusable="False"
                              b:DnD.IsReorderable="{Binding IsCustomizing}" b:DnD.Mode="Nearest" b:DnD.Group="widgets" b:DnD.ReorderCommand="{Binding ReorderWidgetsCommand}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:MasonryPanel MinColumnWidth="330" Spacing="18" MaxColumns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="c:MasonryPanel.Span" Value="{Binding Span}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
