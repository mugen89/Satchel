<UserControl x:Class="Satchel.Views.Pages.NoteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <DockPanel Margin="28,14,24,16">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="-8,0,-8,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Close}" FontSize="12" Command="{Binding Owner.CloseEditorCommand}" ToolTip="Close (Esc)" />
                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="11" Padding="9,3" VerticalAlignment="Center" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Note.TypeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Note.TypeName}" FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton Style="{StaticResource ToolToggle}" Width="34" Height="34" Content="{x:Static core:Glyphs.Pin}" IsChecked="{Binding Note.IsPinned}" ToolTip="Pin to top" />
                <Grid>
                    <Button x:Name="ColorButton" Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Palette}" Click="OnColorButton" ToolTip="Card color" />
                    <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Margin="6,4,10,14" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius}" Padding="12,12,6,6" Effect="{DynamicResource PopupShadow}">
                            <c:ColorSwatches Palette="note" SelectedKey="{Binding Note.Color}" Width="190" SwatchSize="26" />
                        </Border>
                    </Popup>
                </Grid>
                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleExpandedCommand}" ToolTip="Focus mode">
                    <Button.Content>
                        <Binding Path="IsExpanded" Converter="{StaticResource BoolToString}" ConverterParameter="&#xE73F;|&#xE740;" />
                    </Button.Content>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" ToolTip="More">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy as text" Icon="{x:Static core:Glyphs.Copy}" Command="{Binding CopyContentCommand}" />
                            <MenuItem Header="Duplicate" Icon="{x:Static core:Glyphs.AddBox}" Command="{Binding Owner.DuplicateCommand}" CommandParameter="{Binding Note}" />
                            <MenuItem Header="Export as Markdown…" Icon="{x:Static core:Glyphs.Export}" Command="{Binding Owner.ExportCommand}" CommandParameter="{Binding Note}" />
                            <MenuItem Header="Archive" Icon="{x:Static core:Glyphs.Archive}" Command="{Binding Owner.ToggleArchiveCommand}" CommandParameter="{Binding Note}" />
                            <MenuItem Header="{Binding Note.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}" Icon="{x:Static core:Glyphs.Hide}"
                                      Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding Note}" />
                            <Separator />
                            <MenuItem Header="Move to trash" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                                      Command="{Binding Owner.TrashCommand}" CommandParameter="{Binding Note}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Title -->
        <TextBox x:Name="TitleBox" DockPanel.Dock="Top" Style="{StaticResource InlineTextBox}" Text="{Binding Note.Title, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" b:Ui.Placeholder="Title"
                 PreviewKeyDown="OnTitleKeyDown" />

        <!-- Meta -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,14">
            <ComboBox Style="{StaticResource SmallCombo}" ItemsSource="{Binding NotebookChoices}" SelectedItem="{Binding SelectedNotebook}" MinWidth="150"
                      Margin="0,0,8,6" ToolTip="Notebook">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{Binding Color, Converter={StaticResource PaletteBrush}}" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Text="{Binding Note.Tags, UpdateSourceTrigger=LostFocus}" b:Ui.Placeholder="Tags, comma separated" MinWidth="190" MinHeight="32" FontSize="13"
                     Margin="0,0,8,6" b:Ui.EnterCommand="{x:Null}" />
            <c:DateBox SelectedDate="{Binding Note.JournalDate}" AllowClear="False" KeepTime="False" Width="190" MinHeight="32" Margin="0,0,8,6"
                       Visibility="{Binding IsJournal, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{x:Static vm:NoteEditorViewModel.Moods}" Visibility="{Binding IsJournal, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="mood" Style="{StaticResource IconButtonSmall}" Width="32" Height="32" Content="{Binding Label}" FontFamily="{StaticResource EmojiFont}"
                                FontSize="16" Opacity="0.45" Command="{Binding DataContext.SetMoodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Value}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource AllEqual}">
                                        <Binding Path="Value" />
                                        <Binding Path="DataContext.Note.Mood" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="mood" Property="Opacity" Value="1" />
                                <Setter TargetName="mood" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>

        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Foreground="{DynamicResource TextFaintBrush}" Margin="0,10,0,0" ToolTip="{Binding CreatedText}">
            <Run Text="{Binding StatsText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{x:Static core:Glyphs.Lock}" FontFamily="{StaticResource IconFont}" FontSize="10" /><Run Text=" encrypted" />
        </TextBlock>

        <!-- Body -->
        <Grid>
            <!-- Rich text -->
            <c:RichTextEditor x:Name="Rich" Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"
                              ContentText="{Binding Note.Content}" PlainText="{Binding Note.PlainText}" />

            <!-- Checklist / list -->
            <DockPanel Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding IsChecklist, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox Content="Move done to bottom" IsChecked="{Binding MoveCheckedToBottom}" FontSize="12" Margin="0,0,12,0" Foreground="{DynamicResource TextMutedBrush}" />
                            <Button Style="{StaticResource LinkButton}" Content="Clear done" Command="{Binding ClearCompletedCommand}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,8,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,0" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" MinHeight="38">
                    <DockPanel>
                        <TextBlock Text="{x:Static core:Glyphs.Add}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}" Margin="2,0,10,0" />
                        <TextBox x:Name="NewItemBox" Style="{StaticResource InlineTextBox}" Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                                 b:Ui.Placeholder="Add an item and press Enter (paste several lines to add many)" VerticalAlignment="Center"
                                 b:Ui.EnterCommand="{Binding AddItemCommand}" />
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}" Focusable="False"
                                  b:DnD.IsReorderable="True" b:DnD.HandleOnly="True" b:DnD.Mode="Vertical" b:DnD.Group="checklist"
                                  b:DnD.ReorderCommand="{Binding ReorderItemsCommand}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:AnimatedStackPanel Entrance="False" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="row" Background="Transparent" Margin="{Binding Indent, Converter={StaticResource Indent}}" MinHeight="34">
                                    <Border x:Name="rowBg" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource HoverOverlayBrush}" Opacity="0" />
                                    <DockPanel Margin="0,2">
                                        <TextBlock x:Name="handle" DockPanel.Dock="Left" Text="{x:Static core:Glyphs.Gripper}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Width="22" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" Opacity="0"
                                                   Cursor="SizeAll" b:DnD.IsHandle="True" Background="Transparent" Padding="0,8" ToolTip="Drag to reorder" />
                                        <CheckBox x:Name="check" DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Visibility="{Binding DataContext.IsChecklist, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                        <Ellipse x:Name="bullet" DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource TextMutedBrush}" Margin="6,0,14,0" VerticalAlignment="Center"
                                                 Visibility="{Binding DataContext.IsChecklist, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        <Button x:Name="remove" DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" FontSize="9"
                                                Opacity="0" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Remove" Focusable="False" />
                                        <TextBox x:Name="text" Style="{StaticResource InlineTextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14.5" PreviewKeyDown="OnItemKeyDown" b:Ui.Placeholder="List item" />
                                    </DockPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="rowBg" Property="Opacity" Value="1" />
                                        <Setter TargetName="handle" Property="Opacity" Value="1" />
                                        <Setter TargetName="remove" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                        <Setter TargetName="text" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="text" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Code -->
            <DockPanel Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Copy" b:Ui.Icon="{x:Static core:Glyphs.Copy}" Command="{Binding CopyContentCommand}" MinHeight="32" />
                    <ComboBox Style="{StaticResource SmallCombo}" ItemsSource="{x:Static vm:NoteEditorViewModel.Languages}" SelectedItem="{Binding Note.Language}"
                              Width="170" HorizontalAlignment="Left" />
                </DockPanel>
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}">
                    <TextBox Style="{StaticResource InlineTextBox}" Text="{Binding Note.Content, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                             FontSize="13.5" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" Padding="14,12" VerticalContentAlignment="Top"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" b:Ui.Placeholder="Paste or type code…" SpellCheck.IsEnabled="False" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
