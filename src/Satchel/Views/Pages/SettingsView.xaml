<UserControl x:Class="Satchel.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:svc="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Title}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,24,0" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>

        <DataTemplate x:Key="ThemeCard" DataType="{x:Type svc:ThemeDefinition}">
            <Button x:Name="card" Style="{StaticResource CardButton}" Padding="0" Width="176" Margin="0,0,12,12"
                    Command="{Binding DataContext.SetThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}">
                <StackPanel>
                    <Border Height="100" Margin="6,6,6,0" CornerRadius="{DynamicResource RadiusSmall}" Background="{Binding BgPreview}" ClipToBounds="True">
                        <Grid>
                            <Border Width="36" HorizontalAlignment="Left" Background="{Binding SidebarPreview}" CornerRadius="6,0,0,6">
                                <StackPanel Margin="9,12,9,0">
                                    <Border Height="14" CornerRadius="4" Background="{Binding AccentPreview}" />
                                    <Border Height="5" CornerRadius="2" Background="{Binding MutedPreview}" Opacity="0.45" Margin="0,10,0,0" />
                                    <Border Height="5" CornerRadius="2" Background="{Binding MutedPreview}" Opacity="0.45" Margin="0,6,0,0" />
                                    <Border Height="5" CornerRadius="2" Background="{Binding MutedPreview}" Opacity="0.45" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Margin="46,12,10,12" Background="{Binding SurfacePreview}" CornerRadius="6" BorderBrush="{Binding StrokePreview}" BorderThickness="1">
                                <StackPanel Margin="9">
                                    <Border Height="6" Width="56" CornerRadius="3" Background="{Binding TextPreview}" HorizontalAlignment="Left" />
                                    <Border Height="5" Width="74" CornerRadius="3" Background="{Binding MutedPreview}" Margin="0,7,0,0" HorizontalAlignment="Left" Opacity="0.55" />
                                    <Border Height="5" Width="40" CornerRadius="3" Background="{Binding MutedPreview}" Margin="0,5,0,0" HorizontalAlignment="Left" Opacity="0.55" />
                                    <Border Height="14" Width="44" CornerRadius="4" Background="{Binding AccentPreview}" Margin="0,9,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <DockPanel Margin="12,8,12,10">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <Binding Path="IsDark" Converter="{StaticResource BoolToString}" ConverterParameter="Dark|Light" />
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock x:Name="check" Text="{x:Static core:Glyphs.Completed}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    </DockPanel>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource AllEqual}">
                            <Binding Path="Key" />
                            <Binding Path="DataContext.S.Theme" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="check" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Key bindings: a key cap you click, then press the keys into. -->
        <Style x:Key="KeyBox" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="156" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cap" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,1,1,2"
                                CornerRadius="6" Padding="10,0" SnapsToDevicePixels="True">
                            <TextBlock x:Name="text" Text="{Binding BoxText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasKeys}" Value="False">
                                <Setter TargetName="text" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                <Setter TargetName="text" Property="FontFamily" Value="{DynamicResource UiFont}" />
                                <Setter TargetName="cap" Property="Background" Value="Transparent" />
                                <Setter TargetName="cap" Property="BorderThickness" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cap" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter TargetName="cap" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="cap" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="cap" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="text" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter TargetName="text" Property="FontFamily" Value="{StaticResource MonoFont}" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="listening">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="text" Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.7"
                                                             AutoReverse="True" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="listening" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="KeyRowTemplate" DataType="{x:Type vm:KeyBindingRow}">
            <StackPanel>
                <DockPanel MinHeight="36" Background="Transparent" ToolTip="{Binding Tooltip}">
                    <Button x:Name="clear" DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" FontSize="11" Margin="4,0,0,0"
                            ToolTip="Remove these keys" Visibility="Hidden"
                            Command="{Binding DataContext.ClearKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource KeyBox}" ToolTip="Click, then press the keys (Esc to cancel)"
                            AutomationProperties.Name="{Binding Title}"
                            Click="OnKeyBoxClick" PreviewKeyDown="OnKeyBoxKeyDown" PreviewKeyUp="OnKeyBoxKeyUp" LostKeyboardFocus="OnKeyBoxLostFocus" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SidebarKeys}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                               VerticalAlignment="Center" Margin="8,0,10,0" Visibility="{Binding HasSidebarKeys, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Width="26" VerticalAlignment="Center" />
                    <TextBlock x:Name="hiddenLabel" DockPanel.Dock="Right" Text="hidden" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,10,0" Visibility="Collapsed" />
                    <TextBlock x:Name="title" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="message" Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="26,0,40,6"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanClear}" Value="True">
                    <Setter TargetName="clear" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="message" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Setter TargetName="hiddenLabel" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="KeyGroupTemplate" DataType="{x:Type vm:KeyBindingGroup}">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Overline}" Margin="0,0,0,2" />
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource KeyRowTemplate}" Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AccentSwatch" DataType="{x:Type vm:AccentChoice}">
            <Grid Width="38" Height="38" Margin="0,0,6,6" Cursor="Hand" Background="Transparent" ToolTip="{Binding Name}" MouseLeftButtonUp="OnAccentClick">
                <Ellipse x:Name="ring" Width="36" Height="36" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0" />
                <Ellipse Width="28" Height="28" Fill="{Binding Brush}" />
                <TextBlock x:Name="def" Text="A" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="{x:Null}">
                    <Setter TargetName="def" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource AllEqual}">
                            <Binding Path="Key" />
                            <Binding Path="DataContext.S.Accent" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="ring" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource SidePanel}" Width="220">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="10,4,0,16" />
                <RadioButton Style="{StaticResource SideItem}" GroupName="settingsNav" Content="Appearance" b:Ui.Icon="{x:Static core:Glyphs.Palette}"
                             IsChecked="{Binding ActiveSection, Converter={StaticResource Equals}, ConverterParameter=Appearance}" />
                <RadioButton Style="{StaticResource SideItem}" GroupName="settingsNav" Content="General" b:Ui.Icon="{x:Static core:Glyphs.Sliders}"
                             IsChecked="{Binding ActiveSection, Converter={StaticResource Equals}, ConverterParameter=General}" />
                <RadioButton Style="{StaticResource SideItem}" GroupName="settingsNav" Content="Key bindings" b:Ui.Icon="{x:Static core:Glyphs.Keyboard}"
                             IsChecked="{Binding ActiveSection, Converter={StaticResource Equals}, ConverterParameter=Bindings}" />
                <RadioButton Style="{StaticResource SideItem}" GroupName="settingsNav" Content="Keyboard shortcuts" b:Ui.Icon="{x:Static core:Glyphs.Help}"
                             IsChecked="{Binding ActiveSection, Converter={StaticResource Equals}, ConverterParameter=Keys}" />
                <RadioButton Style="{StaticResource SideItem}" GroupName="settingsNav" Content="Sidebar &amp; online" b:Ui.Icon="{x:Static core:Glyphs.Globe}"
                             IsChecked="{Binding ActiveSection, Converter={StaticResource Equals}, ConverterParameter=Online}" />
                <RadioButton Style="{StaticResource SideItem}" GroupName="settingsNav" Content="Security" b:Ui.Icon="{x:Static core:Glyphs.Shield}"
                             IsChecked="{Binding ActiveSection, Converter={StaticResource Equals}, ConverterParameter=Security}" />
                <RadioButton Style="{StaticResource SideItem}" GroupName="settingsNav" Content="Privacy" b:Ui.Icon="{x:Static core:Glyphs.Hide}"
                             IsChecked="{Binding ActiveSection, Converter={StaticResource Equals}, ConverterParameter=Privacy}" />
                <RadioButton Style="{StaticResource SideItem}" GroupName="settingsNav" Content="Data &amp; backup" b:Ui.Icon="{x:Static core:Glyphs.Database}"
                             IsChecked="{Binding ActiveSection, Converter={StaticResource Equals}, ConverterParameter=Data}" />
                <RadioButton Style="{StaticResource SideItem}" GroupName="settingsNav" Content="Updates" b:Ui.Icon="{x:Static core:Glyphs.Sync}"
                             IsChecked="{Binding ActiveSection, Converter={StaticResource Equals}, ConverterParameter=Updates}" />
                <RadioButton Style="{StaticResource SideItem}" GroupName="settingsNav" Content="About" b:Ui.Icon="{x:Static core:Glyphs.Info}"
                             IsChecked="{Binding ActiveSection, Converter={StaticResource Equals}, ConverterParameter=About}" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,4,28,40" MaxWidth="900" HorizontalAlignment="Left">

                <!-- ===== Appearance ===== -->
                <Border x:Name="Appearance" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Reset" Command="{Binding ResetAppearanceCommand}" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Make it yours. Changes apply instantly." Style="{StaticResource Muted}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" Margin="0,18,0,10" />
                        <ItemsControl ItemsSource="{Binding Themes}" ItemTemplate="{StaticResource ThemeCard}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Accent color" Style="{StaticResource FieldLabel}" Margin="0,10,0,10" />
                        <ItemsControl ItemsSource="{Binding Accents}" ItemTemplate="{StaticResource AccentSwatch}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBox Text="{Binding CustomAccent, UpdateSourceTrigger=PropertyChanged}" Width="210" b:Ui.Placeholder="Hex, e.g. #1E9E8A"
                                     FontFamily="{StaticResource MonoFont}" b:Ui.EnterCommand="{Binding ApplyCustomAccentCommand}" />
                            <Border Width="36" Height="36" CornerRadius="{DynamicResource RadiusSmall}" Margin="8,0,0,0" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                    Background="{Binding CustomAccent, Converter={StaticResource HexToBrush}}" />
                            <Button Content="Apply" Command="{Binding ApplyCustomAccentCommand}" Margin="8,0,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,22,0,6" />
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{x:Static vm:SettingsViewModel.Fonts}" SelectedItem="{Binding SelectedFont}" />
                            <StackPanel>
                                <TextBlock Text="Font" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Used across the interface." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="240">
                                <Slider Minimum="0.8" Maximum="1.4" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding S.UiScale}" Width="190" VerticalAlignment="Center" ValueChanged="OnScaleChanged" />
                                <TextBlock Text="{Binding ScaleText}" Margin="10,0,0,0" VerticalAlignment="Center" Width="40" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Interface size" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Scales everything — handy on small laptops or big monitors." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="240">
                                <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding S.CornerRadius}" Width="190" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding S.CornerRadius, StringFormat={}{0:0}px}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Corner roundness" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="From crisp and square to soft and round." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.AnimationsEnabled}" />
                            <StackPanel>
                                <TextBlock Text="Animations" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Gliding cards, page transitions and other motion." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.AmbientEffects}" />
                            <StackPanel>
                                <TextBlock Text="Ambient glow" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Slowly drifting accent light behind the lock screen." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.CardShadows}" />
                            <StackPanel>
                                <TextBlock Text="Card shadows" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Soft depth under cards. Turn off for a flatter look or on slower PCs." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.SidebarCollapsed}" />
                            <StackPanel>
                                <TextBlock Text="Compact sidebar" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Icons only — more room for your content." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ===== General ===== -->
                <Border x:Name="General" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Dates, start page and how things behave." Style="{StaticResource Muted}" Margin="0,0,0,10" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBox DockPanel.Dock="Right" Width="240" Text="{Binding S.UserName, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Your name" />
                            <StackPanel>
                                <TextBlock Text="Your name" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Used for the dashboard greeting." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{x:Static vm:SettingsViewModel.StartPages}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding S.StartPage}" />
                            <StackPanel>
                                <TextBlock Text="Start page" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="What opens after unlocking." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{x:Static vm:SettingsViewModel.Cultures}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding S.Culture}" />
                            <StackPanel>
                                <TextBlock Text="Date language" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Language for day and month names. Some labels refresh after a restart." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{x:Static vm:SettingsViewModel.DateFormats}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding S.DateFormat}" />
                            <StackPanel>
                                <TextBlock Text="Date format" Style="{StaticResource RowTitle}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="24-hour" IsChecked="{Binding S.Use24HourClock}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="12-hour" IsChecked="{Binding S.Use24HourClock, Converter={StaticResource Not}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Time format" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="Monday" IsChecked="{Binding S.WeekStartsMonday}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Sunday" IsChecked="{Binding S.WeekStartsMonday, Converter={StaticResource Not}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Week starts on" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.ShowTasksInCalendar}" />
                            <TextBlock Text="Show tasks with due dates in the calendar" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.ShowBirthdaysInCalendar}" />
                            <TextBlock Text="Show contact birthdays in the calendar" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.ReminderSound}" />
                            <StackPanel>
                                <TextBlock Text="Reminder sound" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Reminders appear while Satchel is open and unlocked." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Key bindings ===== -->
                <Border x:Name="Bindings" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Reset" b:Ui.Icon="{x:Static core:Glyphs.Undo}" VerticalAlignment="Top"
                                    Command="{Binding ResetKeysCommand}" IsEnabled="{Binding HasOwnKeys}" ToolTip="Back to the default keys" />
                            <StackPanel>
                                <TextBlock Text="Key bindings" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None"
                                           Text="Give your tabs the keys you want: click a box, then press the keys — Ctrl or Alt with a key, or a function key (F2–F12) on its own. Ctrl+1 … 9 follow the sidebar until you give one to a tab. Keys Satchel already uses, like Ctrl+K, stay as they are." />
                            </StackPanel>
                        </DockPanel>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="{DynamicResource RadiusSmall}" Padding="12,4" Margin="0,16,0,18">
                            <ContentControl Content="{Binding PrivacyKey}" ContentTemplate="{StaticResource KeyRowTemplate}" Focusable="False" />
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding KeyGroupsLeft}" ItemTemplate="{StaticResource KeyGroupTemplate}" Focusable="False" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding KeyGroupsRight}" ItemTemplate="{StaticResource KeyGroupTemplate}" Focusable="False" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Keyboard shortcuts ===== -->
                <Border x:Name="Keys" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cheat sheet" b:Ui.Icon="{x:Static core:Glyphs.Help}"
                                    Command="{Binding OpenCheatSheetCommand}" VerticalAlignment="Top" ToolTip="F1 or Ctrl+/" />
                            <StackPanel>
                                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding ShortcutsIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                        </DockPanel>
                        <TextBox Text="{Binding ShortcutQuery, UpdateSourceTrigger=PropertyChanged}" Width="380" HorizontalAlignment="Left" Margin="0,16,0,18"
                                 b:Ui.Placeholder="Find a shortcut — e.g. zoom, Ctrl+Shift, board" />
                        <Grid Visibility="{Binding HasShortcuts, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding ShortcutsLeft}" ItemTemplate="{StaticResource ShortcutGroupTemplate}" Focusable="False" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding ShortcutsRight}" ItemTemplate="{StaticResource ShortcutGroupTemplate}" Focusable="False" />
                        </Grid>
                        <TextBlock Text="No shortcut matches that." Style="{StaticResource Muted}"
                                   Visibility="{Binding HasShortcuts, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>

                <!-- ===== Sidebar & online ===== -->
                <Border x:Name="Online" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Sidebar &amp; online" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Choose the tabs you want to see, and what may use the internet." Style="{StaticResource Muted}" Margin="0,0,0,10" />
                        <DockPanel Margin="0,8,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Content="Show all" Command="{Binding ShowAllTabsCommand}" Margin="0,0,6,0" />
                                <Button Content="Change order…" b:Ui.Icon="{x:Static core:Glyphs.Sort}" Command="{Binding ReorderTabsCommand}" />
                            </StackPanel>
                            <TextBlock Text="Tabs in the sidebar" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Hidden tabs keep their data and stay reachable from search (Ctrl+K)." Style="{StaticResource RowDesc}" Margin="0,-4,0,10" />
                        <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}" IsChecked="{Binding IsVisible}" Margin="0,0,8,8"
                                                  MinHeight="32" Padding="12,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.ShowSectionHeaders}" />
                            <StackPanel>
                                <TextBlock Text="Section headers" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Group the sidebar into Organize, Keep, Create… Turn off to order every tab freely." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.OnlineFeatures}" />
                            <StackPanel>
                                <TextBlock Text="Online features" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="YouTube channel updates, link previews on boards, and book, game and cover lookups. Turn off to keep Satchel completely offline."
                                           Style="{StaticResource RowDesc}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{x:Static vm:SettingsViewModel.VideoIntervals}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding S.VideoCheckMinutes}" />
                            <StackPanel>
                                <TextBlock Text="Check followed channels" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="While Satchel is open and unlocked." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.VideoNotify}" />
                            <TextBlock Text="Notify me about new videos" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.VideoPlayInApp}" />
                            <StackPanel>
                                <TextBlock Text="Play videos inside Satchel" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Uses Microsoft Edge WebView2 (built into Windows 11). Its cache is kept in the Data folder on the drive." Style="{StaticResource RowDesc}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.BlockVideoAds}" />
                            <StackPanel>
                                <TextBlock Text="Block ads in the player" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="For videos, music and the board's study panel: ad and tracking requests are refused, and any ad that still starts is muted and skipped. Applies to players opened after the change."
                                           Style="{StaticResource RowDesc}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{x:Static vm:SettingsViewModel.FeedIntervals}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding S.FeedCheckMinutes}" />
                            <StackPanel>
                                <TextBlock Text="Check feeds and podcasts" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="While Satchel is open and unlocked." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.FeedNotify}" />
                            <TextBlock Text="Notify me about new posts and episodes" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Content="Clear player data" b:Ui.Icon="{x:Static core:Glyphs.Delete}" Command="{Binding ClearPlayerDataCommand}" />
                            <StackPanel>
                                <TextBlock Text="Video player data" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Removes the player's cache and cookies. Saved videos and notes are not affected." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Security ===== -->
                <Border x:Name="Security" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Lock now" b:Ui.Icon="{x:Static core:Glyphs.Lock}" Command="{Binding LockNowCommand}" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Security" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding PasswordChangedText}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="{DynamicResource RadiusSmall}" Padding="14,12" Margin="0,16,0,6">
                            <DockPanel>
                                <TextBlock Text="{x:Static core:Glyphs.Shield}" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                           Text="Everything you store is encrypted with AES-256-GCM. The key is derived from your master password (PBKDF2-SHA256, 600,000 rounds) and only lives in memory while unlocked. Settings like your theme are the only thing stored unencrypted." />
                            </DockPanel>
                        </Border>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{x:Static vm:SettingsViewModel.AutoLockChoices}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding S.AutoLockMinutes}" />
                            <StackPanel>
                                <TextBlock Text="Auto-lock" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Lock after this long without using Satchel." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{x:Static vm:SettingsViewModel.ClipboardChoices}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding S.ClipboardClearSeconds}" />
                            <StackPanel>
                                <TextBlock Text="Clear copied secrets" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Passwords and codes are removed from the clipboard (and kept out of clipboard history)." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.LockOnSessionLock}" />
                            <TextBlock Text="Lock when Windows locks (Win+L)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.LockOnMinimize}" />
                            <TextBlock Text="Lock when minimized" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox Width="200" Text="{Binding Hint, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="No hint" />
                                <Button Content="Save" Command="{Binding SaveHintCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Password hint" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Shown on the lock screen. Stored unencrypted — keep it vague." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,8,0,14" />
                        <WrapPanel>
                            <Button Content="Change master password…" b:Ui.Icon="{x:Static core:Glyphs.Key}" Command="{Binding ChangePasswordCommand}" Margin="0,0,10,8" />
                            <Button Content="Create a new recovery key…" b:Ui.Icon="{x:Static core:Glyphs.Refresh}" Command="{Binding NewRecoveryKeyCommand}" Margin="0,0,10,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Privacy ===== -->
                <Border x:Name="Privacy" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Privacy" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Mark anything private — a note, a notebook, a board, a game, a vault profile — from its menu. Private items are left out of every list, search and widget until you show them. Items inside a private notebook, board or profile are hidden with it."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowPrivate}" />
                            <StackPanel>
                                <TextBlock Text="Show private items" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding PrivacyKeyText}" Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.HidePrivateOnUnlock}" />
                            <StackPanel>
                                <TextBlock Text="Hide private items again every time I unlock" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="So they're never on screen when you open Satchel in front of someone." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.PrivateNeedsPassword}" />
                            <StackPanel>
                                <TextBlock Text="Ask for the master password to show them" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Showing private items then needs your password, even while Satchel is unlocked." Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Data ===== -->
                <Border x:Name="Data" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Data &amp; backup" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding DriveText}" Style="{StaticResource Muted}" />
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="{DynamicResource RadiusSmall}" Padding="14,12" Margin="0,16,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open folder" b:Ui.Icon="{x:Static core:Glyphs.FolderOpen}" Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}"><Run Text="satchel.db" /><Run Text="  ·  " /><Run Text="{Binding DatabaseSize, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DatabaseFile}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DockPanel Style="{StaticResource Row}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ComboBox Width="110" ItemsSource="{x:Static vm:SettingsViewModel.KeepChoices}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          SelectedValue="{Binding S.BackupKeepCount}" Margin="0,0,12,0" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding S.AutoBackup}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Daily automatic backup" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel Margin="0,4,0,8">
                            <Button Style="{StaticResource AccentButton}" Content="Back up now" b:Ui.Icon="{x:Static core:Glyphs.Save}" Command="{Binding BackupNowCommand}" Margin="0,0,10,8" />
                            <Button Content="Restore from file…" b:Ui.Icon="{x:Static core:Glyphs.History}" Command="{Binding RestoreFromFileCommand}" Margin="0,0,10,8" />
                            <Button Style="{StaticResource GhostButton}" Content="Backups folder" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,10,8" />
                            <Button Style="{StaticResource GhostButton}" Content="Compact database" Command="{Binding CompactCommand}" Margin="0,0,10,8" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Backups}" Focusable="False" Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:BackupInfo}">
                                    <Grid x:Name="row" Background="Transparent" MinHeight="40">
                                        <Border x:Name="hover" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource HoverOverlayBrush}" Opacity="0" Margin="-10,0" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Restore" FontSize="12" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0" Width="100" />
                                            <TextBlock Text="{x:Static core:Glyphs.Database}" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CreatedText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hover" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />
                        <TextBlock Text="Import &amp; export" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Exports are NOT encrypted — handle them carefully and delete them when done." Style="{StaticResource RowDesc}" Margin="0,2,0,10" />
                        <WrapPanel>
                            <Button Content="Import passwords (CSV)" b:Ui.Icon="{x:Static core:Glyphs.Import}" Command="{Binding GoImportCommand}" CommandParameter="Vault" Margin="0,0,8,8" />
                            <Button Content="Import calendar (.ics)" b:Ui.Icon="{x:Static core:Glyphs.Import}" Command="{Binding GoImportCommand}" CommandParameter="Calendar" Margin="0,0,8,8" />
                            <Button Content="Import contacts (.vcf)" b:Ui.Icon="{x:Static core:Glyphs.Import}" Command="{Binding GoImportCommand}" CommandParameter="Contacts" Margin="0,0,8,8" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource GhostButton}" Content="Export notes (Markdown)" b:Ui.Icon="{x:Static core:Glyphs.Export}" Command="{Binding ExportNotesCommand}" Margin="0,0,8,8" />
                            <Button Style="{StaticResource GhostButton}" Content="Export calendar (.ics)" b:Ui.Icon="{x:Static core:Glyphs.Export}" Command="{Binding GoExportCommand}" CommandParameter="Calendar" Margin="0,0,8,8" />
                            <Button Style="{StaticResource GhostButton}" Content="Export contacts (.vcf)" b:Ui.Icon="{x:Static core:Glyphs.Export}" Command="{Binding GoExportCommand}" CommandParameter="Contacts" Margin="0,0,8,8" />
                            <Button Style="{StaticResource GhostButton}" Content="Export passwords (CSV)" b:Ui.Icon="{x:Static core:Glyphs.Export}" Command="{Binding GoExportCommand}" CommandParameter="Vault" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== About ===== -->
                <!-- ===== Updates ===== -->
                <Border x:Name="Updates" Style="{StaticResource SectionCard}" DataContext="{Binding Updates}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Check for updates" b:Ui.Icon="{x:Static core:Glyphs.Refresh}" Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}" />
                                <Button Style="{StaticResource AccentButton}" Content="{Binding InstallText}" b:Ui.Icon="{x:Static core:Glyphs.Download}" Command="{Binding InstallCommand}"
                                        IsEnabled="{Binding CanInstall}" Visibility="{Binding HasAvailable, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0"
                                        ToolTip="Downloads the new version, checks it, makes a backup of your data and restarts Satchel" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastCheckedText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SubtleBrush}"
                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock x:Name="UpdateStatusIcon" DockPanel.Dock="Left" Text="{x:Static core:Glyphs.Info}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelDownloadCommand}" />
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="6" Margin="0,6,0,0" />
                        </StackPanel>

                        <DockPanel Margin="0,12,0,0" Visibility="{Binding OnlineOff, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Content="Turn on online features" Command="{Binding TurnOnOnlineCommand}" />
                            <TextBlock Text="Online features are off (Sidebar &amp; online), so Satchel doesn't contact GitHub." Style="{StaticResource RowDesc}" VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource Row}" Margin="0,14,0,10">
                            <TextBox DockPanel.Dock="Right" Width="260" Text="{Binding RepositoryText, UpdateSourceTrigger=PropertyChanged, Delay=400}" b:Ui.Placeholder="owner/name"
                                     VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="GitHub repository" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding RepositoryHint}" Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.CheckUpdatesOnStart}" />
                            <StackPanel>
                                <TextBlock Text="Check for updates automatically" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Once a day, after you unlock, Satchel asks GitHub whether there's a newer version and tells you. It never installs anything without asking."
                                           Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,18,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="All releases on GitHub" Command="{Binding OpenReleasesCommand}" FontSize="12.5" />
                            <TextBlock Text="What's new" Style="{StaticResource RowTitle}" FontSize="15" />
                        </DockPanel>
                        <TextBlock Text="The notes of each version appear here after a check." Style="{StaticResource RowDesc}"
                                   Visibility="{Binding HasFeed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Feed}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ReleaseItem}">
                                    <Border x:Name="card" Margin="0,0,0,10" Padding="16,12,16,10" CornerRadius="{DynamicResource RadiusSmall}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="{x:Static core:Glyphs.OpenExternal}"
                                                        ToolTip="Open on GitHub" Margin="6,-4,-6,0" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.OpenReleaseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0,0,10,0" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Installed" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
                                                </Border>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0,0,10,0" Background="{DynamicResource AccentBrush}"
                                                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="New" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel x:Name="line" Margin="0,2,0,2">
                                                            <TextBlock x:Name="bullet" DockPanel.Dock="Left" Text="•" Width="14" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
                                                            <TextBlock x:Name="text" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                        </DockPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                                                <Setter TargetName="text" Property="FontWeight" Value="SemiBold" />
                                                                <Setter TargetName="line" Property="Margin" Value="0,8,0,2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Bullet">
                                                                <Setter TargetName="bullet" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="1">
                                                                <Setter TargetName="line" Property="Margin" Value="16,2,0,2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="2">
                                                                <Setter TargetName="line" Property="Margin" Value="32,2,0,2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                                <Setter TargetName="text" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="About" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel>
                            <c:LogoMark Size="56" VerticalAlignment="Top" />
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppName}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · Your portable organizer" /></TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,14,0,0"
                                   Text="Notes, tasks, calendar, contacts, a sticky-note board and an encrypted password vault — in one folder you can carry on a flash drive. No accounts, no cloud, no installation. Copy the whole folder (with its Data subfolder) to move or back up everything." />
                        <Button Style="{StaticResource LinkButton}" Content="See all keyboard shortcuts" Command="{Binding GoToSectionCommand}" CommandParameter="Keys"
                                HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
