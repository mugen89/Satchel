<UserControl x:Class="Satchel.Views.Pages.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== List ===== -->
        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0" Padding="20,0,12,16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,4,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="New" b:Ui.Icon="{x:Static core:Glyphs.AddPerson}"
                            Command="{Binding NewContactCommand}" ToolTip="New contact (Ctrl+N)" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Contacts" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" people" /></TextBlock>
                    </StackPanel>
                </DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch" Margin="0,0,4,10">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource Segment}" Content="All" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Favorites" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Favorites}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Birthdays" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Birthdays}" />
                    </UniformGrid>
                </Border>
                <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         b:Ui.Placeholder="Search people" Margin="0,0,4,12" MinHeight="36" b:Ui.EscapeCommand="{Binding ClearSearchCommand}" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6,10,0,0">
                    <Button Style="{StaticResource LinkButton}" Content="Import vCard" Command="{Binding ImportVcfCommand}" FontSize="12" />
                    <TextBlock Text="  ·  " Style="{StaticResource Caption}" />
                    <Button Style="{StaticResource LinkButton}" Content="Export vCard" Command="{Binding ExportVcfCommand}" FontSize="12" />
                </StackPanel>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ContactGroup}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Letter}" Style="{StaticResource Overline}" Margin="10,6,0,4" />
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:Contact}">
                                                    <Grid>
                                                        <Border x:Name="sel" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource AccentSubtleBrush}" Opacity="0" />
                                                        <Button Style="{StaticResource RowButton}" Padding="10,7"
                                                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <DockPanel>
                                                                <c:Avatar Image="{Binding Image}" Text="{Binding FullName}" ColorKey="{Binding Color}" Size="36" Roundness="-1" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.StarFilled}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                                                <StackPanel Margin="12,0,6,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Button>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource SameObject}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.Selected" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="sel" Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="No one here yet." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,40,0,0"
                               Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Detail ===== -->
        <Grid Grid.Column="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Visibility="{Binding HasContacts, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Border Style="{StaticResource EmptyIcon}" Width="88" Height="88" CornerRadius="44">
                    <TextBlock Text="{x:Static core:Glyphs.People}" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <TextBlock Text="Your address book" Style="{StaticResource Title}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Keep phone numbers, emails, addresses and birthdays — birthdays show up on your calendar and dashboard." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="Add a contact" b:Ui.Icon="{x:Static core:Glyphs.AddPerson}" Command="{Binding NewContactCommand}" />
                    <Button Content="Import vCard" Command="{Binding ImportVcfCommand}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel x:Name="Detail" Margin="28,8,28,28" MaxWidth="820" HorizontalAlignment="Stretch">
                    <Grid>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusLarge}" Effect="{DynamicResource CardShadow}" />
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusLarge}"
                                Padding="26,24" ClipToBounds="True">
                            <Grid>
                                <Border Height="80" Margin="-26,-24,-26,0" VerticalAlignment="Top" Opacity="0.6"
                                        Background="{Binding Selected.Color, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}" />
                                <DockPanel>
                                    <c:Avatar Image="{Binding Selected.Image}" Text="{Binding Selected.FullName}" ColorKey="{Binding Selected.Color}" Size="92" Roundness="-1" Solid="True" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFavoriteCommand}" ToolTip="Favorite">
                                            <Button.Content>
                                                <Binding Path="Selected.IsFavorite" Converter="{StaticResource BoolToString}" ConverterParameter="&#xE735;|&#xE734;" />
                                            </Button.Content>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Copy}" Command="{Binding CopyAllCommand}" ToolTip="Copy contact details" />
                                        <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Edit}" Command="{Binding EditContactCommand}" ToolTip="Edit" />
                                        <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Hide}" Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding Selected}"
                                                ToolTip="{Binding Selected.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}" />
                                        <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Delete}" Command="{Binding DeleteContactCommand}" ToolTip="Delete" />
                                    </StackPanel>
                                    <StackPanel Margin="22,22,0,0">
                                        <TextBlock Text="{Binding Selected.FullName}" Style="{StaticResource PageTitle}" FontSize="26" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Selected.Subtitle}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Selected.Nickname, StringFormat=“{0}”}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                   Visibility="{Binding Selected.Nickname, Converter={StaticResource HasValueToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,12" Visibility="{Binding Rows.Count, Converter={StaticResource HasValueToVis}}">
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FieldRow}">
                                    <Grid x:Name="row" Background="Transparent" MinHeight="44">
                                        <Border x:Name="hover" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource HoverOverlayBrush}" Opacity="0" Margin="-10,2" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentTextBrush}" Width="20" />
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="value" Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8" FontSize="14.5" />
                                            <StackPanel x:Name="actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.55">
                                                <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.OpenExternal}" Command="{Binding OpenCommand}" ToolTip="Open"
                                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Copy}" Command="{Binding CopyCommand}" ToolTip="Copy" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hover" Property="Opacity" Value="1" />
                                            <Setter TargetName="actions" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsUrl}" Value="True">
                                            <Setter TargetName="value" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding SelectedHasNotes, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Notes" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Selected.Notes, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InlineTextBox}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding SelectedTags}" ItemTemplate="{StaticResource TagChip}" Margin="2,14,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
