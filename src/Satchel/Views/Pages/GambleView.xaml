<UserControl x:Class="Satchel.Views.Pages.GambleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Satchel.Core">
    <!-- Placeholder: trading and bets come in a later update. -->
    <DockPanel Margin="28,0,28,28">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Gamble" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Trading and bets" Style="{StaticResource Muted}" Margin="0,2,0,0" />
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="40,36" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <StackPanel HorizontalAlignment="Center">
                <Border Style="{StaticResource EmptyIcon}">
                    <TextBlock Text="{x:Static core:Glyphs.Market}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <TextBlock Text="Coming in a later update" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None"
                           Text="This tab will be the home for trading and bets. It's a placeholder for now, so the space is ready when the features arrive." />
                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Margin="0,14,0,0"
                           Text="Don't need it yet? Hide it in Settings → Sidebar &amp; online." />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
