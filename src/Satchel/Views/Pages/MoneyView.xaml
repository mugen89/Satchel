<UserControl x:Class="Satchel.Views.Pages.MoneyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="FilterChip" TargetType="RadioButton" BasedOn="{StaticResource ChipRadio}">
            <Setter Property="GroupName" Value="mf" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,24,28">
                <DockPanel Margin="0,4,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="170" ItemsSource="{x:Static vm:MoneyViewModel.Currencies}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,0,10,0"
                                  SelectedValue="{Binding MainCurrency, Mode=OneWay}" ToolTip="Main currency for totals and new items" SelectionChanged="OnCurrencyChanged" />
                        <Button Style="{StaticResource AccentButton}" Content="Add" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddCommand}" ToolTip="Add a subscription or bill (Ctrl+N)" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Money" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Subscriptions and bills — what they cost and what's due next." Style="{StaticResource Muted}" />
                    </StackPanel>
                </DockPanel>

                <!-- totals -->
                <UniformGrid Rows="1" Margin="0,0,-12,18">
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="Per month" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding MonthlyText}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="Per year" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding YearlyText}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="Next 30 days" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Next30Text}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="Active" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ActiveCount}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding Totals}" Focusable="False" Margin="0,-8,0,14" Visibility="{Binding HasSeveralCurrencies, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MoneyTotal}">
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,18,0"><Run Text="{Binding Currency, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Monthly, Mode=OneWay}" /><Run Text=" / month · " /><Run Text="{Binding Yearly, Mode=OneWay}" /><Run Text=" / year" /></TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- list -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Style="{StaticResource FilterChip}" Content="Active" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=active, Mode=OneWay}"
                                         Command="{Binding SetFilterCommand}" CommandParameter="active" />
                            <RadioButton Style="{StaticResource FilterChip}" Content="Subscriptions" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=subscriptions, Mode=OneWay}"
                                         Command="{Binding SetFilterCommand}" CommandParameter="subscriptions" />
                            <RadioButton Style="{StaticResource FilterChip}" Content="Bills" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=bills, Mode=OneWay}"
                                         Command="{Binding SetFilterCommand}" CommandParameter="bills" />
                            <RadioButton Style="{StaticResource FilterChip}" Content="Due soon" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=soon, Mode=OneWay}"
                                         Command="{Binding SetFilterCommand}" CommandParameter="soon" />
                            <RadioButton Style="{StaticResource FilterChip}" Content="Cancelled" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=cancelled, Mode=OneWay}"
                                         Command="{Binding SetFilterCommand}" CommandParameter="cancelled" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:AnimatedStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Subscription}">
                                    <Button Style="{StaticResource CardButton}" Padding="14,10" Margin="0,0,0,8" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Margin="0,0,14,0"
                                                    Background="{Binding Color, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{Binding Color, Converter={StaticResource PaletteBrush}}" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Paid" b:Ui.Icon="{x:Static core:Glyphs.Check}" Margin="12,0,0,0"
                                                    ToolTip="Log the payment and move to the next due date" VerticalAlignment="Center"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.MarkPaidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding AmountDisplay}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Right" />
                                                <TextBlock x:Name="due" Text="{Binding DueText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding CycleText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Category, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDueSoon}" Value="True">
                                            <Setter TargetName="due" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter TargetName="due" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Nothing here." Style="{StaticResource Muted}" Margin="4,8" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>

                    <!-- side cards -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Coming up" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Upcoming}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:UpcomingPayment}">
                                            <Button Style="{StaticResource RowButton}" Padding="8,6" Margin="-8,0" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.SelectUpcomingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding Item.Color, Converter={StaticResource PaletteBrush}}" Margin="0,0,10,0" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AmountDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Item.Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DayText}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nothing due in the next weeks." Style="{StaticResource Muted}" Visibility="{Binding Upcoming.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding Categories.Count, Converter={StaticResource HasValueToVis}}">
                            <StackPanel>
                                <TextBlock Text="Where it goes each month" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                                <c:DonutChart Slices="{Binding Categories}" CenterText="{Binding MonthlyText}" CenterCaption="per month" Height="170" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type c:ChartSlice}">
                                            <DockPanel Margin="0,0,0,5">
                                                <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" b:Motion.Enter="True">
                    <Border Style="{StaticResource EmptyIcon}">
                        <TextBlock Text="{x:Static core:Glyphs.Card}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <TextBlock Text="Know where the money goes" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="Add your subscriptions and bills — see the monthly total, get reminded before they're due, link the login from the Vault." Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Detail ===== -->
        <Border Grid.Column="1" Width="380" Style="{StaticResource DetailPanel}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,14,14,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" ToolTip="More">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding Selected.IsActive, Converter={StaticResource BoolToString}, ConverterParameter='Mark as cancelled|Reactivate'}" Icon="{x:Static core:Glyphs.Power}"
                                              Command="{Binding ToggleActiveCommand}" />
                                    <MenuItem Header="{Binding Selected.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}"
                                              Icon="{x:Static core:Glyphs.Hide}" Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding Selected}" />
                                    <Separator />
                                    <MenuItem Header="Delete" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CloseDetailCommand}" ToolTip="Close" />
                    </StackPanel>
                    <TextBlock Text="{Binding Selected.Kind, Converter={StaticResource Humanize}}" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,10,20,24" DataContext="{Binding Selected}">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineTextBox}" FontSize="19" FontWeight="SemiBold" b:Ui.Placeholder="Name" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=LostFocus}" MinHeight="34" FontSize="16" b:Ui.SelectAllOnFocus="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Currency" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                <ComboBox IsEditable="True" Text="{Binding Currency, UpdateSourceTrigger=LostFocus}" ItemsSource="{x:Static vm:MoneyViewModel.Currencies}" DisplayMemberPath="Value"
                                          MinHeight="34" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Use a dot for decimals (12.99)." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="How often" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static vm:MoneyViewModel.Cycles}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Cycle}" MinHeight="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Next due" Style="{StaticResource FieldLabel}" />
                                <c:DateBox SelectedDate="{Binding NextDue}" AllowClear="False" KeepTime="False" MinHeight="34" />
                            </StackPanel>
                        </Grid>
                        <DockPanel Margin="0,8,0,0" Visibility="{Binding Cycle, Converter={StaticResource EqualsToVis}, ConverterParameter=EveryNDays}">
                            <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding CycleDays, UpdateSourceTrigger=LostFocus}" Width="70" MinHeight="32" />
                            <TextBlock Text="days" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </DockPanel>
                        <Button Style="{StaticResource AccentButton}" Content="Mark this payment as paid" b:Ui.Icon="{x:Static core:Glyphs.Check}" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                Command="{Binding DataContext.MarkPaidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" HorizontalAlignment="Center"><Run Text="≈ " /><Run Text="{Binding MonthlyCost, Mode=OneWay, StringFormat={}{0:#,0.00}}" /><Run Text=" a month · " /><Run Text="{Binding YearlyCost, Mode=OneWay, StringFormat={}{0:#,0}}" /><Run Text=" a year" /></TextBlock>

                        <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{x:Static vm:MoneyViewModel.Kinds}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Kind}" MinHeight="32" />
                        <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                        <ComboBox IsEditable="True" Text="{Binding Category, UpdateSourceTrigger=LostFocus}"
                                  ItemsSource="{Binding DataContext.CategoryNames, RelativeSource={RelativeSource AncestorType=UserControl}}" MinHeight="32" />
                        <TextBlock Text="Remind me" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{x:Static vm:MoneyViewModel.RemindChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RemindDays}" MinHeight="32" />
                        <DockPanel Margin="0,12,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoPay}" />
                            <TextBlock Text="Paid automatically (card / direct debit)" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="Login" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Link…" Command="{Binding DataContext.LinkVaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0" />
                            <Button Style="{StaticResource SubtleAccentButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" b:Ui.Icon="{x:Static core:Glyphs.Shield}"
                                    Command="{Binding DataContext.OpenVaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="{Binding VaultName, TargetNullValue='No Vault login linked'}" IsEnabled="{Binding VaultName, Converter={StaticResource HasValue}}" />
                        </DockPanel>
                        <TextBlock Text="Website" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.OpenExternal}" ToolTip="Open"
                                    Command="{Binding DataContext.OpenWebsiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Account or billing page" MinHeight="32" />
                        </DockPanel>
                        <TextBlock Text="Payment method" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="e.g. Visa ·· 4242" MinHeight="32" />
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="60" b:Ui.Placeholder="Plan, contract end, how to cancel…" />
                        <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" />
                        <c:ColorSwatches SelectedKey="{Binding Color}" SwatchSize="20" />

                        <TextBlock Text="Payments" Style="{StaticResource Overline}" Margin="0,18,0,6" />
                        <ItemsControl ItemsSource="{Binding DataContext.Payments, RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Payment}">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Delete}" FontSize="10" ToolTip="Remove"
                                                Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Date, Converter={StaticResource DateFormat}}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
