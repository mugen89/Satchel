<UserControl x:Class="Satchel.Views.Pages.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:vp="clr-namespace:Satchel.Views.Pages"
             xmlns:vm="clr-namespace:Satchel.ViewModels"
             xmlns:s="clr-namespace:Satchel.Services"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="StickyThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StickyButton" TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
            <Setter Property="Foreground" Value="#99000000" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E6000000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Buttons over photos/thumbnails: light glyph on a dark chip -->
        <Style x:Key="OverlayButton" TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#8C000000" />
        </Style>

        <!-- Small round handle on a note's edge: drag it onto another note to connect them -->
        <Style x:Key="ConnectHandle" TargetType="Ellipse">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,-7,0" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Cursor" Value="Cross" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ToolTip" Value="Drag onto another note to connect" />
        </Style>

        <!-- Shown on cards marked private (visible only while private items are shown) -->
        <Style x:Key="PrivateChip" TargetType="ContentControl">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Private" />
            <Setter Property="Visibility" Value="{Binding IsPrivate, Converter={StaticResource BoolToVis}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Padding="6,3" CornerRadius="9" Background="#A6000000">
                            <TextBlock Text="{x:Static core:Glyphs.Hide}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- ===== Text note ===== -->
        <DataTemplate x:Key="TextSticky" DataType="{x:Type m:StickyNote}">
            <Grid x:Name="sticky" Width="{Binding Width}" Height="{Binding Height}" RenderTransformOrigin="0.5,0.5"
                  PreviewMouseLeftButtonDown="OnStickyMouseDown">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scale" />
                        <RotateTransform Angle="{Binding Rotation}" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Border x:Name="shadow" CornerRadius="3,3,3,18" Background="{Binding Color, Converter={StaticResource PaletteBrush}, ConverterParameter=sticky}"
                        Effect="{DynamicResource LiftShadow}" Opacity="0.55" Margin="2,4,2,0" />
                <Border x:Name="body" CornerRadius="3,3,3,18" Background="{Binding Color, Converter={StaticResource PaletteBrush}, ConverterParameter=sticky}" ClipToBounds="True">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="28" Background="#0F000000" x:Name="header">
                            <Thumb Style="{StaticResource StickyThumb}" Cursor="SizeAll" DragStarted="OnDragStarted" DragDelta="OnDragDelta" DragCompleted="OnDragCompleted"
                                   MouseDoubleClick="OnTextHeaderDoubleClick" ToolTip="Drag to move · double-click to open large" />
                            <TextBlock Text="{x:Static core:Glyphs.Hide}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#8C000000" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}" />
                            <StackPanel x:Name="tools" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0" Opacity="0">
                                <Button Style="{StaticResource StickyButton}" Content="{x:Static core:Glyphs.FullScreen}" Click="OnOpenLarge" ToolTip="Open large, with the full toolbar" />
                                <Button Style="{StaticResource StickyButton}" Content="{x:Static core:Glyphs.More}" Click="OnStickyMenu" ToolTip="Colour, size, pin…" />
                                <Button Style="{StaticResource StickyButton}" Content="{x:Static core:Glyphs.Delete}" ToolTip="Delete"
                                        Command="{Binding DataContext.DeleteStickyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="10,0,0,8" Padding="8,2" Cursor="Hand" ToolTip="Play the video from here"
                                Visibility="{Binding HasTimeLink, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.PlayTimeLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="chip" Background="#26000000" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="chip" Property="Background" Value="#E6E53935" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static core:Glyphs.Play}" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#262626" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding TimeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#262626" FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                        </Button>
                        <Grid>
                            <c:RichTextEditor x:Name="editor" ShowToolbar="False" ContentText="{Binding Content}" PlainText="{Binding Text}"
                                              EditorFontSize="{Binding EffectiveFontSize}" EditorForeground="#262626" EditorPadding="12,2,12,12"
                                              GotKeyboardFocus="OnEditorFocus" LostKeyboardFocus="OnEditorBlur" />
                            <TextBlock x:Name="placeholder" Text="Write something…" Foreground="#73262626" FontSize="{Binding EffectiveFontSize}" Margin="17,2,14,0"
                                       IsHitTestVisible="False" Visibility="{Binding Text, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                        </Grid>
                    </DockPanel>
                </Border>
                <Thumb Style="{StaticResource StickyThumb}" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                       DragDelta="OnResizeDelta" ToolTip="Resize" />
                <Path x:Name="grip" Data="M 12,4 L 4,12 M 12,8 L 8,12" Stroke="#55000000" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,5,5" IsHitTestVisible="False" Opacity="0" />
                <Ellipse x:Name="handle" Style="{StaticResource ConnectHandle}" MouseLeftButtonDown="OnConnectHandleDown" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="sticky" Property="IsMouseOver" Value="True">
                    <Setter TargetName="tools" Property="Opacity" Value="1" />
                    <Setter TargetName="grip" Property="Opacity" Value="1" />
                    <Setter TargetName="handle" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="editor" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="placeholder" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <DataTrigger Binding="{Binding DataContext.IsCork, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="header" Property="Background" Value="Transparent" />
                    <Setter TargetName="body" Property="CornerRadius" Value="1" />
                    <Setter TargetName="shadow" Property="CornerRadius" Value="1" />
                    <Setter TargetName="handle" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Image note (polaroid) ===== -->
        <DataTemplate x:Key="ImageSticky" DataType="{x:Type m:StickyNote}">
            <Grid x:Name="sticky" Width="{Binding Width}" Height="{Binding Height}" RenderTransformOrigin="0.5,0.5"
                  PreviewMouseLeftButtonDown="OnStickyMouseDown">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scale" />
                        <RotateTransform Angle="{Binding Rotation}" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Border x:Name="shadow" CornerRadius="6" Background="#FBFBF8" Effect="{DynamicResource LiftShadow}" Opacity="0.55" Margin="2,4,2,0" />
                <Border x:Name="body" CornerRadius="6" Background="#FBFBF8" Padding="10,10,10,0">
                    <DockPanel>
                        <TextBox x:Name="caption" DockPanel.Dock="Bottom" Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineTextBox}"
                                 Height="40" TextAlignment="Center" VerticalContentAlignment="Center" Foreground="#3A3A3A" CaretBrush="#3A3A3A" FontSize="14"
                                 b:Ui.Placeholder="Add a caption" />
                        <Border x:Name="photo" CornerRadius="3" ClipToBounds="True" Background="#E6E5E0">
                            <Image Source="{Binding Image, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </DockPanel>
                </Border>
                <Thumb Style="{StaticResource StickyThumb}" Margin="0,0,0,40" Cursor="SizeAll" DragStarted="OnDragStarted" DragDelta="OnDragDelta" DragCompleted="OnDragCompleted"
                       MouseDoubleClick="OnImageDoubleClick" ToolTip="Drag to move · double-click to enlarge" />
                <ContentControl Style="{StaticResource PrivateChip}" Margin="16,16,0,0" />

                <StackPanel x:Name="tools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Opacity="0">
                    <Button Style="{StaticResource OverlayButton}" Content="{x:Static core:Glyphs.More}" Click="OnStickyMenu" ToolTip="Pin, duplicate…" Margin="0,0,4,0" />
                    <Button Style="{StaticResource OverlayButton}" Content="{x:Static core:Glyphs.Delete}" ToolTip="Delete"
                            Command="{Binding DataContext.DeleteStickyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
                <Thumb Style="{StaticResource StickyThumb}" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                       DragDelta="OnResizeDelta" ToolTip="Resize" />
                <Path x:Name="grip" Data="M 12,4 L 4,12 M 12,8 L 8,12" Stroke="#55000000" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,5,5" IsHitTestVisible="False" Opacity="0" />
                <Ellipse x:Name="handle" Style="{StaticResource ConnectHandle}" MouseLeftButtonDown="OnConnectHandleDown" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="sticky" Property="IsMouseOver" Value="True">
                    <Setter TargetName="tools" Property="Opacity" Value="1" />
                    <Setter TargetName="grip" Property="Opacity" Value="1" />
                    <Setter TargetName="handle" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding DataContext.IsCork, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="body" Property="CornerRadius" Value="1" />
                    <Setter TargetName="shadow" Property="CornerRadius" Value="1" />
                    <Setter TargetName="photo" Property="CornerRadius" Value="0" />
                    <Setter TargetName="caption" Property="FontFamily" Value="Segoe Print" />
                    <Setter TargetName="caption" Property="FontSize" Value="13" />
                    <Setter TargetName="handle" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Link / video card ===== -->
        <DataTemplate x:Key="LinkSticky" DataType="{x:Type m:StickyNote}">
            <Grid x:Name="sticky" Width="{Binding Width}" Height="{Binding Height}" RenderTransformOrigin="0.5,0.5"
                  PreviewMouseLeftButtonDown="OnStickyMouseDown">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scale" />
                        <RotateTransform Angle="{Binding Rotation}" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Border x:Name="shadow" CornerRadius="10" Background="White" Effect="{DynamicResource LiftShadow}" Opacity="0.55" Margin="2,4,2,0" />
                <Border x:Name="body" CornerRadius="10" Background="White" ClipToBounds="True">
                    <DockPanel>
                        <Grid x:Name="thumb" DockPanel.Dock="Top" Height="{Binding Width, Converter={StaticResource Multiply}, ConverterParameter=0.5625}" Background="#161616"
                              Visibility="{Binding Image, Converter={StaticResource HasValueToVis}}">
                            <Image Source="{Binding Image, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border x:Name="play" Width="58" Height="40" CornerRadius="11" Background="#E6E53935" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static core:Glyphs.Play}" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Border>
                        </Grid>
                        <StackPanel Margin="14,10,14,10">
                            <TextBlock x:Name="title" Text="{Binding Caption}" FontWeight="SemiBold" FontSize="14" Foreground="#1E1E1E" TextWrapping="Wrap" MaxHeight="40"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock x:Name="kindIcon" Text="{x:Static core:Glyphs.Link}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#80000000"
                                           VerticalAlignment="Center" Margin="0,1,6,0" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#8C000000" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                <TextBlock Text="{Binding Domain}" FontSize="12" Foreground="#8C000000" TextTrimming="CharacterEllipsis" MaxWidth="240"
                                           Visibility="{Binding Subtitle, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Thumb Style="{StaticResource StickyThumb}" Cursor="SizeAll" DragStarted="OnDragStarted" DragDelta="OnDragDelta" DragCompleted="OnDragCompleted"
                       MouseDoubleClick="OnLinkDoubleClick" ToolTip="Drag to move · double-click to open" />
                <ContentControl Style="{StaticResource PrivateChip}" Margin="8,8,0,0" />
                <StackPanel x:Name="tools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Opacity="0">
                    <Button Style="{StaticResource OverlayButton}" Content="{x:Static core:Glyphs.Play}" ToolTip="Study: play it next to the board and take timed notes" Margin="0,0,4,0"
                            Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.StudyVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource OverlayButton}" Content="{x:Static core:Glyphs.OpenExternal}" ToolTip="Open" Margin="0,0,4,0"
                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource OverlayButton}" Content="{x:Static core:Glyphs.More}" Click="OnStickyMenu" ToolTip="Pin, refresh, duplicate…" Margin="0,0,4,0" />
                    <Button Style="{StaticResource OverlayButton}" Content="{x:Static core:Glyphs.Delete}" ToolTip="Delete"
                            Command="{Binding DataContext.DeleteStickyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
                <Thumb Style="{StaticResource StickyThumb}" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                       DragDelta="OnResizeDelta" ToolTip="Resize" />
                <Ellipse x:Name="handle" Style="{StaticResource ConnectHandle}" MouseLeftButtonDown="OnConnectHandleDown" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="sticky" Property="IsMouseOver" Value="True">
                    <Setter TargetName="tools" Property="Opacity" Value="1" />
                    <Setter TargetName="handle" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                    <Setter TargetName="kindIcon" Property="Text" Value="{x:Static core:Glyphs.Video}" />
                    <Setter TargetName="kindIcon" Property="Foreground" Value="#E53935" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsCork, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="body" Property="CornerRadius" Value="1" />
                    <Setter TargetName="shadow" Property="CornerRadius" Value="1" />
                    <Setter TargetName="handle" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Live card ===== -->
        <DataTemplate DataType="{x:Type vm:LiveTasksData}">
            <StackPanel Margin="12,2,12,10">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:TaskItem}">
                            <DockPanel Margin="0,0,0,6">
                                <CheckBox DockPanel.Dock="Left" Style="{StaticResource RoundCheck}" IsChecked="{Binding IsDone, Mode=OneWay}" VerticalAlignment="Center"
                                          BorderBrush="{Binding Priority, Converter={StaticResource PriorityBrush}}"
                                          Command="{Binding DataContext.ToggleLiveTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <TextBlock x:Name="title" Text="{Binding Title}" Foreground="#262626" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough" />
                                    <Setter TargetName="title" Property="Foreground" Value="#8A8A8A" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding More, StringFormat=+ {0} more}" FontSize="12" Foreground="#8C000000" Visibility="{Binding More, Converter={StaticResource HasValueToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LiveNoteData}">
            <Grid Margin="12,2,12,10">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Visibility="{Binding IsChecklist, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:ChecklistItem}">
                            <DockPanel Margin="{Binding Indent, Converter={StaticResource Indent}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,5"
                                          Command="{Binding DataContext.ToggleLiveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <TextBlock x:Name="text" Text="{Binding Text}" Foreground="#262626" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,5" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                    <Setter TargetName="text" Property="TextDecorations" Value="Strikethrough" />
                                    <Setter TargetName="text" Property="Foreground" Value="#8A8A8A" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Note.Preview}" Foreground="#3A3A3A" TextWrapping="Wrap" FontSize="13" TextTrimming="WordEllipsis"
                           Visibility="{Binding IsChecklist, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LiveProjectData}">
            <StackPanel Margin="12,4,12,10">
                <Grid Height="8">
                    <Border Background="#14000000" CornerRadius="4" />
                    <Border CornerRadius="4" HorizontalAlignment="Left" Background="{Binding Project.Color, Converter={StaticResource PaletteBrush}}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource ProgressWidth}">
                                <Binding Path="Progress" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Detail}" Foreground="#3A3A3A" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LiveCountdownData}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold"
                           Foreground="{Binding Countdown.Color, Converter={StaticResource PaletteBrush}}">
                    <Run Text="{Binding Countdown.Emoji, Mode=OneWay}" FontFamily="{StaticResource EmojiFont}" FontSize="30" /><Run Text="{Binding Countdown.DaysLeft, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="days to go" Foreground="#8C000000" HorizontalAlignment="Center" FontSize="12" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LiveClockData}">
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                <Grid Width="120" Height="120">
                    <Ellipse Fill="#FAFAF7" Stroke="#33000000" StrokeThickness="1.5" />
                    <Ellipse Width="6" Height="6" Fill="#262626" />
                    <Rectangle Width="4" Height="34" Fill="#262626" RadiusX="2" RadiusY="2" VerticalAlignment="Top" Margin="0,28,0,0" RenderTransformOrigin="0.5,0.94">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="{Binding HourAngle}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="3" Height="48" Fill="#262626" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Top" Margin="0,14,0,0" RenderTransformOrigin="0.5,0.958">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="{Binding MinuteAngle}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="1.4" Height="52" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,10,0,0" RenderTransformOrigin="0.5,0.962">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="{Binding SecondAngle}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                <TextBlock Text="{Binding Time}" FontSize="18" FontWeight="SemiBold" Foreground="#262626" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Date}" FontSize="12" Foreground="#8C000000" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LiveWeatherData}">
            <DockPanel Margin="12,0,12,10" VerticalAlignment="Center">
                <c:WeatherIcon DockPanel.Dock="Left" Kind="{Binding Report.Kind}" Width="64" Height="64" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Light" Foreground="#262626"><Run Text="{Binding Report.Temperature, Mode=OneWay, StringFormat={}{0:0}°}" /></TextBlock>
                    <TextBlock FontSize="12" Foreground="#8C000000"><Run Text="{Binding Report.Days[0].Max, Mode=OneWay, StringFormat=↑ {0:0}°}" /><Run Text="  " /><Run Text="{Binding Report.Days[0].Min, Mode=OneWay, StringFormat=↓ {0:0}°}" /></TextBlock>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LiveMusicData}">
            <DockPanel Margin="12,0,12,10">
                <Border DockPanel.Dock="Left" Width="80" Height="45" CornerRadius="5" ClipToBounds="True" Background="#E6E5E0" Margin="0,0,10,0">
                    <Image Source="{Binding Player.Thumbnail, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Player.Title, TargetNullValue='Nothing playing'}" FontWeight="SemiBold" Foreground="#262626" TextTrimming="CharacterEllipsis" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Margin="-6,2,0,0">
                        <Button Style="{StaticResource StickyButton}" Content="&#xE892;" Command="{Binding Player.PreviousCommand}" ToolTip="Previous" />
                        <Button Style="{StaticResource StickyButton}" Command="{Binding Player.PlayPauseCommand}" ToolTip="Play / pause"
                                Content="{Binding Player.IsPlaying, Converter={StaticResource BoolToString}, ConverterParameter=&#xE769;|&#xE768;}" />
                        <Button Style="{StaticResource StickyButton}" Content="&#xE893;" Command="{Binding Player.NextCommand}" ToolTip="Next" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Game / book / show cards: the cover (or a coloured tile with an icon), then the details -->
        <DataTemplate DataType="{x:Type vm:LiveGameData}">
            <DockPanel Margin="12,0,12,12">
                <Border DockPanel.Dock="Left" Width="62" Height="88" CornerRadius="5" ClipToBounds="True" Margin="0,0,12,0"
                        Background="{Binding Game.Color, Converter={StaticResource PaletteBrush}}">
                    <Grid>
                        <TextBlock Text="{x:Static core:Glyphs.Game}" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Game.Cover, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Detail}" Foreground="#3A3A3A" FontSize="13" TextWrapping="Wrap" />
                    <StackPanel Visibility="{Binding Game.Completion, Converter={StaticResource HasValueToVis}}" Margin="0,8,0,0">
                        <Grid Height="5">
                            <Border Background="#14000000" CornerRadius="2.5" />
                            <Border CornerRadius="2.5" HorizontalAlignment="Left" Background="{Binding Game.Color, Converter={StaticResource PaletteBrush}}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressWidth}">
                                        <Binding Path="Game.Completion" Converter="{StaticResource Multiply}" ConverterParameter="0.01" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Game.Completion, StringFormat={}{0}% complete}" FontSize="11.5" Foreground="#8C000000" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LiveBookData}">
            <DockPanel Margin="12,0,12,12">
                <Border DockPanel.Dock="Left" Width="62" Height="88" CornerRadius="2,5,5,2" ClipToBounds="True" Margin="0,0,12,0"
                        Background="{Binding Book.Color, Converter={StaticResource PaletteBrush}}">
                    <Grid>
                        <TextBlock Text="{x:Static core:Glyphs.Book}" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Book.Cover, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <Grid Height="5">
                        <Border Background="#14000000" CornerRadius="2.5" />
                        <Border CornerRadius="2.5" HorizontalAlignment="Left" Background="{Binding Book.Color, Converter={StaticResource PaletteBrush}}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                    <Binding Path="Book.Progress" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Detail}" Foreground="#3A3A3A" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LiveShowData}">
            <DockPanel Margin="12,0,12,12">
                <Border DockPanel.Dock="Left" Width="62" Height="88" CornerRadius="5" ClipToBounds="True" Margin="0,0,12,0"
                        Background="{Binding Item.Color, Converter={StaticResource PaletteBrush}}">
                    <Grid>
                        <TextBlock Text="{x:Static core:Glyphs.Monitor}" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Item.Poster, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Detail}" Foreground="#3A3A3A" FontSize="13" TextWrapping="Wrap" />
                    <Grid Height="5" Margin="0,8,0,0" Visibility="{Binding Item.IsShow, Converter={StaticResource BoolToVis}}">
                        <Border Background="#14000000" CornerRadius="2.5" />
                        <Border CornerRadius="2.5" HorizontalAlignment="Left" Background="{Binding Item.Color, Converter={StaticResource PaletteBrush}}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                    <Binding Path="Item.Progress" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Item.ProgressText}" FontSize="11.5" Foreground="#8C000000" Margin="0,3,0,0"
                               Visibility="{Binding Item.IsShow, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="LiveSticky" DataType="{x:Type m:StickyNote}">
            <Grid x:Name="sticky" Width="{Binding Width}" Height="{Binding Height}" RenderTransformOrigin="0.5,0.5"
                  PreviewMouseLeftButtonDown="OnStickyMouseDown">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scale" />
                        <RotateTransform Angle="{Binding Rotation}" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Border x:Name="shadow" CornerRadius="12" Background="White" Effect="{DynamicResource LiftShadow}" Opacity="0.55" Margin="2,4,2,0" />
                <Border x:Name="body" CornerRadius="12" Background="White" ClipToBounds="True">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="44">
                            <DockPanel Margin="12,6,10,0" IsHitTestVisible="False">
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Margin="0,0,9,0"
                                        Background="{Binding Live.ColorKey, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}">
                                    <TextBlock Text="{Binding Live.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding Live.ColorKey, Converter={StaticResource PaletteBrush}}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Live.Title}" FontWeight="SemiBold" FontSize="13.5" Foreground="#1E1E1E" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Live.Subtitle}" FontSize="11.5" Foreground="#8C000000" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <Thumb Style="{StaticResource StickyThumb}" Cursor="SizeAll" DragStarted="OnDragStarted" DragDelta="OnDragDelta" DragCompleted="OnDragCompleted"
                                   MouseDoubleClick="OnLiveDoubleClick" ToolTip="Drag to move · double-click to open" />
                            <StackPanel x:Name="tools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Opacity="0">
                                <Button Style="{StaticResource StickyButton}" Content="{x:Static core:Glyphs.OpenExternal}" ToolTip="Open"
                                        Command="{Binding DataContext.OpenLiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource StickyButton}" Content="{x:Static core:Glyphs.More}" Click="OnStickyMenu" ToolTip="Pin, duplicate…" />
                                <Button Style="{StaticResource StickyButton}" Content="{x:Static core:Glyphs.Delete}" ToolTip="Remove"
                                        Command="{Binding DataContext.DeleteStickyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                        <ContentControl Content="{Binding Live}" Focusable="False" />
                    </DockPanel>
                </Border>
                <Border x:Name="liveDot" Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource SuccessBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="9,9,0,0" ToolTip="Live" b:Motion.Wiggle="True" />
                <ContentControl Style="{StaticResource PrivateChip}" VerticalAlignment="Bottom" Margin="10,0,0,10" />
                <Thumb Style="{StaticResource StickyThumb}" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                       DragDelta="OnResizeDelta" ToolTip="Resize" />
                <Ellipse x:Name="handle" Style="{StaticResource ConnectHandle}" MouseLeftButtonDown="OnConnectHandleDown" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="sticky" Property="IsMouseOver" Value="True">
                    <Setter TargetName="tools" Property="Opacity" Value="1" />
                    <Setter TargetName="handle" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding DataContext.IsCork, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="body" Property="CornerRadius" Value="2" />
                    <Setter TargetName="shadow" Property="CornerRadius" Value="2" />
                    <Setter TargetName="handle" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <vp:StickyTemplateSelector x:Key="StickySelector" TextTemplate="{StaticResource TextSticky}" ImageTemplate="{StaticResource ImageSticky}"
                                   LinkTemplate="{StaticResource LinkSticky}" LiveTemplate="{StaticResource LiveSticky}" />

        <DrawingBrush x:Key="DotsBrush" TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,26,26" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource StrokeStrongBrush}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="13,13" RadiusX="1.15" RadiusY="1.15" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="BoardFrame" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCork}" Value="True">
                    <Setter Property="BorderBrush" Value="{x:Static c:CorkTexture.Wood}" />
                    <Setter Property="BorderThickness" Value="11" />
                    <Setter Property="CornerRadius" Value="7" />
                    <Setter Property="Background" Value="#B48B5E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,0,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SegmentHost}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.ZoomOut}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+wheel)" />
                        <Button Style="{StaticResource GhostButton}" Content="{Binding ZoomText}" Command="{Binding ResetZoomCommand}" MinHeight="28" Padding="8,0" MinWidth="56"
                                FontWeight="Normal" ToolTip="Reset zoom" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.ZoomIn}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl+wheel)" />
                    </StackPanel>
                </Border>
                <ToggleButton Style="{StaticResource Chip}" Content="Study" b:Ui.Icon="{x:Static core:Glyphs.Video}" IsChecked="{Binding IsStudyOpen, Mode=OneWay}"
                              Command="{Binding ToggleStudyCommand}" Margin="0,0,8,0" MinHeight="34" Padding="12,0"
                              Visibility="{Binding HasVideoCards, Converter={StaticResource BoolToVis}}"
                              ToolTip="Play the board's video next to the canvas and pin notes at the current time" />
                <Button Content="Tidy up" b:Ui.Icon="{x:Static core:Glyphs.Grid}" Command="{Binding TidyUpCommand}" Margin="0,0,8,0" ToolTip="Arrange everything in a neat grid" />
                <ToggleButton Style="{StaticResource Chip}" Content="Corkboard" b:Ui.Icon="{x:Static core:Glyphs.Pin}" IsChecked="{Binding IsCork, Mode=OneWay}"
                              Command="{Binding ToggleCorkCommand}" Margin="0,0,10,0" MinHeight="34" Padding="12,0"
                              ToolTip="Corkboard style: push-pins and strings that swing when you move notes" />
                <Button Content="Insert" b:Ui.Icon="{x:Static core:Glyphs.Import}" Command="{Binding InsertFromSatchelCommand}" Margin="0,0,8,0"
                        ToolTip="Put notes, photos, videos, games, books and more from the other tabs on the board" />
                <Button Style="{StaticResource AccentButton}" Content="Add note" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddStickyCommand}" ToolTip="Add a note (Ctrl+N)" />
                <Button Style="{StaticResource AccentButton}" Content="{x:Static core:Glyphs.ChevronDown}" FontFamily="{StaticResource IconFont}" FontSize="10" Padding="8,0"
                        Margin="2,0,0,0" b:Ui.MenuOnClick="True" ToolTip="Add an image, a link…">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Note" Icon="{x:Static core:Glyphs.Notes}" Command="{Binding AddStickyCommand}" InputGestureText="Ctrl+N" />
                            <MenuItem Header="Image from file…" Icon="{x:Static core:Glyphs.Picture}" Command="{Binding AddImageCommand}" />
                            <MenuItem Header="Link or YouTube video…" Icon="{x:Static core:Glyphs.Link}" Command="{Binding AddLinkCommand}" />
                            <MenuItem Header="Live card…" Icon="{x:Static core:Glyphs.Pulse}" Command="{Binding AddLiveCardCommand}" />
                            <MenuItem Header="From Satchel: notes, photos, videos, games…" Icon="{x:Static core:Glyphs.Import}" Command="{Binding InsertFromSatchelCommand}" />
                            <Separator />
                            <MenuItem Header="Paste from clipboard" Icon="{x:Static core:Glyphs.Copy}" Command="{Binding PasteFromClipboardCommand}" InputGestureText="Ctrl+V" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.More}" Margin="6,0,0,0" b:Ui.MenuOnClick="True" ToolTip="Board options">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="New board…" Icon="{x:Static core:Glyphs.Add}" Command="{Binding NewBoardCommand}" />
                            <MenuItem Header="Rename board…" Icon="{x:Static core:Glyphs.Edit}" Command="{Binding RenameBoardCommand}" />
                            <MenuItem Header="{Binding SelectedBoard.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark board private'}"
                                      Icon="{x:Static core:Glyphs.Hide}" Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding SelectedBoard}" />
                            <Separator />
                            <MenuItem Header="Delete board" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteBoardCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Left" Text="Board" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="0,0,20,0" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" PreviewMouseWheel="OnChipsWheel">
                    <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Boards}" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource ChipRadio}" Content="{Binding Name}" GroupName="boards" Margin="0,0,6,0"
                                             Command="{Binding DataContext.SelectBoardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource SameObject}" Mode="OneWay">
                                            <Binding />
                                            <Binding Path="DataContext.SelectedBoard" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Add}" Command="{Binding NewBoardCommand}" ToolTip="New board" FontSize="11"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <!-- ===== Study panel: the video next to the board ===== -->
        <Border x:Name="StudyDock" Grid.Column="1" Width="420" Margin="16,0,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusLarge}" ClipToBounds="True" Visibility="{Binding IsStudyOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,12,8,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CloseStudyCommand}" ToolTip="Close the panel" />
                    <StackPanel>
                        <TextBlock Text="Study" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding StudyTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <c:YouTubePlayer x:Name="StudyPlayer" DockPanel.Dock="Top" Height="236" />
                <StackPanel DockPanel.Dock="Top" Margin="16,14,16,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Pill}" Margin="0,0,10,0" Padding="9,3">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"><Run Text="{x:Static core:Glyphs.Clock}" FontFamily="{StaticResource IconFont}" FontSize="11" /><Run Text=" " /><Run Text="{Binding StudyTimeText, Mode=OneWay}" /></TextBlock>
                        </Border>
                        <TextBlock Text="Notes are pinned at this moment" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Style="{StaticResource MultilineTextBox}" Text="{Binding StudyNote, UpdateSourceTrigger=PropertyChanged}" MinHeight="64" Margin="0,10,0,0"
                             b:Ui.Placeholder="Type a note and press Enter (Shift+Enter for a new line). Start with 2:15 to set the time yourself."
                             PreviewKeyDown="OnStudyNoteKeyDown" />
                    <Button Style="{StaticResource AccentButton}" Content="Pin note to the board" b:Ui.Icon="{x:Static core:Glyphs.Pin}" Command="{Binding AddStudyNoteCommand}"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Notes land next to the video, tied to it with string. Click ▶ on any note to jump back to that moment."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="16,10,16,14" />
                <Grid />
            </DockPanel>
        </Border>

        <Border x:Name="Frame" Style="{StaticResource BoardFrame}" ClipToBounds="True">
            <Grid x:Name="Overlay">
                <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnWheel" ScrollChanged="OnScrollChanged"
                              AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                    <Grid>
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                        </Grid.LayoutTransform>
                        <Canvas x:Name="Surface" Width="{Binding Width}" Height="{Binding Height}" Background="{StaticResource DotsBrush}"
                                MouseLeftButtonDown="OnCanvasMouseDown" MouseMove="OnSurfaceMouseMove" MouseLeftButtonUp="OnSurfaceMouseUp" LostMouseCapture="OnSurfaceLostCapture">
                            <c:BoardConnectors x:Name="UnderLinks" Layer="Under" Width="{Binding Width}" Height="{Binding Height}" Stickies="{Binding Stickies}" Links="{Binding Links}"
                                               IsCork="{Binding IsCork}" SelectedLink="{Binding SelectedLink}" MouseLeftButtonDown="OnConnectorMouseDown" />
                            <ItemsControl x:Name="StickyHost" ItemsSource="{Binding Stickies}" ItemTemplateSelector="{StaticResource StickySelector}" Focusable="False"
                                          Width="{Binding Width}" Height="{Binding Height}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                            <c:BoardConnectors x:Name="OverLinks" Layer="Over" Width="{Binding Width}" Height="{Binding Height}" Stickies="{Binding Stickies}" Links="{Binding Links}"
                                               IsCork="{Binding IsCork}" SelectedLink="{Binding SelectedLink}" MouseLeftButtonDown="OnConnectorMouseDown" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource EmptyIcon}">
                        <TextBlock Text="{x:Static core:Glyphs.Tiles}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <TextBlock Text="An empty canvas" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="Double-click to add a note · paste or drop images and links" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Floating formatting bar for the note being edited (screen space, unaffected by zoom) -->
                <Border x:Name="FormatBar" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Padding="4" Background="{DynamicResource ElevatedBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Effect="{DynamicResource PopupShadow}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FormatBarShift" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="FmtBold" Style="{StaticResource FormatToggle}" Content="{x:Static core:Glyphs.Bold}" Click="OnFormat" Tag="bold" ToolTip="Bold (Ctrl+B)" />
                        <ToggleButton x:Name="FmtItalic" Style="{StaticResource FormatToggle}" Content="{x:Static core:Glyphs.Italic}" Click="OnFormat" Tag="italic" ToolTip="Italic (Ctrl+I)" />
                        <ToggleButton x:Name="FmtUnderline" Style="{StaticResource FormatToggle}" Content="{x:Static core:Glyphs.Underline}" Click="OnFormat" Tag="underline" ToolTip="Underline (Ctrl+U)" />
                        <ToggleButton x:Name="FmtStrike" Style="{StaticResource FormatToggle}" Content="{x:Static core:Glyphs.Strikethrough}" Click="OnFormat" Tag="strike" ToolTip="Strikethrough (Ctrl+Shift+X)" />
                        <Border Style="{StaticResource VDivider}" Margin="3,6" />
                        <Button Style="{StaticResource FormatButton}" Content="H1" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="12" Click="OnFormat" Tag="h1" ToolTip="Heading (Ctrl+1)" />
                        <Button Style="{StaticResource FormatButton}" Content="H2" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="11" Click="OnFormat" Tag="h2" ToolTip="Subheading (Ctrl+2)" />
                        <Button Style="{StaticResource FormatButton}" Content="¶" FontFamily="{DynamicResource UiFont}" FontSize="14" Click="OnFormat" Tag="normal" ToolTip="Normal text (Ctrl+0)" />
                        <Border Style="{StaticResource VDivider}" Margin="3,6" />
                        <Button Style="{StaticResource FormatButton}" Content="{x:Static core:Glyphs.Checklist}" Click="OnFormat" Tag="checklist" ToolTip="Checklist (Ctrl+Shift+C) — click a box to tick it" />
                        <Button Style="{StaticResource FormatButton}" Content="{x:Static core:Glyphs.BulletedList}" Click="OnFormat" Tag="bullets" ToolTip="Bulleted list" />
                        <Button Style="{StaticResource FormatButton}" Content="1." FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="12" Click="OnFormat" Tag="numbers" ToolTip="Numbered list" />
                        <Border Style="{StaticResource VDivider}" Margin="3,6" />
                        <StackPanel x:Name="FmtColors" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0" />
                        <Button Style="{StaticResource FormatButton}" Content="{x:Static core:Glyphs.Highlight}" Click="OnFormat" Tag="highlight" ToolTip="Highlight" />
                        <Button Style="{StaticResource FormatButton}" Content="{x:Static core:Glyphs.Code}" Click="OnFormat" Tag="code" ToolTip="Code" />
                        <Button Style="{StaticResource FormatButton}" Content="Tx" FontFamily="{DynamicResource UiFont}" FontSize="12" Click="OnFormat" Tag="clear" ToolTip="Clear formatting" />
                        <Border Style="{StaticResource VDivider}" Margin="3,6" />
                        <Button Style="{StaticResource FormatButton}" Content="A−" FontFamily="{DynamicResource UiFont}" FontSize="12" Click="OnFormat" Tag="smaller" ToolTip="Smaller text" />
                        <Button Style="{StaticResource FormatButton}" Content="A+" FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="SemiBold" Click="OnFormat" Tag="bigger" ToolTip="Bigger text" />
                        <Button Style="{StaticResource FormatButton}" Content="{x:Static core:Glyphs.Picture}" Click="OnFormat" Tag="image" ToolTip="Insert image (or paste one)" />
                        <Border Style="{StaticResource VDivider}" Margin="3,6" />
                        <Button Style="{StaticResource FormatButton}" Content="{x:Static core:Glyphs.FullScreen}" Click="OnFormat" Tag="expand" ToolTip="Open large, with the full toolbar (or double-click the note's top bar)" />
                    </StackPanel>
                </Border>

                <!-- Toolbar for the selected connection -->
                <Border x:Name="LinkBar" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Padding="6,4" Background="{DynamicResource ElevatedBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Effect="{DynamicResource PopupShadow}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="LinkBarShift" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="LinkColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                        <Border Style="{StaticResource VDivider}" Margin="4,6" />
                        <Button Style="{StaticResource FormatButton}" Content="{x:Static core:Glyphs.Tag}" Command="{Binding EditLinkLabelCommand}" ToolTip="Label" />
                        <Button x:Name="ArrowButton" Style="{StaticResource FormatButton}" Content="{x:Static core:Glyphs.Forward}" Command="{Binding ToggleLinkArrowCommand}" ToolTip="Arrow on/off" />
                        <Button Style="{StaticResource FormatButton}" Content="{x:Static core:Glyphs.Delete}" Command="{Binding DeleteLinkCommand}" ToolTip="Remove connection (Delete)"
                                Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                </Border>

                <!-- Note menu -->
                <Popup x:Name="StickyMenu" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
                    <Border Margin="6,4,10,14" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius}" Padding="12,10,12,10" Effect="{DynamicResource PopupShadow}" Width="214">
                        <StackPanel>
                            <StackPanel x:Name="MenuColorSection">
                                <TextBlock Text="Colour" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                                <ItemsControl x:Name="ColorList" ItemsSource="{Binding Colors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="24" Height="24" Margin="0,0,6,6" Cursor="Hand" Fill="{Binding Key, Converter={StaticResource PaletteBrush}, ConverterParameter=sticky}"
                                                     Stroke="#33000000" StrokeThickness="1" MouseLeftButtonUp="OnColorPicked" ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel x:Name="MenuPinSection">
                                <TextBlock Text="Pin" Style="{StaticResource Overline}" Margin="0,6,0,6" />
                                <WrapPanel x:Name="PinList" />
                            </StackPanel>
                            <StackPanel x:Name="MenuSizeSection">
                                <TextBlock Text="Text size" Style="{StaticResource Overline}" Margin="0,6,0,6" />
                                <UniformGrid Rows="1" Margin="0,0,0,4">
                                    <Button Content="S" Click="OnSizePicked" Tag="13" Margin="0,0,4,0" Padding="0" MinHeight="28" />
                                    <Button Content="M" Click="OnSizePicked" Tag="15" Margin="0,0,4,0" Padding="0" MinHeight="28" />
                                    <Button Content="L" Click="OnSizePicked" Tag="20" Margin="0,0,4,0" Padding="0" MinHeight="28" />
                                    <Button Content="XL" Click="OnSizePicked" Tag="28" Padding="0" MinHeight="28" />
                                </UniformGrid>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,6,0,6" />
                            <Button Style="{StaticResource RowButton}" Click="OnDuplicate" Padding="6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static core:Glyphs.Copy}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,10,0" />
                                    <TextBlock Text="Duplicate" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MenuRefresh" Style="{StaticResource RowButton}" Click="OnRefreshPreview" Padding="6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static core:Glyphs.Refresh}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,10,0" />
                                    <TextBlock Text="Refresh preview" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MenuPrivate" Style="{StaticResource RowButton}" Click="OnTogglePrivate" Padding="6,6"
                                    ToolTip="Private notes (and their connections) are hidden until you show private items">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static core:Glyphs.Hide}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,10,0" />
                                    <TextBlock x:Name="MenuPrivateText" Text="Mark private" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Enlarged image -->
                <Border x:Name="ImagePreview" Background="#D9000000" Visibility="Collapsed" MouseLeftButtonDown="OnClosePreview" Cursor="Hand">
                    <Image x:Name="PreviewImage" Margin="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
