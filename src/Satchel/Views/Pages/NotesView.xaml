<UserControl x:Class="Satchel.Views.Pages.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <!-- ===== Context menus ===== -->
        <ContextMenu x:Key="NoteMenu" x:Shared="False">
            <MenuItem Header="Open" Icon="{x:Static core:Glyphs.Edit}"
                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Pin / unpin" Icon="{x:Static core:Glyphs.Pin}"
                      Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Color" Icon="{x:Static core:Glyphs.Palette}" ItemsSource="{x:Static core:Palettes.Notes}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="14" Height="14" Fill="{Binding Key, Converter={StaticResource PaletteBrush}, ConverterParameter=note}"
                                                 Stroke="{DynamicResource StrokeStrongBrush}" StrokeThickness="1" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="Click" Handler="OnColorMenuClick" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Move to notebook" Icon="{x:Static core:Glyphs.Book}"
                      ItemsSource="{Binding PlacementTarget.Tag.NotebookChoices, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <EventSetter Event="Click" Handler="OnMoveMenuClick" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Duplicate" Icon="{x:Static core:Glyphs.Copy}"
                      Command="{Binding PlacementTarget.Tag.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Export as Markdown…" Icon="{x:Static core:Glyphs.Export}"
                      Command="{Binding PlacementTarget.Tag.ExportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Archive / unarchive" Icon="{x:Static core:Glyphs.Archive}"
                      Command="{Binding PlacementTarget.Tag.ToggleArchiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="{Binding IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}" Icon="{x:Static core:Glyphs.Hide}"
                      Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Move to trash" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                      Command="{Binding PlacementTarget.Tag.TrashCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>

        <ContextMenu x:Key="TrashMenu" x:Shared="False">
            <MenuItem Header="Restore" Icon="{x:Static core:Glyphs.Undo}"
                      Command="{Binding PlacementTarget.Tag.RestoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Delete forever" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                      Command="{Binding PlacementTarget.Tag.DeleteForeverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>

        <ContextMenu x:Key="NotebookMenu" x:Shared="False">
            <MenuItem Header="Rename…" Icon="{x:Static core:Glyphs.Edit}"
                      Command="{Binding PlacementTarget.Tag.RenameNotebookCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Color" Icon="{x:Static core:Glyphs.Palette}" ItemsSource="{x:Static core:Palettes.Tags}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{Binding Key, Converter={StaticResource PaletteBrush}}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="Click" Handler="OnNotebookColorClick" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="{Binding IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark notebook private'}" Icon="{x:Static core:Glyphs.Hide}"
                      Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Delete notebook" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                      Command="{Binding PlacementTarget.Tag.DeleteNotebookCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>

        <!-- ===== Card (grid view) ===== -->
        <DataTemplate x:Key="NoteCard" DataType="{x:Type m:Note}">
            <Button x:Name="card" Style="{StaticResource CardButton}" Padding="16,14,16,12"
                    Background="{Binding Color, Converter={StaticResource PaletteBrush}, ConverterParameter=note}"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource NoteMenu}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="64"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,26,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding Type, Converter={StaticResource EqualsToVis}, ConverterParameter=Journal}">
                            <TextBlock Text="{Binding JournalDate, Converter={StaticResource DateFormat}, ConverterParameter=full}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding MoodEmoji}" FontFamily="{StaticResource EmojiFont}" Margin="8,0,0,0" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="200" TextTrimming="WordEllipsis" LineHeight="20"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCode}" Value="True">
                                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                            <Setter Property="FontSize" Value="12.5" />
                                            <Setter Property="MaxHeight" Value="160" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding PreviewItems}" Margin="0,8,0,0" AlternationCount="1000" Focusable="False"
                                      Visibility="{Binding IsItemList, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{Binding Indent, Converter={StaticResource Indent}}">
                                        <CheckBox x:Name="check" IsChecked="{Binding IsChecked, Mode=OneWay}" Margin="0,3,8,3" VerticalAlignment="Top"
                                                  Tag="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                  Click="OnCardItemClick" b:DnD.NoDrag="True"
                                                  Visibility="{Binding DataContext.Type, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource EqualsToVis}, ConverterParameter=Checklist}" />
                                        <Ellipse x:Name="bullet" Width="5" Height="5" Fill="{DynamicResource TextMutedBrush}" Margin="4,9,10,0" VerticalAlignment="Top"
                                                 Visibility="{Binding DataContext.Type, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource EqualsToVis}, ConverterParameter=List}" />
                                        <TextBlock x:Name="text" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,2" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                            <Setter TargetName="text" Property="TextDecorations" Value="Strikethrough" />
                                            <Setter TargetName="text" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MoreItemsCount, StringFormat=+{0} more}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding MoreItemsCount, Converter={StaticResource HasValueToVis}}" />
                        <ItemsControl ItemsSource="{Binding TagList}" ItemTemplate="{StaticResource TagChip}" Margin="0,10,0,-4" Focusable="False"
                                      Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding TypeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextFaintBrush}"
                                       Visibility="{Binding Type, Converter={StaticResource EqualsToVis}, ConverterParameter=Checklist}" />
                            <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextFaintBrush}" Margin="7,0,0,0" />
                        </DockPanel>
                    </StackPanel>
                    <Button x:Name="pin" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Pin}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-6,-8,0" Opacity="0" ToolTip="Pin"
                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="pin" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="pin" Property="Opacity" Value="1" />
                    <Setter TargetName="pin" Property="Content" Value="{x:Static core:Glyphs.Unpin}" />
                    <Setter TargetName="pin" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    <Setter TargetName="pin" Property="ToolTip" Value="Unpin" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsTrashView, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="card" Property="ContextMenu" Value="{StaticResource TrashMenu}" />
                    <Setter TargetName="pin" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Row (list view) ===== -->
        <DataTemplate x:Key="NoteRow" DataType="{x:Type m:Note}">
            <Button Style="{StaticResource CardButton}" Padding="0" Margin="0,0,0,2"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource NoteMenu}">
                <DockPanel Margin="0,10,14,10">
                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="6,0,0,0"
                            Background="{Binding Color, Converter={StaticResource PaletteBrush}, ConverterParameter=note}" />
                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Margin="10,0,12,0" Background="{DynamicResource SurfaceHoverBrush}">
                        <TextBlock Text="{Binding TypeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static core:Glyphs.Pin}" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,10,0"
                                   Foreground="{DynamicResource AccentTextBrush}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxHeight="18"
                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ProgressText, StringFormat={}{0} done}" Style="{StaticResource Caption}"
                                   Visibility="{Binding Type, Converter={StaticResource EqualsToVis}, ConverterParameter=Checklist}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="NotesItems" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemTemplate" Value="{StaticResource NoteCard}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <c:MasonryPanel MinColumnWidth="240" Spacing="14" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="b:DnD.IsReorderable" Value="{Binding CanReorder}" />
            <Setter Property="b:DnD.Group" Value="notes" />
            <Setter Property="b:DnD.ReorderCommand" Value="{Binding ReorderCommand}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGridView}" Value="False">
                    <Setter Property="ItemTemplate" Value="{StaticResource NoteRow}" />
                    <Setter Property="b:DnD.Mode" Value="Vertical" />
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <c:AnimatedStackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Side item for filters (notebooks are drop targets for notes) -->
        <DataTemplate x:Key="FilterItem" DataType="{x:Type vm:SideFilter}">
            <RadioButton Style="{StaticResource SideItem}" GroupName="notesFilter" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}"
                         b:Ui.IconBrush="{Binding IconBrush}" b:Ui.Badge="{Binding Badge}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                         b:DnD.Group="notes" b:DnD.DropCommand="{Binding DataContext.DropOnNotebookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="280" />
            <ColumnDefinition Width="{Binding HasEditor, Converter={StaticResource BoolToGridLength}, ConverterParameter=1.15*|0}" />
        </Grid.ColumnDefinitions>

        <!-- ===== Side panel ===== -->
        <Border Style="{StaticResource SidePanel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Notes" Style="{StaticResource PageTitle}" Margin="10,4,0,16" />
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button x:Name="NewButton" Style="{StaticResource AccentButton}" Content="New note" b:Ui.Icon="{x:Static core:Glyphs.Add}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,0,40,0" Command="{Binding NewNoteCommand}"
                            CommandParameter="{x:Static m:NoteType.Text}" ToolTip="New note (Ctrl+N)" />
                    <Button x:Name="NewMenuButton" Style="{StaticResource IconButtonAccent}" Width="32" Height="30" HorizontalAlignment="Right" Margin="0,0,3,0"
                            Content="{x:Static core:Glyphs.ChevronDown}" FontSize="10" b:Ui.MenuOnClick="True" ToolTip="More note types">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{x:Static vm:NotesViewModel.NewTypes}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Label}" />
                                        <Setter Property="Icon" Value="{Binding Glyph}" />
                                        <EventSetter Event="Click" Handler="OnNewTypeClick" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom">
                    <ItemsControl ItemsSource="{Binding BinFilters}" ItemTemplate="{StaticResource FilterItem}" Focusable="False" />
                    <Button Style="{StaticResource LinkButton}" Content="Empty trash" Command="{Binding EmptyTrashCommand}" Margin="40,4,0,0" FontSize="12"
                            Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,8" Padding="0,0,8,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding LibraryFilters}" ItemTemplate="{StaticResource FilterItem}" Focusable="False" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Add}" FontSize="11"
                                    Command="{Binding NewNotebookCommand}" ToolTip="New notebook" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                            <TextBlock Text="Notebooks" Style="{StaticResource SectionLabel}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding NotebookFilters}" Focusable="False"
                                      b:DnD.IsReorderable="True" b:DnD.Group="notebooks" b:DnD.Mode="Vertical" b:DnD.ReorderCommand="{Binding ReorderNotebooksCommand}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:AnimatedStackPanel Entrance="False" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource SideItem}" GroupName="notesFilter" Content="{Binding Title}" b:Ui.Icon="{Binding Glyph}"
                                                 b:Ui.IconBrush="{Binding IconBrush}" b:Ui.Badge="{Binding Badge}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                 b:DnD.Group="notes" b:DnD.DropCommand="{Binding DataContext.DropOnNotebookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource NotebookMenu}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Tags" Style="{StaticResource SectionLabel}" Visibility="{Binding TagFilters.Count, Converter={StaticResource HasValueToVis}}" />
                        <ItemsControl ItemsSource="{Binding TagFilters}" ItemTemplate="{StaticResource FilterItem}" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Notes list ===== -->
        <Grid Grid.Column="1" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,4,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Sorting hides while the editor is open so the search box keeps a usable width. -->
                    <ComboBox Style="{StaticResource SmallCombo}" ItemsSource="{x:Static vm:NotesViewModel.SortChoices}" SelectedItem="{Binding SelectedSort}"
                              Width="140" Margin="10,0,0,0" ToolTip="Sort"
                              Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <Border Style="{StaticResource SegmentHost}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" b:Ui.Icon="{x:Static core:Glyphs.Grid}" IsChecked="{Binding IsGridView}" ToolTip="Grid" Padding="10,0" />
                            <RadioButton Style="{StaticResource Segment}" b:Ui.Icon="{x:Static core:Glyphs.List}" IsChecked="{Binding IsGridView, Converter={StaticResource Not}}" ToolTip="List" Padding="10,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         b:Ui.Placeholder="{Binding HeaderTitle, StringFormat=Search in {0}}" MaxWidth="340" HorizontalAlignment="Stretch" MinHeight="34"
                         b:Ui.EscapeCommand="{Binding ClearSearchCommand}" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                <StackPanel Margin="0,4,0,28">
                    <TextBlock Text="Pinned" Style="{StaticResource Overline}" Margin="2,0,0,10" Visibility="{Binding ShowSectionHeaders, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding PinnedNotes}" Style="{StaticResource NotesItems}" b:DnD.ListTag="pinned" />
                    <TextBlock Text="Others" Style="{StaticResource Overline}" Margin="2,22,0,10" Visibility="{Binding ShowSectionHeaders, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding OtherNotes}" Style="{StaticResource NotesItems}" b:DnD.ListTag="others" />

                    <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" b:Motion.Enter="True">
                        <Border Style="{StaticResource EmptyIcon}">
                            <TextBlock Text="{x:Static core:Glyphs.Notes}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Editor ===== -->
        <Border x:Name="EditorPanel" Grid.Column="2" Style="{StaticResource DetailPanel}" Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}}">
            <ContentControl Content="{Binding Editor}" Focusable="False" />
        </Border>
    </Grid>
</UserControl>
