<UserControl x:Class="Satchel.Views.Pages.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <!-- Right-click menu of a folder row (Tag of the row = the page's view model). -->
        <ContextMenu x:Key="FolderMenu" x:Shared="False">
            <MenuItem Header="{Binding IsFolder, Converter={StaticResource BoolToString}, ConverterParameter='New folder inside…|New folder…'}" Icon="{x:Static core:Glyphs.NewFolder}"
                      Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Rename…" Icon="{x:Static core:Glyphs.Edit}" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                      Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="{Binding PrivacyHeader}" Icon="{x:Static core:Glyphs.Hide}" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                      ToolTip="A private folder hides everything in it, including its folders"
                      Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding Folder}" />
            <Separator Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Delete folder" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                      ToolTip="Its documents and folders move up a level — nothing is deleted with it"
                      Command="{Binding PlacementTarget.Tag.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>

        <Style x:Key="ThemeSwatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <Border x:Name="ring" Width="44" Height="44" CornerRadius="22" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                                <Border CornerRadius="19" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                                    <TextBlock Text="Aa" FontFamily="Georgia" FontSize="14" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Document list ===== -->
        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0" Padding="20,0,12,16">
            <DockPanel x:Name="ListPane">
                <DockPanel DockPanel.Dock="Top" Margin="6,4,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Add}" Command="{Binding NewDocCommand}" ToolTip="New document (Ctrl+N)" Margin="0,0,6,0" />
                        <Button Style="{StaticResource AccentButton}" Content="Import" b:Ui.Icon="{x:Static core:Glyphs.Import}" Command="{Binding ImportCommand}"
                                ToolTip="Import Markdown, text, Word (.docx, .doc), RTF or Excel files — or drop them anywhere on this page" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Library" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding CountText}" />
                    </StackPanel>
                </DockPanel>
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         b:Ui.Placeholder="Search titles and text" Margin="0,0,4,10" MinHeight="36" b:Ui.EscapeCommand="{Binding ClearSearchCommand}" />
                <!-- ===== Folders ===== -->
                <DockPanel DockPanel.Dock="Top" Margin="6,0,0,2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="14" Content="{x:Static core:Glyphs.NewFolder}"
                            Command="{Binding NewFolderCommand}" ToolTip="New folder (inside the chosen folder). Drag documents and folders onto a folder to move them." />
                    <TextBlock Text="Folders" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer x:Name="FolderScroll" DockPanel.Dock="Top" MaxHeight="236" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,10" Padding="0,0,10,0" Focusable="False">
                    <ItemsControl ItemsSource="{Binding FolderRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LibraryFolderRow}">
                                <Grid Margin="0,0,0,1" AllowDrop="True" DragEnter="OnFolderDragOver" DragOver="OnFolderDragOver" DragLeave="OnFolderDragLeave" Drop="OnFolderDrop">
                                    <Border x:Name="sel" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource AccentSubtleBrush}" Opacity="0" />
                                    <Border x:Name="target" CornerRadius="{DynamicResource RadiusSmall}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Opacity="0" />
                                    <Button Style="{StaticResource RowButton}" Padding="6,6,10,6" ContextMenu="{StaticResource FolderMenu}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            PreviewMouseLeftButtonDown="OnDragSourceDown" PreviewMouseMove="OnDragSourceMove">
                                        <DockPanel Margin="{Binding Indent}">
                                            <Border DockPanel.Dock="Left" Width="20" />
                                            <TextBlock x:Name="icon" DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.Lock}" FontFamily="{StaticResource IconFont}" FontSize="11" ToolTip="Private folder"
                                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock x:Name="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                    <!-- Fold / unfold, over the row's left edge -->
                                    <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{Binding Indent}" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="9"
                                            Content="{Binding ChevronGlyph}" Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}" ToolTip="Fold or unfold"
                                            Command="{Binding DataContext.ToggleFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="sel" Property="Opacity" Value="1" />
                                        <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                        <Setter TargetName="name" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                        <Setter TargetName="target" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ListTitle}" Style="{StaticResource SectionLabel}" Margin="6,0,0,6" TextTrimming="CharacterEllipsis" />
                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="Add the Markdown guide" Command="{Binding LoadGuideCommand}" FontSize="12"
                        HorizontalAlignment="Left" Margin="6,10,0,0" />
                <Grid>
                <TextBlock Text="{Binding EmptyListText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="6,2,8,0" VerticalAlignment="Top"
                           Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding Filtered}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:AnimatedStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:LibraryDoc}">
                                <Grid Margin="0,0,0,4">
                                    <Border x:Name="sel" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource AccentSubtleBrush}" Opacity="0" />
                                    <Button Style="{StaticResource RowButton}" Padding="12,10" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" PreviewMouseLeftButtonDown="OnDragSourceDown" PreviewMouseMove="OnDragSourceMove"
                                            ToolTip="Drag onto a folder to move it there" ToolTipService.InitialShowDelay="1500">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{x:Static core:Glyphs.StarFilled}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Excerpt}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,3,0,6" />
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource Caption}" DockPanel.Dock="Left" Margin="0,0,10,0">
                                                    <Run Text="{Binding ReadingMinutes, Mode=OneWay}" /><Run Text=" min read" />
                                                </TextBlock>
                                                <Grid VerticalAlignment="Center" Height="3" Visibility="{Binding IsStarted, Converter={StaticResource BoolToVis}}">
                                                    <Border Background="{DynamicResource SegmentBrush}" CornerRadius="1.5" />
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="1.5" HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                                <Binding Path="Progress" />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                            </DockPanel>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource SameObject}">
                                                <Binding />
                                                <Binding Path="DataContext.SelectedDoc" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="sel" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Empty library ===== -->
        <Border Grid.Column="1" Margin="40" CornerRadius="{DynamicResource RadiusLarge}" BorderThickness="2" BorderBrush="{DynamicResource StrokeStrongBrush}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" b:Motion.Enter="True">
                <Border Style="{StaticResource EmptyIcon}">
                    <TextBlock Text="{x:Static core:Glyphs.Library}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <TextBlock Text="Your reading library" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                <TextBlock Text="Drop Markdown, text, Word or Excel files here, import them, or write your own." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="Import files" b:Ui.Icon="{x:Static core:Glyphs.Import}" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                    <Button Content="New document" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding NewDocCommand}" Margin="0,0,8,0" />
                    <Button Content="Markdown guide" b:Ui.Icon="{x:Static core:Glyphs.Book}" Command="{Binding LoadGuideCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Reader ===== -->
        <DockPanel Grid.Column="1" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel DockPanel.Dock="Top" Margin="28,2,24,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.Search}" Command="{Binding OpenFindCommand}" ToolTip="Find in document (Ctrl+F)" />
                    <Button x:Name="StyleButton" Style="{StaticResource IconButton}" Click="OnStyleMenu" ToolTip="Reading options" Margin="2,0,0,0">
                        <TextBlock Text="Aa" FontFamily="Georgia" FontSize="15" FontWeight="SemiBold" />
                    </Button>
                    <ToggleButton Style="{StaticResource ToolToggle}" Width="34" Height="34" Content="{x:Static core:Glyphs.Page}"
                                  IsChecked="{Binding Settings.ReaderLayout, Converter={StaticResource Equals}, ConverterParameter=pages, Mode=OneWay}"
                                  Command="{Binding ToggleLayoutCommand}" ToolTip="Page view — read it like a PDF (← → to turn pages)" Margin="2,0,0,0" />
                    <ToggleButton Style="{StaticResource ToolToggle}" Width="34" Height="34" Content="{x:Static core:Glyphs.BulletedList}" IsChecked="{Binding Settings.ReaderShowToc}"
                                  ToolTip="Table of contents" Margin="2,0,0,0" />
                    <ToggleButton Style="{StaticResource ToolToggle}" Width="34" Height="34" Content="{x:Static core:Glyphs.Edit}" IsChecked="{Binding IsEditing, Mode=OneWay}"
                                  Command="{Binding ToggleEditCommand}" ToolTip="Edit (live preview)" Margin="2,0,0,0" />
                    <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" ToolTip="More" Margin="2,0,0,0">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Favorite" Icon="{x:Static core:Glyphs.Star}" Command="{Binding ToggleFavoriteCommand}" />
                                <MenuItem Header="Rename…" Icon="{x:Static core:Glyphs.Edit}" Command="{Binding RenameCommand}" />
                                <MenuItem Header="Move to folder" Icon="{x:Static core:Glyphs.Folder}" ItemsSource="{Binding FolderChoices}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Label}" />
                                            <EventSetter Event="Click" Handler="OnMoveToFolder" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Export as .md…" Icon="{x:Static core:Glyphs.Export}" Command="{Binding ExportCommand}" />
                                <MenuItem Header="Print or save as PDF…" Icon="{x:Static core:Glyphs.Pdf}" Click="OnPrint" />
                                <MenuItem Header="{Binding SelectedDoc.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}" Icon="{x:Static core:Glyphs.Hide}"
                                          Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding SelectedDoc}" />
                                <Separator />
                                <MenuItem Header="Delete" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedDoc.Title}" Style="{StaticResource Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="{Binding SelectedDoc.ReadingMinutes, Mode=OneWay}" /><Run Text=" min read · " /><Run Text="{Binding SelectedDoc.WordCount, Mode=OneWay}" /><Run Text=" words · " /><Run Text="{Binding SelectedDoc.Progress, Mode=OneWay, Converter={StaticResource Percent}}" /><Run Text=" read" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- find bar -->
            <Border DockPanel.Dock="Top" Margin="28,0,24,10" Padding="6" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Visibility="{Binding IsFindOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="FindStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.ChevronUp}" Command="{Binding FindPreviousCommand}" ToolTip="Previous (Shift+Enter)" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.ChevronDown}" Command="{Binding FindNextCommand}" ToolTip="Next (Enter)" />
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CloseFindCommand}" ToolTip="Close (Esc)" />
                    </StackPanel>
                    <TextBox x:Name="FindBox" Style="{StaticResource InlineTextBox}" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Find in document"
                             VerticalContentAlignment="Center" PreviewKeyDown="OnFindKeyDown" />
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TocColumn" Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- editor (edit mode) -->
                <Border Grid.Column="0" Margin="24,0,8,20" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <TextBox x:Name="Editor" Style="{StaticResource InlineTextBox}" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="13.5" Padding="18,14"
                             VerticalContentAlignment="Top" SpellCheck.IsEnabled="{Binding SpellCheckInEditor, Mode=OneWay}" />
                </Border>

                <!-- the page -->
                <Border x:Name="Paper" Grid.Column="1" Margin="0,0,0,0" ClipToBounds="True">
                    <Grid>
                        <c:PagedReader x:Name="Pager" Visibility="Collapsed" />
                        <FlowDocumentScrollViewer x:Name="Reader" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="True" FocusVisualStyle="{x:Null}" SelectionBrush="{DynamicResource AccentBrush}" SelectionOpacity="0.35"
                                                  ContextMenu="{DynamicResource EditContextMenu}" />
                        <Border x:Name="ProgressTrack" Height="3" VerticalAlignment="Top" Background="Transparent">
                            <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" Width="0" />
                        </Border>
                    </Grid>
                </Border>

                <!-- table of contents -->
                <Border x:Name="TocPanel" Grid.Column="2" Width="230" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0" Padding="14,4,14,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Contents" Style="{StaticResource Overline}" Margin="6,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TocList" ItemsSource="{Binding Toc}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:TocEntry}">
                                        <Button Style="{StaticResource RowButton}" Click="OnTocClick" Padding="6,5" HorizontalContentAlignment="Left">
                                            <TextBlock x:Name="text" Text="{Binding Text}" TextTrimming="CharacterEllipsis" FontSize="12.5"
                                                       Margin="{Binding Indent}" />
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="1">
                                                <Setter TargetName="text" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- reading options -->
        <Popup x:Name="StylePopup" Grid.Column="1" PlacementTarget="{Binding ElementName=StyleButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Margin="6,4,10,14" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius}" Padding="16,14" Effect="{DynamicResource PopupShadow}" Width="300">
                <StackPanel>
                    <TextBlock Text="Theme" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ThemeSwatch}" Content="App" GroupName="rtheme" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                                     IsChecked="{Binding Settings.ReaderTheme, Converter={StaticResource Equals}, ConverterParameter=app}" />
                        <RadioButton Style="{StaticResource ThemeSwatch}" Content="Paper" GroupName="rtheme" Background="#FFFDF8" Foreground="#1F2328"
                                     IsChecked="{Binding Settings.ReaderTheme, Converter={StaticResource Equals}, ConverterParameter=paper}" />
                        <RadioButton Style="{StaticResource ThemeSwatch}" Content="Sepia" GroupName="rtheme" Background="#F4ECD8" Foreground="#4B3B2A"
                                     IsChecked="{Binding Settings.ReaderTheme, Converter={StaticResource Equals}, ConverterParameter=sepia}" />
                        <RadioButton Style="{StaticResource ThemeSwatch}" Content="Night" GroupName="rtheme" Background="#15171C" Foreground="#D0D4DA"
                                     IsChecked="{Binding Settings.ReaderTheme, Converter={StaticResource Equals}, ConverterParameter=night}" />
                    </StackPanel>
                    <TextBlock Text="Font" Style="{StaticResource Overline}" Margin="0,14,0,8" />
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource Segment}" Content="Serif" FontFamily="Georgia" IsChecked="{Binding Settings.ReaderFont, Converter={StaticResource Equals}, ConverterParameter=serif}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Book" FontFamily="Palatino Linotype" IsChecked="{Binding Settings.ReaderFont, Converter={StaticResource Equals}, ConverterParameter=book}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Sans" IsChecked="{Binding Settings.ReaderFont, Converter={StaticResource Equals}, ConverterParameter=sans}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Mono" FontFamily="{StaticResource MonoFont}" IsChecked="{Binding Settings.ReaderFont, Converter={StaticResource Equals}, ConverterParameter=mono}" />
                        </UniformGrid>
                    </Border>
                    <DockPanel Margin="0,14,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButtonSmall}" Content="A−" FontFamily="{DynamicResource UiFont}" Command="{Binding AdjustFontCommand}" CommandParameter="-1" />
                            <TextBlock Text="{Binding Settings.ReaderFontSize, StringFormat={}{0:0}}" VerticalAlignment="Center" Width="28" TextAlignment="Center" />
                            <Button Style="{StaticResource IconButtonSmall}" Content="A+" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" Command="{Binding AdjustFontCommand}" CommandParameter="1" />
                        </StackPanel>
                        <TextBlock Text="Text size" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Line spacing" Margin="0,12,0,4" />
                    <Slider Minimum="1.3" Maximum="2.1" SmallChange="0.05" Value="{Binding Settings.ReaderLineHeight}" />
                    <TextBlock Text="Line width" Margin="0,10,0,4" />
                    <Slider Minimum="520" Maximum="1100" SmallChange="20" Value="{Binding Settings.ReaderWidth}" />
                    <DockPanel Margin="0,12,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Settings.ReaderJustify}" />
                        <TextBlock Text="Justify and hyphenate" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,16,0,8">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsPageView}" />
                        <TextBlock Text="Page view" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource Segment}" Content="A4" GroupName="psize" IsChecked="{Binding Settings.ReaderPageSize, Converter={StaticResource Equals}, ConverterParameter=A4}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Letter" GroupName="psize" IsChecked="{Binding Settings.ReaderPageSize, Converter={StaticResource Equals}, ConverterParameter=Letter}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Book" GroupName="psize" IsChecked="{Binding Settings.ReaderPageSize, Converter={StaticResource Equals}, ConverterParameter=Book}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Fill" GroupName="psize" IsChecked="{Binding Settings.ReaderPageSize, Converter={StaticResource Equals}, ConverterParameter=Fill}" />
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="Margins" Margin="0,10,0,4" />
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource Segment}" Content="Narrow" GroupName="pmargin" IsChecked="{Binding Settings.ReaderMargins, Converter={StaticResource Equals}, ConverterParameter=narrow}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Normal" GroupName="pmargin" IsChecked="{Binding Settings.ReaderMargins, Converter={StaticResource Equals}, ConverterParameter=normal}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Wide" GroupName="pmargin" IsChecked="{Binding Settings.ReaderMargins, Converter={StaticResource Equals}, ConverterParameter=wide}" />
                        </UniformGrid>
                    </Border>
                    <DockPanel Margin="0,12,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Settings.ReaderTwoPages}" />
                        <TextBlock Text="Two pages side by side (when there's room)" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <c:DropOverlay x:Name="DropZone" Grid.ColumnSpan="2" Title="Drop to add to your Library"
                       Hint="Markdown and text files · Word documents (.docx, .doc) and RTF, turned into Markdown with their pictures · Excel and CSV files as tables" />
    </Grid>
</UserControl>
