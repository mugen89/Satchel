<UserControl x:Class="Satchel.Views.Pages.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <!-- Colored checkbox for calendar visibility -->
        <Style x:Key="ColorCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="hover" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource HoverOverlayBrush}" Opacity="0" Margin="-6,-4" />
                            <DockPanel>
                                <Grid Width="17" Height="17" VerticalAlignment="Center">
                                    <Border x:Name="box" CornerRadius="4" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" />
                                    <Border x:Name="fill" CornerRadius="4" Background="{TemplateBinding BorderBrush}" Opacity="0" />
                                    <TextBlock x:Name="mark" Text="{x:Static core:Glyphs.Check}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                                </Grid>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fill" Property="Opacity" Value="1" />
                                <Setter TargetName="mark" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="CalendarMenu" x:Shared="False">
            <MenuItem Header="Rename…" Icon="{x:Static core:Glyphs.Edit}"
                      Command="{Binding PlacementTarget.Tag.RenameCalendarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="Color" Icon="{x:Static core:Glyphs.Palette}" ItemsSource="{x:Static core:Palettes.Tags}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{Binding Key, Converter={StaticResource PaletteBrush}}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="Click" Handler="OnCalendarColorClick" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="{Binding IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark calendar private'}" Icon="{x:Static core:Glyphs.Hide}"
                      Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Delete calendar" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}"
                      Command="{Binding PlacementTarget.Tag.DeleteCalendarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>

        <!-- Month / all-day chip -->
        <DataTemplate x:Key="Chip" DataType="{x:Type vm:Occurrence}">
            <Border x:Name="chip" Margin="0,1" CornerRadius="5" Padding="5,2,6,2" Cursor="Hand" ToolTip="{Binding Tooltip}"
                    Background="{Binding ColorKey, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}"
                    b:DnD.DragData="{Binding DragPayload}" b:DnD.Group="event"
                    MouseLeftButtonDown="OnChipMouseDown" MouseLeftButtonUp="OnChipClick">
                <DockPanel>
                    <Border x:Name="bar" Width="3" CornerRadius="1.5" Margin="0,1,6,1" Background="{Binding ColorKey, Converter={StaticResource PaletteBrush}}" />
                    <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVis}}" />
                    <TextBlock x:Name="text" Text="{Binding ChipText}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSolid}" Value="True">
                    <Setter TargetName="chip" Property="Background" Value="{Binding ColorKey, Converter={StaticResource PaletteBrush}}" />
                    <Setter TargetName="text" Property="Foreground" Value="White" />
                    <Setter TargetName="glyph" Property="Foreground" Value="White" />
                    <Setter TargetName="bar" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="text" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="text" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="text" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Side panel ===== -->
        <Border Style="{StaticResource SidePanel}" Width="270">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Calendar" Style="{StaticResource PageTitle}" Margin="10,4,0,16" />
                <Button DockPanel.Dock="Top" Style="{StaticResource AccentButton}" Content="New event" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding NewEventCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,16" ToolTip="New event (Ctrl+N)" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,8,0,0">
                    <Button Style="{StaticResource LinkButton}" Content="Import .ics" Command="{Binding ImportIcsCommand}" FontSize="12" />
                    <TextBlock Text="  ·  " Style="{StaticResource Caption}" />
                    <Button Style="{StaticResource LinkButton}" Content="Export .ics" Command="{Binding ExportIcsCommand}" FontSize="12" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <StackPanel>
                        <c:MiniCalendar SelectedDate="{Binding MiniSelected}" MarkedDates="{Binding MarkedDates}" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Add}" FontSize="11"
                                    Command="{Binding NewCalendarCommand}" ToolTip="New calendar" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                            <TextBlock Text="Calendars" Style="{StaticResource SectionLabel}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Calendars}" Focusable="False" Margin="10,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource ColorCheck}" Content="{Binding Title}" IsChecked="{Binding IsVisible}" Margin="0,5"
                                              BorderBrush="{Binding ColorKey, Converter={StaticResource PaletteBrush}}"
                                              Command="{Binding DataContext.ToggleCalendarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource CalendarMenu}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Coming up" Style="{StaticResource SectionLabel}" Visibility="{Binding HasUpcoming, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Upcoming}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Padding="10,6" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding ColorKey, Converter={StaticResource PaletteBrush}}" Margin="0,6,10,0" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <Run Text="{Binding Start, Converter={StaticResource DateFormat}, ConverterParameter=friendly, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TimeText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Main ===== -->
        <Grid Grid.Column="1" Margin="24,0,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,2,0,16">
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Month" IsChecked="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=Month}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Week" IsChecked="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=Week}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Agenda" IsChecked="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=Agenda}" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Today" Command="{Binding TodayCommand}" MinHeight="34" Margin="0,0,10,0" />
                    <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.ChevronLeft}" FontSize="12" Command="{Binding PreviousCommand}" ToolTip="Previous" />
                    <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.ChevronRight}" FontSize="12" Command="{Binding NextCommand}" ToolTip="Next" />
                    <TextBlock x:Name="PeriodText" Text="{Binding PeriodTitle}" Style="{StaticResource Title}" FontSize="22" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Month -->
            <Grid Grid.Row="1" x:Name="MonthView" Visibility="{Binding IsMonth, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding WeekdayNames}" Focusable="False" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Overline}" Margin="12,0,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,1,0,0"
                        CornerRadius="{DynamicResource Radius}" ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="6" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonthDay}">
                                <Border x:Name="cell" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,1" Background="Transparent"
                                        b:DnD.Group="event" b:DnD.DropCommand="{Binding DataContext.MoveToDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        MouseLeftButtonDown="OnDayCellMouseDown">
                                    <Grid>
                                        <Border x:Name="tint" Background="{DynamicResource HoverOverlayBrush}" Opacity="0" />
                                        <DockPanel Margin="6,5,6,4">
                                            <Grid DockPanel.Dock="Top" Height="24" Margin="0,0,0,2">
                                                <Border x:Name="badge" HorizontalAlignment="Left" CornerRadius="12" MinWidth="24" Height="24" Padding="6,0">
                                                    <TextBlock x:Name="num" Text="{Binding DayText}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding MoreText}" FontSize="11.5" Foreground="{DynamicResource AccentTextBrush}" Margin="4,0,0,0"
                                                       Cursor="Hand" Visibility="{Binding More, Converter={StaticResource HasValueToVis}}" MouseLeftButtonUp="OnMoreClick" />
                                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Chip}" Focusable="False" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                        <Setter TargetName="tint" Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                        <Setter TargetName="num" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                        <Setter TargetName="tint" Property="Opacity" Value="0.8" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="badge" Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="num" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                        <Setter TargetName="num" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <Trigger SourceName="cell" Property="b:DnD.IsDragOver" Value="True">
                                        <Setter TargetName="cell" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- Week -->
            <Grid Grid.Row="1" x:Name="WeekView" Visibility="{Binding IsWeek, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding WeekColumns}" Margin="58,0,10,8" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WeekColumn}">
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                <Border x:Name="badge" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Center">
                                    <TextBlock x:Name="num" Text="{Binding DayNumber}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="name" Text="{Binding DayName}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="num" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                    <Setter TargetName="name" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="1" Margin="0,0,10,8">
                    <TextBlock Text="all-day" Style="{StaticResource Caption}" Width="52" TextAlignment="Right" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding WeekColumns}" Margin="58,0,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WeekColumn}">
                                <Border x:Name="cell" MinHeight="30" Margin="2,0" Padding="2" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource InputBrush}"
                                        b:DnD.Group="event" b:DnD.DropCommand="{Binding DataContext.MoveToDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl ItemsSource="{Binding AllDay}" ItemTemplate="{StaticResource Chip}" Focusable="False" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="cell" Property="b:DnD.IsDragOver" Value="True">
                                        <Setter TargetName="cell" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius}">
                    <ScrollViewer x:Name="WeekScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <Grid Height="{Binding GridHeight}" Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding Hours}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="52">
                                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,10,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Hours}" Focusable="False" IsHitTestVisible="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="52" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekColumns}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WeekColumn}">
                                        <Grid x:Name="col" Background="Transparent" b:DnD.Group="weekevent"
                                              b:DnD.DropCommand="{Binding DataContext.MoveInWeekCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              MouseLeftButtonDown="OnWeekColumnMouseDown">
                                            <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0" />
                                            <Border x:Name="todayTint" Background="{DynamicResource AccentSubtleBrush}" Opacity="0" />
                                            <ItemsControl ItemsSource="{Binding Timed}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                        <Setter Property="Canvas.Left">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                                    <Binding Path="Left" />
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Width">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                                    <Binding Path="Width" />
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:Occurrence}">
                                                        <Border x:Name="block" Height="{Binding Height}" Margin="2,1,3,1" CornerRadius="6" Padding="7,4,6,4" Cursor="Hand"
                                                                Background="{Binding ColorKey, Converter={StaticResource PaletteBrush}, ConverterParameter=subtle}"
                                                                BorderBrush="{Binding ColorKey, Converter={StaticResource PaletteBrush}}" BorderThickness="3,0,0,0"
                                                                ToolTip="{Binding Tooltip}" b:DnD.DragData="{Binding DragPayload}" b:DnD.Group="weekevent"
                                                                MouseLeftButtonDown="OnChipMouseDown" MouseLeftButtonUp="OnChipClick">
                                                            <Grid ClipToBounds="True">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock x:Name="range" Text="{Binding RangeText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                                    <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                                                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                                                                </StackPanel>
                                                                <Thumb x:Name="resize" Height="7" VerticalAlignment="Bottom" Margin="-7,0,-6,-4" Cursor="SizeNS"
                                                                       DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted">
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border Background="Transparent" />
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsShort}" Value="True">
                                                                <Setter TargetName="range" Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Task">
                                                                <Setter TargetName="resize" Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Canvas IsHitTestVisible="False" Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}">
                                                <Grid Canvas.Top="{Binding DataContext.NowTop, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="-5,-5,0,0"
                                                      Width="{Binding ActualWidth, ElementName=col}">
                                                    <Border Height="2" Background="{DynamicResource DangerBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource DangerBrush}" HorizontalAlignment="Left" />
                                                </Grid>
                                            </Canvas>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="todayTint" Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                            <Trigger SourceName="col" Property="b:DnD.IsDragOver" Value="True">
                                                <Setter TargetName="todayTint" Property="Opacity" Value="0.6" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Agenda -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsAgenda, Converter={StaticResource BoolToVis}}" Margin="0,0,-12,0" Padding="0,0,12,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Agenda}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AgendaGroup}">
                                <DockPanel Margin="0,0,0,20">
                                    <StackPanel DockPanel.Dock="Left" Width="130" Margin="4,6,0,0">
                                        <TextBlock x:Name="title" Text="{Binding Title}" Style="{StaticResource Subtitle}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <c:AnimatedStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:Occurrence}">
                                                <Button Style="{StaticResource CardButton}" Padding="14,10" Margin="0,0,0,8"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding ColorKey, Converter={StaticResource PaletteBrush}}" Margin="0,0,14,0" />
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding RangeText}" Width="130" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="title" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center" Visibility="{Binding Agenda.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}">
                        <Border Style="{StaticResource EmptyIcon}">
                            <TextBlock Text="{x:Static core:Glyphs.Calendar}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock Text="Nothing scheduled" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock Text="The next 60 days are wide open." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
