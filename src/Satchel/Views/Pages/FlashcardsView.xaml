<UserControl x:Class="Satchel.Views.Pages.FlashcardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:s="clr-namespace:Satchel.Services"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnKeyDown">
    <UserControl.Resources>
        <Style x:Key="GradeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Margin" Value="5,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Decks ===== -->
        <Border Style="{StaticResource SidePanel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Flashcards" Style="{StaticResource PageTitle}" Margin="6,4,0,4" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="8,0,0,12"><Run Text="{Binding DueToday, Mode=OneWay}" /><Run Text=" due now across all decks" /></TextBlock>
                <Button DockPanel.Dock="Bottom" Content="New deck" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding NewDeckCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding Decks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Deck}">
                                <RadioButton Style="{StaticResource SideItem}" GroupName="decks" Height="48"
                                             Command="{Binding DataContext.SelectDeckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource SameObject}" Mode="OneWay">
                                            <Binding />
                                            <Binding Path="DataContext.SelectedDeck" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" MinWidth="22" Height="20" CornerRadius="10" Padding="6,0" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding Due, Converter={StaticResource HasValueToVis}}" ToolTip="Due now">
                                            <TextBlock Text="{Binding Due}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}" FontWeight="Normal" FontSize="11"><Run Text="{Binding Total, Mode=OneWay}" /><Run Text=" cards · " /><Run Text="{Binding New, Mode=OneWay}" /><Run Text=" new" /></TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Deck ===== -->
        <DockPanel Grid.Column="1" Margin="28,0,24,0" Visibility="{Binding HasDeck, Converter={StaticResource BoolToVis}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Import" b:Ui.Icon="{x:Static core:Glyphs.Import}" b:Ui.MenuOnClick="True" Margin="0,0,8,0">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Paste cards…" Icon="{x:Static core:Glyphs.Copy}" Command="{Binding ImportTextCommand}" />
                                <MenuItem Header="From a text / CSV file…" Icon="{x:Static core:Glyphs.Document}" Command="{Binding ImportFileCommand}" />
                                <Separator />
                                <MenuItem Header="Export (Anki-compatible)…" Icon="{x:Static core:Glyphs.Export}" Command="{Binding ExportCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Content="{Binding StudyButtonText}" b:Ui.Icon="{x:Static core:Glyphs.Play}" Command="{Binding StartStudyCommand}"
                            IsEnabled="{Binding CanStudy}" ToolTip="Space shows the answer, 1–4 grade it" />
                    <Button Style="{StaticResource IconButton}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" Margin="6,0,0,0" ToolTip="Deck options">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename deck…" Icon="{x:Static core:Glyphs.Edit}" Command="{Binding RenameDeckCommand}" />
                                <MenuItem Header="New cards per day…" Icon="{x:Static core:Glyphs.Sliders}" Command="{Binding SetNewPerDayCommand}" />
                                <MenuItem Header="{Binding SelectedDeck.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}"
                                          Icon="{x:Static core:Glyphs.Hide}" Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding SelectedDeck}" />
                                <Separator />
                                <MenuItem Header="Delete deck" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteDeckCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedDeck.Name}" Style="{StaticResource Title}" FontSize="22" />
                    <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding SelectedDeck.Total, Mode=OneWay}" /><Run Text=" cards · " /><Run Text="{Binding SelectedDeck.Due, Mode=OneWay}" /><Run Text=" due · " /><Run Text="{Binding SelectedDeck.New, Mode=OneWay}" /><Run Text=" new · " /><Run Text="{Binding SelectedDeck.NewPerDay, Mode=OneWay}" /><Run Text=" new a day" /></TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- quick add -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FrontBox" Text="{Binding NewFront, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="54" b:Ui.Placeholder="Front — the question"
                             PreviewKeyDown="OnAddKeyDown" />
                    <TextBox Grid.Column="2" Text="{Binding NewBack, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="54" b:Ui.Placeholder="Back — the answer"
                             PreviewKeyDown="OnAddKeyDown" />
                    <Button Grid.Column="3" Style="{StaticResource AccentButton}" Content="Add" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding AddCardCommand}" Margin="10,0,0,0"
                            VerticalAlignment="Stretch" ToolTip="Add the card (Ctrl+Enter)" />
                </Grid>
            </Border>

            <!-- editor for a card -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,14" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{DynamicResource AccentBrush}">
                <StackPanel DataContext="{Binding Editing}">
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="Reset progress" Command="{Binding DataContext.ResetCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Style="{StaticResource GhostButton}" Content="{Binding IsSuspended, Converter={StaticResource BoolToString}, ConverterParameter='Unsuspend|Suspend'}"
                                    Command="{Binding DataContext.ToggleSuspendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Suspended cards are never shown" />
                            <Button Style="{StaticResource DangerGhostButton}" Content="Delete" Command="{Binding DataContext.DeleteCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                        <TextBlock Text="Edit card" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Front, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="60" />
                        <TextBox Grid.Column="2" Text="{Binding Back, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="60" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"><Run Text="{Binding DueText, Mode=OneWay}" /><Run Text=" · interval " /><Run Text="{Binding IntervalDays, Mode=OneWay, StringFormat={}{0:0} d}" /><Run Text=" · ease " /><Run Text="{Binding Ease, Mode=OneWay, StringFormat={}{0:0.00}}" /><Run Text=" · " /><Run Text="{Binding Lapses, Mode=OneWay}" /><Run Text=" lapses" /></TextBlock>
                </StackPanel>
            </Border>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox Style="{StaticResource SearchBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" b:Ui.Placeholder="Search cards" MinHeight="32" Width="260"
                         HorizontalAlignment="Left" />
            </DockPanel>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,20">
                    <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Flashcard}">
                                <Button x:Name="row" Style="{StaticResource RowButton}" Padding="10,8" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.EditCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Front}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Back}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="due" Grid.Column="3" Text="{Binding DueText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDue}" Value="True">
                                        <Setter TargetName="due" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                        <Setter TargetName="row" Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="No cards yet — type a question and its answer above, or import a list." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,40,0,0"
                           Visibility="{Binding HasCards, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
            </Grid>
        </DockPanel>

        <!-- no decks -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasDecks, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" b:Motion.Enter="True">
            <Border Style="{StaticResource EmptyIcon}">
                <TextBlock Text="{x:Static core:Glyphs.Education}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
            </Border>
            <TextBlock Text="Remember anything" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
            <TextBlock Text="Make a deck of cards. Satchel shows each one again just before you'd forget it." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            <Button Style="{StaticResource AccentButton}" Content="Create a deck" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding NewDeckCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>

        <!-- ===== Study ===== -->
        <Grid x:Name="StudyLayer" Grid.ColumnSpan="2" Background="{DynamicResource BgBrush}" Visibility="{Binding IsStudying, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="40,10,40,30" MaxWidth="900">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="End session" b:Ui.Icon="{x:Static core:Glyphs.Close}" Command="{Binding EndStudyCommand}" ToolTip="Esc" />
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedDeck.Name}" Style="{StaticResource Overline}" FontSize="12" />
                        <Grid Height="6" Margin="0,8,24,0">
                            <Border Background="{DynamicResource SegmentBrush}" CornerRadius="3" />
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressWidth}">
                                        <Binding Path="SessionProgress" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"><Run Text="{Binding Remaining, Mode=OneWay}" /><Run Text=" left" /></TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- grade buttons -->
                <Grid DockPanel.Dock="Bottom" Margin="0,22,0,0" Height="60">
                    <Button Style="{StaticResource AccentButton}" Content="Show answer" HorizontalAlignment="Center" MinWidth="220" MinHeight="48" Command="{Binding FlipCommand}"
                            ToolTip="Space" Visibility="{Binding IsFlipped, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding IsFlipped, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource GradeButton}" Command="{Binding AnswerCommand}" CommandParameter="1" ToolTip="1">
                            <StackPanel><TextBlock Text="Again" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource DangerBrush}" /><TextBlock Text="{Binding AgainText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GradeButton}" Command="{Binding AnswerCommand}" CommandParameter="2" ToolTip="2">
                            <StackPanel><TextBlock Text="Hard" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource WarningBrush}" /><TextBlock Text="{Binding HardText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GradeButton}" Command="{Binding AnswerCommand}" CommandParameter="3" ToolTip="3">
                            <StackPanel><TextBlock Text="Good" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="{Binding GoodText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GradeButton}" Command="{Binding AnswerCommand}" CommandParameter="4" ToolTip="4">
                            <StackPanel><TextBlock Text="Easy" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource InfoBrush}" /><TextBlock Text="{Binding EasyText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- the card -->
                <Grid>
                    <Border x:Name="CardFace" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusLarge}"
                            Effect="{DynamicResource LiftShadow}" RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="OnCardClick" Cursor="Hand"
                            Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CardFlip" />
                        </Border.RenderTransform>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel VerticalAlignment="Center" Margin="40,30">
                                <TextBlock Text="{Binding Current.Front}" FontFamily="{StaticResource DisplayFont}" FontSize="30" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                <StackPanel Visibility="{Binding IsFlipped, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource Divider}" Margin="60,26" />
                                    <TextBlock Text="{Binding Current.Back}" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}" b:Motion.Enter="True">
                        <TextBlock Text="🎉" FontFamily="{StaticResource EmojiFont}" FontSize="48" HorizontalAlignment="Center" />
                        <TextBlock Text="Session complete" Style="{StaticResource Title}" FontSize="24" HorizontalAlignment="Center" Margin="0,12,0,6" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource AccentButton}" Content="Back to the deck" Command="{Binding EndStudyCommand}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
