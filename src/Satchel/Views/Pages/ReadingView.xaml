<UserControl x:Class="Satchel.Views.Pages.ReadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <!-- Book cover: the real cover, or a generated one in the book's colour -->
        <DataTemplate x:Key="CoverArt" DataType="{x:Type m:Book}">
            <Grid>
                <Border CornerRadius="3,6,6,3" Background="{Binding Color, Converter={StaticResource PaletteBrush}}" Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Border Width="10" HorizontalAlignment="Left" CornerRadius="3,0,0,3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#40000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="16,14,10,0"
                                   VerticalAlignment="Top" TextTrimming="CharacterEllipsis" MaxHeight="96" />
                        <TextBlock Text="{Binding Author}" FontFamily="Georgia" FontSize="11" Foreground="#D9FFFFFF" TextWrapping="Wrap" Margin="16,0,10,12"
                                   VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <Border CornerRadius="3,6,6,3" ClipToBounds="True" Visibility="{Binding Cover, Converter={StaticResource HasValueToVis}}">
                    <Image Source="{Binding Cover, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="150" />
        </Style>

        <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ===== Main ===== -->
        <DockPanel Margin="28,0,24,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Add book" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding OpenAddCommand}"
                        ToolTip="Add a book (Ctrl+N)" VerticalAlignment="Center" />
                <TextBlock Text="Reading" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- stats -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Style="{StaticResource StatTile}">
                    <Button Style="{StaticResource RowButton}" Padding="0" Command="{Binding SetGoalCommand}" ToolTip="Change your yearly goal">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,12,0">
                                <c:ProgressRing Progress="{Binding GoalProgress}" Thickness="6" RingBrush="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{x:Static core:Glyphs.Book}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding FinishedThisYear, Mode=OneWay}" /><Run Text=" / " Foreground="{DynamicResource TextFaintBrush}" /><Run Text="{Binding Goal, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                                <TextBlock Text="books this year" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PagesThisMonth}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="pages this month" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="SemiBold"><Run Text="{Binding Streak, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Static core:Glyphs.Lightning}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource WarningBrush}" /></TextBlock>
                        <TextBlock Text="day reading streak" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- shelves -->
            <Border DockPanel.Dock="Top" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="Reading" IsChecked="{Binding View, Converter={StaticResource Equals}, ConverterParameter=Reading}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Want to read" IsChecked="{Binding View, Converter={StaticResource Equals}, ConverterParameter=WantToRead}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Finished" IsChecked="{Binding View, Converter={StaticResource Equals}, ConverterParameter=Finished}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Stopped" IsChecked="{Binding View, Converter={StaticResource Equals}, ConverterParameter=Stopped}" />
                    <RadioButton Style="{StaticResource Segment}" Content="All" IsChecked="{Binding View, Converter={StaticResource Equals}, ConverterParameter=All}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Quotes" b:Ui.Icon="{x:Static core:Glyphs.Quote}" IsChecked="{Binding View, Converter={StaticResource Equals}, ConverterParameter=Quotes}" />
                </StackPanel>
            </Border>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,24"
                              Visibility="{Binding IsQuotesView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel>
                        <!-- currently reading: big cards -->
                        <ItemsControl ItemsSource="{Binding Shelf}" Focusable="False" Visibility="{Binding IsReadingView, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Book}">
                                    <Button Style="{StaticResource CardButton}" Width="420" Margin="0,0,16,16" Padding="14" b:Motion.Enter="True"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <DockPanel>
                                            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource CoverArt}" Width="92" Height="138" Focusable="False" />
                                            <StackPanel Margin="16,2,0,0">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Author}" Style="{StaticResource Muted}" Margin="0,2,0,12" />
                                                <Grid Height="6" Margin="0,0,0,6">
                                                    <Border Background="{DynamicResource SegmentBrush}" CornerRadius="3" />
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource ProgressWidth}">
                                                                <Binding Path="Progress" />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" />
                                                <Button Content="+10 pages" b:Ui.Icon="{x:Static core:Glyphs.Add}" HorizontalAlignment="Left" Margin="0,12,0,0" MinHeight="30"
                                                        Command="{Binding DataContext.QuickPagesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- other shelves: cover grid -->
                        <ItemsControl ItemsSource="{Binding Shelf}" Focusable="False" Visibility="{Binding IsReadingView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Book}">
                                    <Button Style="{StaticResource RowButton}" Width="150" Margin="0,0,14,18" Padding="4" b:Motion.Enter="True" VerticalContentAlignment="Top"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CoverArt}" Width="138" Height="207" Focusable="False" b:Motion.Lift="True" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                                            <TextBlock Text="{Binding Author}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="2,1,2,0" />
                                            <StackPanel Orientation="Horizontal" Margin="2,3,0,0" Visibility="{Binding Rating, Converter={StaticResource HasValueToVis}}">
                                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=1}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=2}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=3}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=4}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=5}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 14-day chart -->
                        <Border Style="{StaticResource Card}" Padding="18,14" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding IsReadingView, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Pages read · last 14 days" Style="{StaticResource Overline}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Last14Days}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DayBar}">
                                            <StackPanel Width="36" ToolTip="{Binding Pages}">
                                                <Grid Height="60">
                                                    <Border Width="16" Height="{Binding BarHeight}" VerticalAlignment="Bottom" CornerRadius="4,4,1,1" Background="{DynamicResource AccentBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- quotes wall -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,24" Visibility="{Binding IsQuotesView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding AllQuotes}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:MasonryPanel MinColumnWidth="300" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuoteRow}">
                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,14,14">
                                    <StackPanel>
                                        <TextBlock Text="“" FontFamily="Georgia" FontSize="40" Foreground="{DynamicResource AccentTextBrush}" Height="30" Margin="0,-8,0,0" />
                                        <TextBlock Text="{Binding Quote.Text}" FontFamily="Georgia" FontSize="15" FontStyle="Italic" TextWrapping="Wrap" LineHeight="23" />
                                        <DockPanel Margin="0,12,0,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Copy}" ToolTip="Copy"
                                                    Command="{Binding DataContext.CopyQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Quote}" />
                                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Book.Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · p. " /><Run Text="{Binding Quote.Page, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" b:Motion.Enter="True">
                    <Border Style="{StaticResource EmptyIcon}">
                        <TextBlock Text="{x:Static core:Glyphs.Book}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <TextBlock Text="Your bookshelf is empty" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="Add books you're reading or want to read — find them online with covers." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource AccentButton}" Content="Add a book" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding OpenAddCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ===== Detail panel ===== -->
        <Border Grid.Column="1" Width="380" Style="{StaticResource DetailPanel}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,14,14,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" ToolTip="More">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Choose cover…" Icon="{x:Static core:Glyphs.Picture}" Command="{Binding PickCoverCommand}" />
                                    <MenuItem Header="Paste cover" Icon="{x:Static core:Glyphs.Copy}" Command="{Binding PasteCoverCommand}" />
                                    <MenuItem Header="Find cover online" Icon="{x:Static core:Glyphs.Globe}" Command="{Binding FindCoverCommand}" />
                                    <MenuItem Header="{Binding Selected.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}" Icon="{x:Static core:Glyphs.Hide}"
                                              Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding Selected}" />
                                    <Separator />
                                    <MenuItem Header="Remove book" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteBookCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CloseDetailCommand}" ToolTip="Close" />
                    </StackPanel>
                    <TextBlock Text="Book" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,10,20,24" DataContext="{Binding Selected}">
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource CoverArt}" Width="96" Height="144" Focusable="False" />
                            <StackPanel Margin="14,0,0,0">
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineTextBox}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                         b:Ui.Placeholder="Title" />
                                <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineTextBox}" Foreground="{DynamicResource TextMutedBrush}" b:Ui.Placeholder="Author" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource StarButton}" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=1}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=1}" Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="1" />
                                    <Button Style="{StaticResource StarButton}" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=2}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=2}" Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="2" />
                                    <Button Style="{StaticResource StarButton}" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=3}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=3}" Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="3" />
                                    <Button Style="{StaticResource StarButton}" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=4}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=4}" Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="4" />
                                    <Button Style="{StaticResource StarButton}" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=5}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=5}" Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="5" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl ItemsSource="{x:Static vm:ReadingViewModel.Statuses}" Focusable="False" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ChipRadio}" Content="{Binding Label}" b:Ui.Icon="{Binding Glyph}" GroupName="bstatus" Margin="0,0,6,6"
                                                 Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource AllEqual}" Mode="OneWay">
                                                <Binding Path="Value" />
                                                <Binding Path="DataContext.Selected.Status" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Progress" Style="{StaticResource FieldLabel}" />
                        <Grid Height="6" Margin="0,0,0,6">
                            <Border Background="{DynamicResource SegmentBrush}" CornerRadius="3" />
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressWidth}">
                                        <Binding Path="Progress" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" />
                        <DockPanel Margin="0,10,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button DockPanel.Dock="Right" Content="+25" Command="{Binding LogProgressCommand}" CommandParameter="+25" Margin="6,0,0,0" MinHeight="32" />
                            <Button DockPanel.Dock="Right" Content="+10" Command="{Binding LogProgressCommand}" CommandParameter="+10" Margin="6,0,0,0" MinHeight="32" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleAccentButton}" Content="Save" Command="{Binding LogProgressCommand}" Margin="6,0,0,0" MinHeight="32" />
                            <TextBox Text="{Binding PageInput, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="I'm on page…" MinHeight="32" b:Ui.EnterCommand="{Binding LogProgressCommand}" />
                        </DockPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Total pages" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding TotalPages, UpdateSourceTrigger=LostFocus}" MinHeight="32" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Format" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{x:Static vm:ReadingViewModel.Formats}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Format}" MinHeight="32" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Started" Style="{StaticResource FieldLabel}" />
                                <c:DateBox SelectedDate="{Binding StartedAt}" Placeholder="—" AllowClear="True" KeepTime="False" MinHeight="32" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Finished" Style="{StaticResource FieldLabel}" />
                                <c:DateBox SelectedDate="{Binding FinishedAt}" Placeholder="—" AllowClear="True" KeepTime="False" MinHeight="32" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="70" b:Ui.Placeholder="Thoughts, review, why you picked it…" />

                        <DockPanel Margin="0,18,0,6" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Quotes.Count}" />
                            <TextBlock Text="Quotes" Style="{StaticResource Overline}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding DataContext.Quotes, RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:BookQuote}">
                                    <Border x:Name="row" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" Padding="10,4" Margin="0,0,0,8" Background="Transparent">
                                        <DockPanel>
                                            <Button x:Name="del" DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Delete}" Opacity="0" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.DeleteQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" FontFamily="Georgia" FontStyle="Italic" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"><Run Text="p. " /><Run Text="{Binding Page, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="del" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBox Text="{Binding NewQuote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="54" b:Ui.Placeholder="A line worth keeping…" />
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Add quote" b:Ui.Icon="{x:Static core:Glyphs.Quote}" Command="{Binding AddQuoteCommand}" MinHeight="32" />
                                <TextBox Text="{Binding NewQuotePage, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Page" Width="80" HorizontalAlignment="Left" MinHeight="32" />
                            </DockPanel>
                        </StackPanel>

                        <TextBlock Text="Sessions" Style="{StaticResource Overline}" Margin="0,18,0,6" />
                        <ItemsControl ItemsSource="{Binding DataContext.Sessions, RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:ReadingSession}">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"><Run Text="+" /><Run Text="{Binding Pages, Mode=OneWay}" /><Run Text=" → p. " /><Run Text="{Binding ToPage, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding Date, Converter={StaticResource DateFormat}, ConverterParameter=relative}" Style="{StaticResource Caption}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Add book overlay ===== -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}">
            <Border Width="600" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource ElevatedBrush}" CornerRadius="{DynamicResource RadiusLarge}"
                    Effect="{DynamicResource DialogShadow}" Padding="22,18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CloseAddCommand}" />
                        <TextBlock Text="Add a book" Style="{StaticResource Title}" />
                    </DockPanel>
                    <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Title, author or ISBN"
                             b:Ui.EnterCommand="{Binding SearchCommand}" b:Ui.FocusOnLoad="True" MinHeight="40" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Search" b:Ui.Icon="{x:Static core:Glyphs.Search}" Command="{Binding SearchCommand}" />
                        <Button DockPanel.Dock="Right" Content="Add by hand" Command="{Binding AddManualCommand}" Margin="0,0,8,0" />
                        <TextBlock Text="Book data and covers from Open Library" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="{Binding SearchMessage}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,30" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="120">
                            <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BookSearchResult}">
                                        <Border Padding="6" Margin="0,0,0,4" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="42" Height="62" CornerRadius="3" Background="{DynamicResource SegmentBrush}" ClipToBounds="True" Margin="0,0,12,0">
                                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                                </Border>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleAccentButton}" Content="Add" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.AddResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Author}" Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextFaintBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
