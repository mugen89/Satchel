<UserControl x:Class="Satchel.Views.Pages.WatchingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Satchel.Controls"
             xmlns:b="clr-namespace:Satchel.Behaviors"
             xmlns:core="clr-namespace:Satchel.Core"
             xmlns:m="clr-namespace:Satchel.Models"
             xmlns:s="clr-namespace:Satchel.Services"
             xmlns:vm="clr-namespace:Satchel.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="Poster" DataType="{x:Type m:WatchItem}">
            <Grid>
                <Border CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{Binding Color, Converter={StaticResource ColorKeyToColor}}" Offset="0" />
                            <GradientStop Color="#FF1B1F27" Offset="1.2" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Top corner, so the title along the bottom never runs over it on small posters. -->
                        <TextBlock Text="{x:Static core:Glyphs.Monitor}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#59FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="White" TextWrapping="Wrap" Margin="8" VerticalAlignment="Bottom" MaxHeight="48" />
                    </Grid>
                </Border>
                <Border CornerRadius="6" ClipToBounds="True" Visibility="{Binding Poster, Converter={StaticResource HasValueToVis}}">
                    <Image Source="{Binding Poster, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BoardCard" DataType="{x:Type m:WatchItem}">
            <Button Style="{StaticResource CardButton}" Padding="8" Margin="0,0,0,8" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Poster}" Width="50" Height="74" Focusable="False" />
                    <StackPanel Margin="10,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding NextEpisode.Label, StringFormat=Next: {0}}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentTextBrush}"
                                   TextTrimming="CharacterEllipsis" Visibility="{Binding HasNextEpisode, Converter={StaticResource BoolToVis}}" />
                        <Grid Height="4" Margin="0,6,0,0" Visibility="{Binding EpisodeCount, Converter={StaticResource HasValueToVis}}">
                            <Border Background="{DynamicResource SegmentBrush}" CornerRadius="2" />
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressWidth}">
                                        <Binding Path="Progress" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="Column" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SegmentBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Width" Value="262" />
        </Style>

        <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="28,0,24,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" b:Ui.Icon="{x:Static core:Glyphs.Tiles}" ToolTip="Board" IsChecked="{Binding IsBoardView, Mode=OneWay}" Command="{Binding ShowBoardCommand}" Padding="10,0" />
                            <RadioButton Style="{StaticResource Segment}" b:Ui.Icon="{x:Static core:Glyphs.Grid}" ToolTip="Posters" IsChecked="{Binding IsLibraryView, Mode=OneWay}" Command="{Binding ShowLibraryCommand}" Padding="10,0" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource AccentButton}" Content="Add" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding OpenAddCommand}" ToolTip="Add a show or movie (Ctrl+N)" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Watching" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="{Binding Watching.Count, Mode=OneWay}" /><Run Text=" watching · " /><Run Text="{Binding Planned.Count, Mode=OneWay}" /><Run Text=" planned · " /><Run Text="{Binding EpisodesThisMonth, Mode=OneWay}" /><Run Text=" episodes this month · " /><Run Text="{Binding FinishedThisYear, Mode=OneWay}" /><Run Text=" finished this year" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <Grid>
                <!-- board -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsBoardView, Converter={StaticResource BoolToVis}}" Padding="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Column}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="4,0,0,10" FontWeight="SemiBold"><Run Text="{x:Static core:Glyphs.Play}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" /><Run Text="  Watching  " /><Run Text="{Binding Watching.Count, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Watching}" ItemTemplate="{StaticResource BoardCard}" MinHeight="140" Focusable="False" Background="Transparent"
                                                  b:DnD.IsReorderable="True" b:DnD.Group="watch" b:DnD.Mode="Vertical" b:DnD.ListTag="Watching" b:DnD.ReorderCommand="{Binding ReorderCommand}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:AnimatedStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Column}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="4,0,0,10" FontWeight="SemiBold"><Run Text="{x:Static core:Glyphs.Bookmark}" FontFamily="{StaticResource IconFont}" FontSize="11" /><Run Text="  Plan to watch  " /><Run Text="{Binding Planned.Count, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Planned}" ItemTemplate="{StaticResource BoardCard}" MinHeight="140" Focusable="False" Background="Transparent"
                                                  b:DnD.IsReorderable="True" b:DnD.Group="watch" b:DnD.Mode="Vertical" b:DnD.ListTag="Planned" b:DnD.ReorderCommand="{Binding ReorderCommand}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:AnimatedStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Column}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="4,0,0,10" FontWeight="SemiBold"><Run Text="{x:Static core:Glyphs.Completed}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" /><Run Text="  Completed  " /><Run Text="{Binding Completed.Count, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Completed}" ItemTemplate="{StaticResource BoardCard}" MinHeight="140" Focusable="False" Background="Transparent"
                                                  b:DnD.IsReorderable="True" b:DnD.Group="watch" b:DnD.Mode="Vertical" b:DnD.ListTag="Completed" b:DnD.ReorderCommand="{Binding ReorderCommand}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:AnimatedStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Column}" Margin="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="4,0,0,10" FontWeight="SemiBold"><Run Text="{x:Static core:Glyphs.Pause}" FontFamily="{StaticResource IconFont}" FontSize="11" /><Run Text="  On hold · dropped  " /><Run Text="{Binding OnHold.Count, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding OnHold}" ItemTemplate="{StaticResource BoardCard}" MinHeight="140" Focusable="False" Background="Transparent"
                                                  b:DnD.IsReorderable="True" b:DnD.Group="watch" b:DnD.Mode="Vertical" b:DnD.ListTag="OnHold" b:DnD.ReorderCommand="{Binding ReorderCommand}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:AnimatedStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- posters -->
                <DockPanel Visibility="{Binding IsLibraryView, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBox DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" b:Ui.Placeholder="Search titles and genres"
                                 Width="280" MinHeight="34" b:Ui.EscapeCommand="{Binding ClearSearchCommand}" Margin="0,0,12,0" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ChipRadio}" Content="All" GroupName="wf" Margin="0,0,6,0" IsChecked="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=All, Mode=OneWay}" Command="{Binding SetLibraryFilterCommand}" CommandParameter="All" />
                            <RadioButton Style="{StaticResource ChipRadio}" Content="Shows" GroupName="wf" Margin="0,0,6,0" IsChecked="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=Shows, Mode=OneWay}" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Shows" />
                            <RadioButton Style="{StaticResource ChipRadio}" Content="Movies" GroupName="wf" Margin="0,0,6,0" IsChecked="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=Movies, Mode=OneWay}" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Movies" />
                            <RadioButton Style="{StaticResource ChipRadio}" Content="Completed" GroupName="wf" Margin="0,0,6,0" IsChecked="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=Completed, Mode=OneWay}" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Completed" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,24">
                        <ItemsControl ItemsSource="{Binding LibraryItems}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:WatchItem}">
                                    <Button Style="{StaticResource RowButton}" Width="160" Margin="0,0,12,16" Padding="4" VerticalContentAlignment="Top" b:Motion.Enter="True"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Poster}" Width="148" Height="222" Focusable="False" b:Motion.Lift="True" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="2,1,2,0" TextTrimming="CharacterEllipsis"><Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ProgressText, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" b:Motion.Enter="True">
                    <Border Style="{StaticResource EmptyIcon}">
                        <TextBlock Text="{x:Static core:Glyphs.Monitor}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <TextBlock Text="Movies and shows" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="Keep your watch list, tick off episodes and always know what's next." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource AccentButton}" Content="Add something to watch" b:Ui.Icon="{x:Static core:Glyphs.Add}" Command="{Binding OpenAddCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ===== Detail ===== -->
        <Border Grid.Column="1" Width="390" Style="{StaticResource DetailPanel}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,14,14,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.More}" b:Ui.MenuOnClick="True" ToolTip="More">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Choose poster…" Icon="{x:Static core:Glyphs.Picture}" Command="{Binding PickPosterCommand}" />
                                    <MenuItem Header="Update episodes" Icon="{x:Static core:Glyphs.Refresh}" Command="{Binding RefreshEpisodesCommand}" />
                                    <MenuItem Header="Open page" Icon="{x:Static core:Glyphs.OpenExternal}" Command="{Binding OpenPageCommand}" />
                                    <MenuItem Header="{Binding Selected.IsPrivate, Converter={StaticResource BoolToString}, ConverterParameter='Remove private flag|Mark private'}"
                                              Icon="{x:Static core:Glyphs.Hide}" Command="{x:Static s:PrivacyCommands.Toggle}" CommandParameter="{Binding Selected}" />
                                    <Separator />
                                    <MenuItem Header="Remove" Icon="{x:Static core:Glyphs.Delete}" Style="{StaticResource DangerMenuItem}" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CloseDetailCommand}" ToolTip="Close" />
                    </StackPanel>
                    <TextBlock Text="{Binding Selected.Subtitle}" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,10,20,24" DataContext="{Binding Selected}">
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Poster}" Width="100" Height="150" Focusable="False" />
                            <StackPanel Margin="14,0,0,0">
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineTextBox}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Genres}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="-4,6,0,0">
                                    <Button Style="{StaticResource StarButton}" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=1}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=1}" Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="1" />
                                    <Button Style="{StaticResource StarButton}" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=2}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=2}" Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="2" />
                                    <Button Style="{StaticResource StarButton}" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=3}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=3}" Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="3" />
                                    <Button Style="{StaticResource StarButton}" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=4}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=4}" Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="4" />
                                    <Button Style="{StaticResource StarButton}" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}, ConverterParameter=5}" Content="{Binding Rating, Converter={StaticResource RatingStar}, ConverterParameter=5}" Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="5" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Button HorizontalAlignment="Stretch" Margin="0,14,0,0" b:Ui.Icon="{x:Static core:Glyphs.Check}"
                                Command="{Binding DataContext.WatchedNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Content" Value="{Binding NextEpisode.Label, StringFormat=Watched {0}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMovie}" Value="True">
                                            <Setter Property="Content" Value="I watched it" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasNextEpisode}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMovie}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <ItemsControl ItemsSource="{x:Static vm:WatchingViewModel.Statuses}" Focusable="False" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ChipRadio}" Content="{Binding Label}" b:Ui.Icon="{Binding Glyph}" GroupName="wstatus" Margin="0,0,6,6"
                                                 Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource AllEqual}" Mode="OneWay">
                                                <Binding Path="Value" />
                                                <Binding Path="DataContext.Selected.Status" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Overview}" Style="{StaticResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" MaxHeight="160" TextTrimming="WordEllipsis"
                                   Visibility="{Binding Overview, Converter={StaticResource HasValueToVis}}" />

                        <!-- seasons -->
                        <ItemsControl ItemsSource="{Binding DataContext.Seasons, RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SeasonGroup}">
                                    <Expander Margin="0,4,0,0">
                                        <Expander.Header>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="All" MinHeight="24" Padding="8,0" ToolTip="Mark the whole season watched / unwatched"
                                                        Command="{Binding DataContext.WatchSeasonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <TextBlock VerticalAlignment="Center"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Progress, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                                            </DockPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Episodes}" Focusable="False" Margin="4,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:Episode}">
                                                    <DockPanel Margin="0,1">
                                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Watched, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                  Command="{Binding DataContext.ToggleEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Airdate}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5" />
                                                    </DockPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasAired}" Value="False">
                                                            <Setter TargetName="label" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Where to watch" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Network, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Netflix, cinema, Blu-ray…" MinHeight="32" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Started" Style="{StaticResource FieldLabel}" />
                                <c:DateBox SelectedDate="{Binding StartedAt}" Placeholder="—" AllowClear="True" KeepTime="False" MinHeight="32" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Finished" Style="{StaticResource FieldLabel}" />
                                <c:DateBox SelectedDate="{Binding FinishedAt}" Placeholder="—" AllowClear="True" KeepTime="False" MinHeight="32" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="70" b:Ui.Placeholder="Thoughts, favourite scenes, who recommended it…" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Add overlay ===== -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}">
            <Border Width="620" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource ElevatedBrush}" CornerRadius="{DynamicResource RadiusLarge}"
                    Effect="{DynamicResource DialogShadow}" Padding="22,18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Content="{x:Static core:Glyphs.Close}" Command="{Binding CloseAddCommand}" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Show" GroupName="wkind" IsChecked="{Binding AddShows, Mode=OneWay}" Command="{Binding SetAddKindCommand}" CommandParameter="show" Padding="12,0" />
                                <RadioButton Style="{StaticResource Segment}" Content="Movie" GroupName="wkind" IsChecked="{Binding AddMovies, Mode=OneWay}" Command="{Binding SetAddKindCommand}" CommandParameter="movie" Padding="12,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Add to your watch list" Style="{StaticResource Title}" />
                    </DockPanel>
                    <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Text="{Binding AddQuery, UpdateSourceTrigger=PropertyChanged}" b:Ui.Placeholder="Title"
                             b:Ui.EnterCommand="{Binding SearchOnlineCommand}" b:Ui.FocusOnLoad="True" MinHeight="40" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Search" b:Ui.Icon="{x:Static core:Glyphs.Search}" Command="{Binding SearchOnlineCommand}" />
                        <Button DockPanel.Dock="Right" Content="Add by hand" Command="{Binding AddManualCommand}" Margin="0,0,8,0" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Spinner Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Shows: TVmaze · Movies: iTunes" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="{Binding SearchMessage}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,30" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="120">
                            <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WatchSearchResult}">
                                        <Border Padding="6" Margin="0,0,0,4" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="48" Height="70" CornerRadius="3" Background="{DynamicResource SegmentBrush}" ClipToBounds="True" Margin="0,0,12,0">
                                                    <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                                                </Border>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleAccentButton}" Content="Add" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.AddResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{Binding Overview}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
